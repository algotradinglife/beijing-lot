<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beidanlot.autoplan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/huhan/miniforge3/bin/python3</string>
        <string>-m</string>
        <string>auto.autoplan</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/Data Drive/workspace/trading/beijing-lot</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Volumes/Data Drive/workspace/trading/beijing-lot/src</string>
        <key>PATH</key>
        <string>/Users/huhan/miniforge3/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Hourly polling (changed 2026-05-10 from daily 21:00). -->
    <!-- Anti-double-bet enforced inside services.generate_plan, so cron      -->
    <!-- triggers liberally and the planner skips when no new matches qualify -->
    <!-- after deduping placed-but-unsettled prior plans.                    -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Volumes/Data Drive/workspace/trading/beijing-lot/data/logs/autoplan.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Volumes/Data Drive/workspace/trading/beijing-lot/data/logs/autoplan.stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
