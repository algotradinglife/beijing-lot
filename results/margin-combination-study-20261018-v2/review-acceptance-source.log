 stopifnot(nrow(history)==322L,!anyNA(history),!anyDuplicated(history$fixture_id))
 manifest <- jsonlite::fromJSON(sources[['manifest']]) |> as_tibble()
 all_rounds <- list()
 for(i in 4:10) {
