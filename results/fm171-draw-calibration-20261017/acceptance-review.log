ibutions) core_masses <- read_csv (contribution_path, show_col_types= FALSE ) |> filter (core) |> select (fixture_id,outcome,mass) |> pivot_wider ( names_from= outcome, values_from= mass, values_fill= 0 ) |> mutate ( core_blocks_draw= D <= pmin (W,L) + 1e-12 ) knitr :: kable (scores |> filter (primary_estimated,model %in% c ( "FM171" , "GLOBAL_D48" ),draw_group == "DRAW_BIN_TOP2_CATEGORY3" ) |> left_join (core_masses, by= "fixture_id" , relationship= "many-to-one" ) |> group_by (core_blocks_draw,model) |> summarise ( n= n (), hits1= sum (top1), hits2= sum (top2), saved= sum (saved_top2), lost= sum (lost_top2), brier= mean (brier), .groups= "drop" ), digits= 6 ) core_blocks_draw model n hits1 hits2 saved lost brier FALSE FM171 25 8 16 0 0 0.698042 FALSE GLOBAL_D48 25 9 17 9 8 0.684006 TRUE FM171 79 34 59 0 0 0.663876 TRUE GLOBAL_D48 79 34 61 9 7 0.665187 核心主导的79场中，全局校正救回9场、误伤7场，Top2净增2场，但该子组全三类Brier略变差。历史校正能改变核心内质量，数学上不受纯尾压缩的限制；不过选择改善不等于该子组概率更准确。尾部可改变排序的25场则净增1场。两个子组全部展示，不将有利子组当作独立验证。 局限与后续判据 本轮校正针对一条实际北单让球线定义的事件。虽然校正后仍有完整比分网格、可作任意让球的数学投影，但尚未验证其他让球线上的校准；更换目标h后重新拟合会得到另一份条件分布，不能把它当作与h无关的统一战力校准。这是新增研究层的局限，原FM171的lambda/核心仍不使用北单线。若要升级为统一比分校准，需另行检验多个净胜球档的联合一致性，而非逐线反复抬让平。 此数据量只能检验低维收缩，不足以研究联赛×让球×阵容×总进球等细粒度条件发生率。后验收缩强度、分组与48h/72h代理并非已验证的业务参数；所有方案全部报告，没有根据这三期挑最佳升级正式版本。候选分组来自此前已知结果的讨论与形态探索，固定参数并不使其成为独立的事前研究。分布形态分组粗糙、期际状态不同、同期比赛相关、已有多次复盘及历史代理都会限制推广。没有声称显著性或独立置信区间。 如果只在个别期改善，或Top2改善却整体概率评分恶化，不足以形成通用校正。下一阶段需更长的同版、截止绑定预测与真实标签可用性，再用独立未来期验证；不能用更多纯赛果替代缺失的同版预测，也不能把旧版概率直接混作同版校准样本。未生成票单，不评价收益。 复现与验收 精确R/Python/依赖版本和测试环境在runtime.json、test-environment.json；受限环境下Quarto样式缓存显式放在可写的/tmp/fm171-draw-quarto-cache，未改HOME。不在函数或渲染时安装依赖。R4.6.1、项目.venv/bin/python，正常安装的r_lib/beidan；本轮无packages/beidan变更，无须新装包或重跑未受影响的独立Python套件。完整仓库入口同时检查正常安装包及其DLL，无手工dyn.load/load_all。没有CI操作。 TZ = UTC Rscript r/fm171_draw_history_freeze.R ROOT OUTPUT TZ = UTC Rscript r/fm171_draw_history_freeze.R ROOT OUTPUT replay TZ = UTC Rscript r/fm171_draw_history_evaluate.R ROOT OUTPUT TZ = UTC Rscript tests/testthat.R TZ = UTC 