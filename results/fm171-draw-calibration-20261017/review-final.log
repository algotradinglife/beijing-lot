 stopifnot(a$status=="ACCEPTED",a$blocking_findings==0L)
 for(i in seq_len(nrow(a$files)))stopifnot(digest::digest(file=file.path(root,a$files$path[i]),algo="sha256")==a$files$sha256[i])
