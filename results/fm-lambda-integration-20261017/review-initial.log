    35	        testthat::expect_true(e$fit$receipt$admission$maximum_source_time <
    36	          format(e$cutoff$cutoff_utc,"%Y-%m-%dT%H:%M:%S",tz="UTC"))
    37	        testthat::expect_true(all(e$fit$observations$competition_id==e$fit$receipt$fixture$competition_id))
    38	      }
    39	    }
    40	  }
    41	  temp <- tempfile("fm-integrated-evaluation-"); dir.create(temp)
    42	  for(name in c("forecasts.rds","manifest.json","replay.json")) {
    43	    testthat::expect_true(file.copy(file.path(folder,name),file.path(temp,name)))
