    70	      left_join(labels |> select(fixture_id, actual_outcome), by = "fixture_id", relationship = "many-to-one") |>
    71	      group_by(model) |> summarise(n = n(), actual_draws = sum(actual_outcome == "D"),
    72	        mean_draw_probability = mean(probability), actual_draw_rate = mean(actual_outcome == "D"),
    73	        binary_draw_brier = mean((probability - as.double(actual_outcome == "D"))^2), .groups = "drop") |>
    74	      mutate(comparison = comparison, dimension = g$dimension[1], stratum = g$stratum[1], .before = 1)
