    55	    grouping |> mutate(dimension = "event_type", stratum = event_type),
    56	    grouping |> mutate(dimension = "draw_type", stratum = draw_type),
    57	    grouping |> mutate(dimension = "source", stratum = selected_source),
    58	    grouping |> mutate(dimension = "trigger", stratum = as.character(triggered)),
    59	    grouping |> mutate(dimension="changed_native",stratum=as.character(changed_native)),
    60	    grouping |> mutate(dimension="fit_state",stratum=state))
    61	  p <- bind_rows(forecasts |> filter(fixture_id %in% ids),
