    89	      saved_top2=top2 & !old_top2,lost_top2=!top2 & old_top2,
    90	      brier_delta=brier-old_brier,logloss_delta=logloss-old_logloss)
    91	}
    92	changes <- bind_rows(changes)
    93	draw_selection <- scores |> filter(comparison == "near_sale") |>
