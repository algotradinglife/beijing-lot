    12	  testthat::expect_setequal(names(x$entries),names(parent$entries))
    13	  testthat::expect_equal(nrow(x$probabilities),346L*4L*3L)
    14	  testthat::expect_false(anyDuplicated(x$probabilities[c("fixture_id","model","outcome")])>0L)
    15	  for(id in names(x$entries)) {
    16	    e <- x$entries[[id]]
    17	    testthat::expect_identical(e$cutoff,parent$entries[[id]]$cutoff)
    18	    testthat::expect_identical(e$selected_source,parent$entries[[id]]$parent_selection$selected_source)
    19	    testthat::expect_identical(e$changed_native,!is.null(e$fit)&&e$selected_source=="native")
    20	    for(model in c("OPPONENT_NATIVE","SAME_SUPPORT_RAW")) {
    21	      fm <- e$results[[paste0("FM17+",model)]]
    22	      al <- e$results[[paste0("ALPHA+",model)]]
    23	      testthat::expect_equal(sum(fm$grid$probability),1,tolerance=1e-9)
    24	      testthat::expect_equal(sum(al$grid$probability),1,tolerance=1e-9)
