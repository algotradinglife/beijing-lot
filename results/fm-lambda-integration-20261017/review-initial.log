    95	    draw_top1_hits = sum(predicted_outcome == "D" & actual_outcome == "D"),
    96	    missed_draws_top2 = sum(actual_outcome == "D" & !top2), .groups = "drop")
    97	tables <- list(metrics = metrics, scores = scores, draw_calibration = calibration,
    98	  changes = changes, draw_selection = draw_selection,
