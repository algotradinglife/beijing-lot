#' Estimate venue goal means from explicit long and recent distributions
#' @param history Tibble of fixture history with source match identities and scores.
#' @param fixture Named list with fixture/issue/provider and home/away team IDs.
#' @param target_native_ids Character vector of the complete target roster IDs.
#' @param cutoff Shared temporal_learning Cutoff object; required, never inferred.
#' @param source_hashes Named source SHA256 list.
#' @param repository_root Explicit repository root supplying the requested
#'   `.venv/bin/python` interpreter and the source files recorded in the receipt.
#' @param policy List: integer recent_n/minimum_matches, numeric alpha/minimum_ess.
#' @param availability_mode Explicit historical diagnostic or observed prospective admission.
#' @return List with parameter/rate tibbles, empirical components and shared receipts.
#' @details Historical diagnostic only. Empty/malformed/sparse history fails.
#' No fetching, persistence, market fitting or implicit environment selection.
#' The interpreter is selected and verified solely by [python_backend()], which
#' already rejects an initialized or differently sourced backend; the
#' `beidan_backend.recent_venue_goals` module is then imported from the installed
#' package path carried by that handle. `repository_root` is used to request
#' `.venv/bin/python` and to locate the source files hashed into the Python
#' receipt; it is never inserted into `sys.path`.
estimate_recent_venue_goals <- function(history, fixture, target_native_ids,
                                       cutoff, source_hashes, repository_root, policy,
                                       availability_mode = "HISTORICAL_DIAGNOSTIC") {
  if (!tibble::is_tibble(history) || !nrow(history) || !is.list(fixture) ||
      !is.character(target_native_ids) || !is.list(source_hashes) ||
      !is.list(policy) || !inherits(cutoff, "python.builtin.object")) {
    stop("Explicit typed history, fixture, policy and shared cutoff required")
  }
  root <- normalizePath(repository_root, mustWork = TRUE)
  backend <- python_backend(file.path(root, ".venv/bin/python"))
  module <- reticulate::import_from_path("beidan_backend.recent_venue_goals",
                                         path = backend$root, convert = FALSE)
  rows <- jsonlite::fromJSON(jsonlite::toJSON(history, dataframe = "rows",
    auto_unbox = TRUE, na = "null"), simplifyVector = FALSE)
  value <- reticulate::py_to_r(module$estimate_recent_venue_goals(rows, fixture,
    as.list(target_native_ids), cutoff, source_hashes, root, policy, availability_mode))
  value$parameters <- tibble::as_tibble(value$parameters)
  value$rates <- dplyr::bind_rows(value$rates)
  stopifnot(nrow(value$parameters) == 1L, nrow(value$rates) == 2L,
            all(is.finite(unlist(value$parameters))), !anyNA(value$rates))
  return(value)
}
test_that("real eleven-round replay binds original pools, ranks, tickets and budgets", {
  root <- Sys.getenv("BEIDAN_REPOSITORY_ROOT")
  expect_true(nzchar(root))
  out <- file.path(root, "results/mixed-package-replay-20261011/replay")
  checks <- readr::read_csv(file.path(out, "replay-checks.csv"), show_col_types = FALSE)
  expect_true(tibble::is_tibble(checks))
  expect_equal(nrow(checks), 11L)
  expect_false(any(vapply(checks, is.list, logical(1))))
  expect_false(any(vapply(checks, is.matrix, logical(1))))
  expect_true(all(checks$fixture_pool_exact & checks$group_legs_exact &
                    checks$full_ranks_exact & checks$purchased_tickets_exact))
  expect_true(all(checks$groups == 8L & checks$tickets == 1400L & checks$stake_cny == 2800))
  receipt <- jsonlite::fromJSON(file.path(out, "replay-receipt.json"))
  expect_identical(receipt$status, "PASS")
  expect_identical(names(receipt$source_paths), c("upcoming", "upcoming_expected", "original", "past_expected"))
  expect_identical(names(receipt$source_hashes), names(receipt$source_paths))
  expect_length(receipt$source_paths, 4L)
  for (key in names(receipt$source_paths))
    expect_identical(digest::digest(file = file.path(root, receipt$source_paths[[key]]), algo = "sha256"),
                     receipt$source_hashes[[key]])
  for (name in c("upcoming-five.rds", "past-six-150324.rds")) {
    result <- readRDS(file.path(out, name))
    payload <- result; payload$receipt <- NULL
    expect_identical(result$receipt$output_hash, rlang::hash(payload))
    expect_identical(result$receipt$input_hash, rlang::hash(result$inputs))
    expect_identical(result$receipt$policy_hash, rlang::hash(result$policy))
    expect_identical(result$receipt$cutoff_hash, beidan:::.rank_outcome_cutoff_hash(result$cutoff))
    # The immutable replay is evidence for the implementation recorded at
    # freeze time. A changed current implementation must reject its reuse.
    expect_identical(result$receipt$implementation_hash, receipt$implementation)
    current_code <- beidan:::.rank_outcome_code_hash("BuildMixedRoundPlans")
    if (!identical(result$receipt$implementation_hash, current_code)) {
      expect_error(beidan::ValidateMixedRoundPlans(result), "mixed plan replay mismatch")
    } else expect_true(isTRUE(beidan::ValidateMixedRoundPlans(result)))
    expect_equal(sum(result$summary$stake_cny), result$spent_cny)
