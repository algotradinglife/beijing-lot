stopifnot(sum(fixture_coverage$prior_all)==109L,sum(fixture_coverage$qualified_all)==43L)
knitr::kable(fixture_coverage |> summarise(fixtures=n(),prior_all=sum(prior_all),qualified_all=sum(qualified_all),incomplete_prior=sum(!prior_all)),caption='同截止覆盖：原生模型117场，不等同于整期346场')
