                tables={k:{f.name:str(f.type) for f in t.schema} for k,t in tables.items()},
                nullable='Unused market price columns are null; quote keys/clocks/flags not null; missing market newest age null.',historical_admitted=False),paths.schema_path('fm17_replayed_markets_v2',require_exists=False,environ=environ))
            versioning.write_json_atomically(catalog,registry.catalog_path(environ=environ))
        except Exception:
            if published:
