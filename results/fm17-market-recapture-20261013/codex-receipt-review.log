#' Compare sealed source-capture histories without consulting post-cutoff prices.
#' @param earlier,later Explicit envelopes audit (InspectRecapturedMarkets result)
#'   and object_sha256 (SHA256 of that exact R object). Each fixture's embedded
#'   cutoff and shared admission identity must agree; missing binding fails.
#' @return ledger and conflicts tibbles. Conflict means unequal unique price/line
#'   sets at the same prior fixture/market/company/time/field; duplicate occurrence
#'   counts are retained, equal duplicates do not imply a value conflict. Choices
#'   prefer more qualified prior channels/companies, ties keep earlier, conflicts
#'   quarantine later. No fitting/clock inference; chronology comes from existing
#'   shared-admitted prior flags and receipt cutoff. Future prices cannot choose.
#' @keywords internal
.CompareRecapturedMarkets <- function(earlier, later) {
  for(x in list(earlier,later)) {
    if(!is.list(x)||!identical(names(x),c('audit','object_sha256'))||!identical(digest::digest(x$audit,algo='sha256'),x$object_sha256))stop('Exact source object binding required')
  }
  a<-earlier$audit;b<-later$audit
  if(!identical(a$policy,b$policy)||!setequal(names(a$receipts),names(b$receipts))||!length(a$receipts))stop('Matching policy and fixture scope required')
  for(id in names(a$receipts)) {
    for(x in list(a,b)) {
      r<-x$receipts[[id]];ct<-r$cutoff
      if(!is.list(ct)||!identical(names(ct),c('issue_id','cutoff_utc'))||!is.character(ct$issue_id)||length(ct$issue_id)!=1L||!nzchar(ct$issue_id)||!inherits(ct$cutoff_utc,'POSIXct')||length(ct$cutoff_utc)!=1L||is.na(ct$cutoff_utc)||!is.finite(as.numeric(ct$cutoff_utc))||!is.character(r$input_hashes$audit_code)||length(r$input_hashes$audit_code)!=1L)stop('Bound explicit cutoff/code required')
      h<-x$history[x$history$fixture_id==id,]
      if(!is.logical(h$prior)||anyNA(h$prior)||any(h$quote_at[h$prior]>=ct$cutoff_utc))stop('Shared prior rows violate cutoff')
      if(!is.null(r$shared$cutoff_ts)&&r$shared$cutoff_ts!=format(ct$cutoff_utc,'%Y-%m-%dT%H:%M:%S+00:00',tz='UTC')) {
        parsed<-lubridate::ymd_hms(r$shared$cutoff_ts,tz='UTC',quiet=TRUE)
        if(is.na(parsed)||as.numeric(parsed)!=as.numeric(ct$cutoff_utc))stop('Shared cutoff binding differs')
      }
    }
    if(!identical(a$receipts[[id]]$cutoff,b$receipts[[id]]$cutoff)||!identical(a$receipts[[id]]$input_hashes$audit_code,b$receipts[[id]]$input_hashes$audit_code))stop('Source cutoff or code differs')
  }
  prices<-c('odds_home','odds_draw','odds_away','handicap','home_decimal','away_decimal','line','over_decimal','under_decimal')
  keys<-c('fixture_id','market','company_id','quote_at','field')
  views<-list()
  for(k in c('old','new')) {
    x<-if(k=='old')a else b
    views[[k]]<-x$history |> dplyr::filter(prior) |> dplyr::select(dplyr::all_of(c(setdiff(keys,'field'),prices))) |> tidyr::pivot_longer(dplyr::all_of(prices),names_to='field',values_to='value',values_drop_na=TRUE) |> dplyr::group_by(dplyr::across(dplyr::all_of(keys))) |> dplyr::summarise(values=list(sort(unique(value))),occurrences=dplyr::n(),.groups='drop')
    names(views[[k]])[names(views[[k]])=='values']<-paste0(k,'_values')
    names(views[[k]])[names(views[[k]])=='occurrences']<-paste0(k,'_occurrences')
  }
  conflicts<-dplyr::inner_join(views$old,views$new,by=keys,relationship='one-to-one') |> dplyr::filter(purrr::map2_lgl(old_values,new_values,~!identical(.x,.y))) |> dplyr::mutate(old_value=purrr::map_chr(old_values,~paste(format(.x,digits=17,trim=TRUE),collapse='|')),new_value=purrr::map_chr(new_values,~paste(format(.x,digits=17,trim=TRUE),collapse='|'))) |> dplyr::select(-old_values,-new_values)
  old<-a$coverage |> dplyr::group_by(fixture_id) |> dplyr::summarise(old_channels=sum(qualified_companies>0),old_companies=sum(qualified_companies),.groups='drop')
  new<-b$coverage |> dplyr::group_by(fixture_id) |> dplyr::summarise(new_channels=sum(qualified_companies>0),new_companies=sum(qualified_companies),.groups='drop')
  if(!setequal(old$fixture_id,names(a$receipts))||!setequal(new$fixture_id,names(b$receipts)))stop('Coverage receipt scope differs')
  ledger<-dplyr::left_join(old,new,by='fixture_id',relationship='one-to-one') |> dplyr::mutate(conflict=fixture_id %in% conflicts$fixture_id,selected=dplyr::if_else(!conflict&(new_channels>old_channels|(new_channels==old_channels&new_companies>old_companies)),'recaptured','offline'),reason=dplyr::case_when(conflict~'PRICE_CONFLICT_NEW_QUARANTINED',selected=='recaptured'~'MORE_QUALIFIED_PRIOR_CHANNELS_OR_COMPANIES',new_channels<old_channels~'NEW_CAPTURE_LESS_COMPLETE_KEEP_PRIOR',TRUE~'NO_COVERAGE_GAIN_KEEP_PRIOR'))
  list(ledger=ledger,conflicts=conflicts)
}
