+def parse_asian_handicap_history_json(
+    payload: bytes, *, kickoff_hkt: datetime,
+) -> tuple[list[ParsedSnapshot], dict[str, int]]:
+    """Parse Titan ``type=3&oddskind=0`` full-match handicap history.
+
+    Reuse the common Titan row/time/phase parser. Titan PanKou is a home-giving
+    line: positive means home gives goals. The returned line is home-added
+    handicap, so negate PanKou. Home/away quotes remain Hong Kong net odds;
+    callers convert to decimal explicitly. Original line_text and row hashes
+    retain source identity. No cutoff selection, fetching or persistence.
+    Invalid payloads raise ScoreModelHistoryError; incomplete rows retain their
+    diagnostic flags. This endpoint must not be used for oddskind=1 totals.
+    """
+    snapshots, counters = parse_over_under_history_json(payload, kickoff_hkt=kickoff_hkt)
+    converted = []
+    for row in snapshots:
+        line = None if row.line_value is None else -row.line_value
+        valid_quarter = line is not None and math.isfinite(line) and line * 4 == round(line * 4)
+        valid_prices = all(value is not None and math.isfinite(value) and value > 0
+                           for value in row.odds.values())
+        converted.append(replace(
+            row, market_key="asian_handicap", line_value=line,
+            odds={"home": row.odds["over"], "away": row.odds["under"]},
+            complete=row.complete and valid_quarter and valid_prices,
+        ))
+        if row.complete and not (valid_quarter and valid_prices):
+            counters["incomplete_rows"] += 1
+    return converted, counters
