  r$center_mode<-"single";zs<-BuildFmTailJudgement(b,r,"e",cutoff,p);expect_identical(zs$core_margins,-2:2)
  r$center_mode<-"dual";r$centers<-0:1;expect_equal(BuildFmTailJudgement(b,r,"e",cutoff,p)$judgement$bins,z$judgement$bins)
