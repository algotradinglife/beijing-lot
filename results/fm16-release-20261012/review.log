#' Synthetic source-selection fixture exercised by the tests below.
#' @return Explicit fixture, bases, review, cutoff and backend root.
FmSourceTestFixture <- function() {
  root <- Sys.getenv("FM_NATIVE_TEST_ROOT");stopifnot(nzchar(root))
  fixture <- tibble::tibble(fixture_id="00001:4",issue_id="00001",home="H",away="A")
  cutoff <- list(issue_id="00001",cutoff_utc=as.POSIXct("2026-10-03 16:30:00",tz="UTC"))
  grid <- tibble::tibble(home_goals=c(0L,1L,2L),away_goals=0L,probability=c(.5,.3,.2))
  native <- list(grid=grid,cutoff=cutoff,model_id="SYNTHETIC_NATIVE",source_hashes=list(raw="native"),max_source_available_utc=cutoff$cutoff_utc-60,intended_use="HISTORICAL_DIAGNOSTIC")
  market<-native;market$model_id<-"SYNTHETIC_JOINT_MARKET";market$grid$probability<-c(.2,.3,.5);market$source_hashes<-list(raw="market")
  review <- list(confidence="low",market_sufficient=TRUE,market_consistent=TRUE,reason="Evidence quality low",counterevidence="No observed availability",evidence_ids="e1",cutoff_utc="2026-10-03T16:30:00Z",native_hash=beidan:::.score_margin_hash(native),market_hash=beidan:::.score_margin_hash(market),author="ROOT_SYNTHETIC",review_version="FM-1.6.0_TEST")
  return(list(root=root,fixture=fixture,cutoff=cutoff,native=native,market=market,review=review))
}

#' Shared admitted evidence for a synthetic source decision.
#' @param z Explicit fixture returned by FmSourceTestFixture.
#' @param poison Whether to add post-cutoff and exact-target rows.
#' @return Opaque authoritative context; no custom chronology implementation.
FmSourceTestContext <- function(z, poison=FALSE) {
  reticulate::use_python(file.path(z$root,".venv/bin/python"),required=TRUE)
  reticulate::import("sys",convert=FALSE)$path$insert(0L,file.path(z$root,"packages/beidan/inst/python"))
  backend<-reticulate::import("beidan_backend.fundamental_probability",convert=FALSE);shared<-reticulate::import("beidan_backend.temporal_learning",convert=FALSE)
  rows<-list(list(evidence_id="e1",fixture_id=z$fixture$fixture_id,source_hash="saved-evidence",row_key="e1",issue_code="HISTORY",issue_year=2026L,label_available_ts="2026-10-03T16:29:00Z",data_available_ts="2026-10-03T16:29:00Z"))
  if(poison)rows<-c(rows,list(modifyList(rows[[1]],list(evidence_id="future",row_key="future",data_available_ts="2026-10-03T16:30:00Z"))),list(modifyList(rows[[1]],list(evidence_id="target",row_key="target",issue_code="00001"))))
  hashes<-list(fm_source_selection_inputs=beidan:::.score_margin_hash(list(native=z$native,market=z$market,review=z$review,fixture=z$fixture,cutoff=z$cutoff)),fm_source_selection_code=digest::digest(paste(deparse(body(SelectFmProbabilitySource)),collapse="\n"),algo="sha256"),fm_source_selection_dependencies=beidan:::.score_margin_code(z$root))
  return(backend$build_adjustment_evidence_context(rows,as.list(z$fixture),shared$Cutoff$decision_epoch(z$cutoff$issue_id,z$review$cutoff_utc),hashes,shared$AvailabilityPolicy$historical_proxy("SYNTHETIC_FM16_TEST"),"HISTORICAL_DIAGNOSTIC",z$root))
}

test_that("FM16 uses exact market grid only when confidence and both market gates permit", {
  for(conf in c("low","uncertain","adequate")) for(sufficient in c(FALSE,TRUE)) for(consistent in c(FALSE,TRUE)) {
    z<-FmSourceTestFixture();z$review$confidence<-conf;z$review$market_sufficient<-sufficient;z$review$market_consistent<-consistent
    ctx<-FmSourceTestContext(z);x<-SelectFmProbabilitySource(z$native,z$market,z$review,ctx,z$fixture,z$cutoff,z$root)
    expected<-if(conf %in% c("low","uncertain")&&sufficient&&consistent)"market"else"native"
    expect_identical(x$selected_source,expected);expect_identical(x$base$grid,z[[expected]]$grid)
    expect_identical(x,SelectFmProbabilitySource(z$native,z$market,z$review,ctx,z$fixture,z$cutoff,z$root))
    expect_equal(x$receipt$selected_grid_hash,beidan:::.score_margin_hash(z[[expected]]$grid))
  }
  z<-FmSourceTestFixture();ctx<-FmSourceTestContext(z);a<-SelectFmProbabilitySource(z$native,z$market,z$review,ctx,z$fixture,z$cutoff,z$root)
  b<-SelectFmProbabilitySource(z$native,z$market,z$review,FmSourceTestContext(z,TRUE),z$fixture,z$cutoff,z$root)
  expect_identical(a$base$grid,b$base$grid);expect_identical(a$selected_source,b$selected_source)
  expect_identical(a$receipt$input_hashes,b$receipt$input_hashes)
})

test_that("FM16 absent market preserves native only when market gate is false", {
  z<-FmSourceTestFixture();z$market<-NULL;z$review$market_hash<-"ABSENT";z$review$market_sufficient<-FALSE
  x<-SelectFmProbabilitySource(z$native,z$market,z$review,FmSourceTestContext(z),z$fixture,z$cutoff,z$root)
  expect_identical(x$selected_source,"native");expect_identical(x$base$grid,z$native$grid)
  z$review$market_sufficient<-TRUE
  expect_error(SelectFmProbabilitySource(z$native,z$market,z$review,FmSourceTestContext(z),z$fixture,z$cutoff,z$root),"requires joint")
})

test_that("FM16 rejects stale, changed or unbound source decisions", {
  z<-FmSourceTestFixture();ctx<-FmSourceTestContext(z)
  zz<-z;zz$review$confidence<-"adequate";expect_error(SelectFmProbabilitySource(zz$native,zz$market,zz$review,ctx,zz$fixture,zz$cutoff,zz$root),"binding")
  zz<-z;zz$market$grid$probability<-c(.1,.3,.6);expect_error(SelectFmProbabilitySource(zz$native,zz$market,zz$review,ctx,zz$fixture,zz$cutoff,zz$root),"binding")
  zz<-z;zz$cutoff$cutoff_utc<-zz$cutoff$cutoff_utc+1;expect_error(SelectFmProbabilitySource(zz$native,zz$market,zz$review,ctx,zz$fixture,zz$cutoff,zz$root),"cutoff")
  zz<-z;zz$review$evidence_ids<-"missing";expect_error(SelectFmProbabilitySource(zz$native,zz$market,zz$review,FmSourceTestContext(zz),zz$fixture,zz$cutoff,zz$root),"unavailable")
  for(kind in c("empty","na","duplicate","future","handicap","fractional","use")) {
    zz<-z
    if(kind=="empty")zz$native$grid<-zz$native$grid[0,]
    if(kind=="na")zz$native$grid$probability[1]<-NA_real_
    if(kind=="duplicate")zz$native$grid<-dplyr::bind_rows(zz$native$grid,zz$native$grid[1,])
    if(kind=="future")zz$native$max_source_available_utc<-zz$cutoff$cutoff_utc
    if(kind=="handicap")zz$native$handicap<- -1
    if(kind=="fractional")zz$native$grid$home_goals[1]<-.5
    if(kind=="use")zz$market$intended_use<-"PROSPECTIVE_DECISION"
    expect_error(SelectFmProbabilitySource(zz$native,zz$market,zz$review,ctx,zz$fixture,zz$cutoff,zz$root))
  }
  expect_error(SelectFmProbabilitySource(z$native,z$market,z$review,list(),z$fixture,z$cutoff,z$root),"Opaque")
  expect_error(SelectFmProbabilitySource(z$native,z$market,z$review,ctx,z$fixture,NULL,z$root))
  zz<-z;zz$review$market_consistent<-NA;expect_error(SelectFmProbabilitySource(zz$native,zz$market,zz$review,ctx,zz$fixture,zz$cutoff,zz$root))
  zz<-z;zz$fixture$handicap<-1;expect_error(SelectFmProbabilitySource(zz$native,zz$market,zz$review,ctx,zz$fixture,zz$cutoff,zz$root))
})
test_that("FM16 extends equal-distance shells by either-side threshold", {
  cutoff <- list(issue_id="26101",cutoff_utc=as.POSIXct("2026-10-03 16:30:00",tz="UTC"))
  g <- tibble::tibble(home_goals=pmax(-3:3,0L),away_goals=pmax(3:-3,0L),probability=c(.02,.06,.12,.3,.25,.15,.1))
  base <- list(grid=g,cutoff=cutoff)
  review <- list(decision="apply",center_mode="single",base_hash=beidan:::.score_margin_hash(g),cutoff_utc="2026-10-03T16:30:00Z",reason="Independent distribution",counterevidence="Uncertain lineups")
  policy <- list(max_radius=2L,threshold=.1,coefficient=.3,tie_tolerance=1e-12,dual_gap=.01)
  z <- BuildFmTailJudgement(base,review,"quote-8",cutoff,policy)
  expect_identical(z$center,0L);expect_identical(z$radius,2L)
  expect_identical(z$core_margins,-2:2);expect_true(all(z$shells$accepted))
  expect_equal(z$shells$left_probability,c(.12,.06));expect_equal(z$shells$right_probability,c(.25,.15))
  expect_equal(z$normalizer,.916);expect_equal(z$core_mass,.88)
  expect_equal(sum(z$judgement$bins$target_mass),1)
  expect_equal(z$judgement$bins$target_mass[z$judgement$bins$min_margin==-2],.06/.916)
  expect_identical(z,BuildFmTailJudgement(base,review,"quote-8",cutoff,policy))
  expect_equal(z$judgement$bins$min_margin[-1],head(z$judgement$bins$max_margin,-1)+1)
  gg<-g;gg$home_goals<-g$away_goals;gg$away_goals<-g$home_goals
  rr<-review;rr$base_hash<-beidan:::.score_margin_hash(gg)
  reflected<-BuildFmTailJudgement(list(grid=gg,cutoff=cutoff),rr,"quote-8",cutoff,policy)
  expect_equal(reflected$judgement$bins$target_mass,rev(z$judgement$bins$target_mass))
  shifted<-g;shifted$home_goals<-g$home_goals+2L
  rr$base_hash<-beidan:::.score_margin_hash(shifted)
  zz<-BuildFmTailJudgement(list(grid=shifted,cutoff=cutoff),rr,"quote-8",cutoff,policy)
  expect_identical(zz$center,2L);expect_identical(zz$core_margins,0:4)
  expect_equal(zz$judgement$bins$target_mass,z$judgement$bins$target_mass)
})

test_that("FM16 stops inner failed shells, respects cap and treats exact ten percent as core", {
  c<-list(issue_id="26101",cutoff_utc=as.POSIXct("2026-10-03 16:30:00",tz="UTC"))
  p<-list(max_radius=2L,threshold=.1,coefficient=.3,tie_tolerance=1e-12,dual_gap=.01)
  g<-tibble::tibble(home_goals=pmax(-3:3,0L),away_goals=pmax(3:-3,0L),probability=c(.1,.11,.09,.4,.09,.11,.1))
  r<-list(decision="apply",center_mode="single",base_hash=beidan:::.score_margin_hash(g),cutoff_utc="2026-10-03T16:30:00Z",reason="Core",counterevidence="Missing")
  z<-BuildFmTailJudgement(list(grid=g,cutoff=c),r,"e",c,p)
  expect_identical(z$radius,0L);expect_equal(nrow(z$shells),1);expect_false(z$shells$accepted)
  g$probability<-c(.05,.1,.2,.35,.2,.05,.05);r$base_hash<-beidan:::.score_margin_hash(g)
  z<-BuildFmTailJudgement(list(grid=g,cutoff=c),r,"e",c,p)
  expect_identical(z$radius,2L)
  z0<-BuildFmTailJudgement(list(grid=g,cutoff=c),r,"e",c,modifyList(p,list(max_radius=0L)))
  expect_identical(z0$radius,0L);expect_equal(nrow(z0$shells),0)
  sparse<-g[c(1,3,4,5,7),];sparse$probability<-c(.1,.2,.4,.2,.1);r$base_hash<-beidan:::.score_margin_hash(sparse)
  zs<-BuildFmTailJudgement(list(grid=sparse,cutoff=c),r,"e",c,p)
  expect_identical(zs$radius,1L)
  expect_equal(zs$judgement$bins$target_mass[zs$judgement$bins$min_margin %in% c(-2,2)],c(0,0))
  single<-tibble::tibble(home_goals=0L,away_goals=0L,probability=1);r$base_hash<-beidan:::.score_margin_hash(single)
  expect_equal(BuildFmTailJudgement(list(grid=single,cutoff=c),r,"e",c,p)$core_mass,1)
})

test_that("FM16 rejects broken bindings and preserves unresolved or tied grids", {
  c<-list(issue_id="26101",cutoff_utc=as.POSIXct("2026-10-03 16:30:00",tz="UTC"))
  p<-list(max_radius=2L,threshold=.1,coefficient=.3,tie_tolerance=1e-12,dual_gap=.01)
  g<-tibble::tibble(home_goals=0:2,away_goals=0L,probability=c(.3,.4,.3));b<-list(grid=g,cutoff=c)
  r<-list(decision="apply",center_mode="single",base_hash=beidan:::.score_margin_hash(g),cutoff_utc="2026-10-03T16:30:00Z",reason="Core",counterevidence="Missing")
  rr<-r;rr$decision<-"retain"
  expect_identical(BuildFmTailJudgement(b,rr,"e",c,p)$branch,"retained_review")
  gt<-g;gt$probability<-c(.4,.4,.2);rr<-r;rr$base_hash<-beidan:::.score_margin_hash(gt)
  expect_identical(BuildFmTailJudgement(list(grid=gt,cutoff=c),rr,"e",c,p)$branch,"retained_mode_tie")
  expect_error(BuildFmTailJudgement(b,r,"e",NULL,p))
  expect_error(BuildFmTailJudgement(modifyList(b,list(cutoff=list(issue_id="26101",cutoff_utc=c$cutoff_utc+1))),r,"e",c,p),"cutoff")
  rr<-r;rr$base_hash<-"wrong";expect_error(BuildFmTailJudgement(b,rr,"e",c,p),"binding")
  rr<-r;rr$cutoff_utc<-"2026-10-04T16:30:00Z";expect_error(BuildFmTailJudgement(b,rr,"e",c,p),"cutoff")
  rr$cutoff_utc<-"bad";expect_error(BuildFmTailJudgement(b,rr,"e",c,p),"UTC")
  expect_error(BuildFmTailJudgement(b,r,"",c,p))
  expect_error(BuildFmTailJudgement(b,r,"e",c,modifyList(p,list(max_radius=3L))))
  expect_error(BuildFmTailJudgement(b,r,"e",c,modifyList(p,list(coefficient=0))))
  expect_error(BuildFmTailJudgement(modifyList(b,list(handicap=-2)),r,"e",c,p),"Ticket")
  gg<-g;gg$probability[1]<-NA_real_;expect_error(BuildFmTailJudgement(list(grid=gg,cutoff=c),r,"e",c,p))
  gg<-g;gg$home_goals[1]<-.5;expect_error(BuildFmTailJudgement(list(grid=gg,cutoff=c),r,"e",c,p))
  gg<-g;gg$probability[1]<-.2;expect_error(BuildFmTailJudgement(list(grid=gg,cutoff=c),r,"e",c,p),"normalized")
  gg<-dplyr::bind_rows(g,g[1,]);expect_error(BuildFmTailJudgement(list(grid=gg,cutoff=c),r,"e",c,p),"Unique")
  expect_error(BuildFmTailJudgement(list(grid=g[0,],cutoff=c),r,"e",c,p))
})

test_that("FM16 targets integrate with shared evidence and authoritative score projection", {
  root<-Sys.getenv("FM_NATIVE_TEST_ROOT");stopifnot(nzchar(root))
  cutoff<-list(issue_id="26101",cutoff_utc=as.POSIXct("2026-10-03 16:30:00",tz="UTC"))
  g<-tibble::tibble(home_goals=pmax(-3:3,0L),away_goals=pmax(3:-3,0L),probability=c(.02,.06,.12,.3,.25,.15,.1))
  base<-list(grid=g,cutoff=cutoff,model_id="SYNTHETIC_NATIVE",source_hashes=list(raw="synthetic",fm16_policy=digest::digest(file=file.path(root,"packages/beidan/R/fm_tail_judgement.R"),algo="sha256")),max_source_available_utc=cutoff$cutoff_utc-60,intended_use="HISTORICAL_DIAGNOSTIC")
  review<-list(decision="apply",center_mode="single",base_hash=beidan:::.score_margin_hash(g),cutoff_utc="2026-10-03T16:30:00Z",reason="Synthetic contract",counterevidence="Not real evidence")
  policy<-list(max_radius=2L,threshold=.1,coefficient=.3,tie_tolerance=1e-12,dual_gap=.01)
  z<-BuildFmTailJudgement(base,review,"e1",cutoff,policy)
  reticulate::use_python(file.path(root,".venv/bin/python"),required=TRUE)
  reticulate::import("sys",convert=FALSE)$path$insert(0L,file.path(root,"packages/beidan/inst/python"))
  backend<-reticulate::import("beidan_backend.fundamental_probability",convert=FALSE)
  shared<-reticulate::import("beidan_backend.temporal_learning",convert=FALSE)
  fixture<-tibble::tibble(fixture_id="26101:107",issue_id="26101",home="H",away="A")
  rows<-list(list(evidence_id="e1",fixture_id=fixture$fixture_id,source_hash="synthetic",row_key="e1",issue_code="HISTORY",issue_year=2026L,label_available_ts="2026-10-03T16:29:00Z",data_available_ts="2026-10-03T16:29:00Z"))
  hashes<-list(base_artifact=beidan:::.score_margin_hash(base),margin_judgement=beidan:::.score_margin_hash(z$judgement),direction_implementation=beidan:::.score_margin_code(root),fm16_binding=z$binding_hash)
  outputs<-list()
  for(poison in c(FALSE,TRUE)) {
    rr<-rows
    if(poison) rr<-c(rr,list(modifyList(rows[[1]],list(evidence_id="future",row_key="future",data_available_ts="2026-10-04T00:00:00Z"))),list(modifyList(rows[[1]],list(evidence_id="target",row_key="target",issue_code="26101"))))
    ctx<-backend$build_adjustment_evidence_context(rr,as.list(fixture),shared$Cutoff$decision_epoch("26101",review$cutoff_utc),hashes,shared$AvailabilityPolicy$historical_proxy("SYNTHETIC_TEST_ONLY"),"HISTORICAL_DIAGNOSTIC",root)
    final<-adjust_score_margin_distribution(base,z$judgement,ctx,fixture,cutoff,root)
    expect_equal(sum(final$grid$probability),1)
    expect_identical(final,adjust_score_margin_distribution(base,z$judgement,ctx,fixture,cutoff,root))
    expect_equal(final$grid$probability,g$probability*ifelse(abs(g$home_goals-g$away_goals)<=2,1,.3)/.916)
    outputs[[length(outputs)+1L]]<-project_score_outcomes(final,-2,root)
    expect_error(adjust_score_margin_distribution(base,z$judgement,ctx,fixture,modifyList(cutoff,list(cutoff_utc=cutoff$cutoff_utc+1)),root),"cutoff")
  }
  expect_equal(outputs[[1]],outputs[[2]])
})

test_that("FM16 adjacent dual centers expand the interval symmetrically", {
  cutoff <- list(issue_id="26101",cutoff_utc=as.POSIXct("2026-10-03 16:30:00",tz="UTC"))
  g <- tibble::tibble(home_goals=pmax(-3:4,0L),away_goals=pmax(3:-4,0L),probability=c(.02,.06,.12,.23,.225,.15,.12,.075))
  b <- list(grid=g,cutoff=cutoff)
  r <- list(decision="apply",center_mode="auto",base_hash=beidan:::.score_margin_hash(g),cutoff_utc="2026-10-03T16:30:00Z",reason="Adjacent uncertainty",counterevidence="Hypothesis only")
  p <- list(max_radius=2L,threshold=.1,coefficient=.3,tie_tolerance=1e-12,dual_gap=.01)
  z <- BuildFmTailJudgement(b,r,"e",cutoff,p)
  expect_identical(z$centers,0:1);expect_identical(z$branch,"dual_center_tail")
  expect_identical(z$core_margins,-2:3);expect_identical(z$radius,2L)
  expect_equal(z$core_mass,.905);expect_equal(z$normalizer,.9335)
  expect_equal(sum(z$judgement$bins$target_mass),1)
  gg<-g;gg$home_goals<-g$away_goals;gg$away_goals<-g$home_goals;rr<-r;rr$base_hash<-beidan:::.score_margin_hash(gg)
  zz<-BuildFmTailJudgement(list(grid=gg,cutoff=cutoff),rr,"e",cutoff,p)
  expect_identical(zz$centers,-1:0);expect_identical(zz$core_margins,-3:2)
