#' Select the FM-1.6.0 native or joint-market score distribution
#' @param native Native base list: normalized grid tibble (home_goals,
#'   away_goals, probability), explicit cutoff, model_id, source_hashes,
#'   max_source_available_utc (POSIXct), intended_use. No ticket line or labels.
#' @param market Same base contract for joint euro/Asian/total projection,
#'   or NULL when unavailable. Ineligible market never supplies a fallback.
#' @param review List confidence (low/uncertain/adequate), market_sufficient,
#'   market_consistent (logical), reason, counterevidence, evidence_ids,
#'   cutoff_utc (ISO UTC Z), native_hash, market_hash (ABSENT if NULL),
#'   author and review_version (nonempty attribution).
#'   Confidence concerns evidence quality, not disagreement or win probability.
#' @param context Opaque shared temporal_learning adjustment evidence context.
#'   Bind fm_source_selection_inputs to hash(list(native,market,review,fixture,
#'   cutoff)), and fm_source_selection_code to this function's body hash.
#' @param fixture One-row tibble fixture_id, issue_id, home, away; no handicap.
#' @param cutoff Explicit issue_id/cutoff_utc object matching both inputs.
#' @param repository_root Explicit backend root with project .venv and source.
#' @export
#' @return List base (selected score-grid base, no lambda blending),
#'   selected_source and cutoff/input/code/evidence-bound receipt. output_hash
#'   identifies the finalized returned base excluding only its self-reference
#'   source_hashes$selection_receipt; that field hashes the complete receipt.
#' @details No fitting, scraping, writes or default chronology. Low/uncertain
#'   native confidence plus sufficient consistent market selects market exactly;
#'   otherwise retain native. Eligible but missing market fails closed. Shared
#'   evidence validation/admission/replay is authoritative; no chronology proxy
#'   grants prospective eligibility. Empty/malformed/changed inputs are errors.
SelectFmProbabilitySource <- function(native, market, review, context, fixture, cutoff, repository_root) {
  match_require_cutoff(cutoff)
  checkmate::assert_tibble(fixture, nrows = 1L)
  checkmate::assert_names(names(fixture), identical.to = c("fixture_id", "issue_id", "home", "away"))
  for (k in names(fixture)) checkmate::assert_character(fixture[[k]], len = 1L, min.chars = 1L, any.missing = FALSE)
  if (fixture$issue_id != cutoff$issue_id || !startsWith(fixture$fixture_id, paste0(fixture$issue_id, ":")) || fixture$home == fixture$away) stop("Fixture/cutoff differs")
  checkmate::assert_list(review)
  checkmate::assert_names(names(review), identical.to = c("confidence", "market_sufficient", "market_consistent", "reason", "counterevidence", "evidence_ids", "cutoff_utc", "native_hash", "market_hash", "author", "review_version"))
  checkmate::assert_choice(review$confidence, c("low", "uncertain", "adequate"))
  for (k in c("market_sufficient", "market_consistent")) checkmate::assert_flag(review[[k]])
  for (k in c("reason", "counterevidence", "cutoff_utc", "native_hash", "market_hash", "author", "review_version")) checkmate::assert_character(review[[k]], len = 1L, min.chars = 1L, any.missing = FALSE)
  checkmate::assert_character(review$evidence_ids, min.len = 1L, any.missing = FALSE, min.chars = 1L, unique = TRUE)
  if (!grepl("Z$", review$cutoff_utc)) stop("Review UTC cutoff required")
  rt <- suppressWarnings(lubridate::ymd_hms(review$cutoff_utc, tz = "UTC", quiet = TRUE))
  if (is.na(rt) || as.numeric(rt) != as.numeric(cutoff$cutoff_utc)) stop("Review cutoff differs")
  bases <- list(native = native)
  if (!is.null(market)) bases$market <- market
  for (b in bases) {
    checkmate::assert_list(b)
    checkmate::assert_names(names(b), identical.to = c("grid", "cutoff", "model_id", "source_hashes", "max_source_available_utc", "intended_use"))
    match_require_cutoff(b$cutoff)
    if (!identical(b$cutoff, cutoff)) stop("Base cutoff differs")
    checkmate::assert_character(b$model_id, len = 1L, min.chars = 1L, any.missing = FALSE)
    checkmate::assert_list(b$source_hashes, min.len = 1L, names = "unique")
    checkmate::assert_character(unlist(b$source_hashes, use.names = FALSE), any.missing = FALSE, min.chars = 1L)
    checkmate::assert_choice(b$intended_use, c("HISTORICAL_DIAGNOSTIC", "PROSPECTIVE_DECISION"))
    if (!inherits(b$max_source_available_utc, "POSIXct") || length(b$max_source_available_utc) != 1L || anyNA(b$max_source_available_utc) || !is.finite(as.numeric(b$max_source_available_utc)) || b$max_source_available_utc >= cutoff$cutoff_utc) stop("Prior base chronology required")
    g <- b$grid
    checkmate::assert_tibble(g, min.rows = 1L)
    checkmate::assert_names(names(g), identical.to = c("home_goals", "away_goals", "probability"))
    for (k in c("home_goals", "away_goals")) checkmate::assert_integerish(g[[k]], lower = 0L, any.missing = FALSE)
    checkmate::assert_numeric(g$probability, lower = 0, upper = 1, finite = TRUE, any.missing = FALSE)
    if (anyDuplicated(g[c("home_goals", "away_goals")]) || abs(sum(g$probability) - 1) > 1e-12) stop("Unique normalized grid required")
  }
  if (!is.null(market) && market$intended_use != native$intended_use) stop("Availability use differs")
  if (!identical(review$native_hash, .score_margin_hash(native)) || !identical(review$market_hash, if (is.null(market)) "ABSENT" else .score_margin_hash(market))) stop("Review input binding differs")
  use_market <- review$confidence %in% c("low", "uncertain") && review$market_sufficient && review$market_consistent
  if (review$market_sufficient && is.null(market)) stop("Sufficient market requires joint projection")
  reticulate::use_python(file.path(repository_root, ".venv/bin/python"), required = TRUE)
  sys <- reticulate::import("sys", convert = FALSE)
  if (!identical(normalizePath(reticulate::py_to_r(sys$prefix)), normalizePath(file.path(repository_root, ".venv")))) stop("Project Python required")
  sys$path$insert(0L, file.path(repository_root, "packages/beidan/inst/python"))
  backend <- reticulate::import("beidan_backend.fundamental_probability", convert = FALSE)
  if (!inherits(context, "python.builtin.object")) stop("Opaque shared evidence context required")
  admitted <- reticulate::py_to_r(backend$export_adjustment_evidence_context(context, as.list(fixture), as.numeric(cutoff$cutoff_utc), native$intended_use, repository_root))
  hashes <- list(fm_source_selection_inputs = .score_margin_hash(list(native = native, market = market, review = review, fixture = fixture, cutoff = cutoff)), fm_source_selection_code = digest::digest(paste(deparse(body(SelectFmProbabilitySource)), collapse = "\n"), algo = "sha256"), fm_source_selection_dependencies = .score_margin_code(repository_root))
  if (!identical(admitted$receipt$source_hashes[names(hashes)], hashes)) stop("Source selection input/code binding differs; rebuild context")
  evidence <- dplyr::bind_rows(admitted$evidence)
  if (!all(review$evidence_ids %in% evidence$evidence_id)) stop("Review evidence unavailable before cutoff")
  selected_source <- if (use_market) "market" else "native"
  selected <- bases[[selected_source]]
  selected$model_id <- paste0("FM-1.6.0_SOURCE_", toupper(selected_source))
  selected$source_hashes$selection_receipt <- NULL
  receipt <- list(model_id = "FM-1.6.0", cutoff = cutoff, fixture = as.list(fixture), selected_source = selected_source,
    rule = "LOW_OR_UNCERTAIN_AND_SUFFICIENT_AND_CONSISTENT_MARKET", review = review,
    input_hashes = hashes, source_context = admitted$receipt, selected_grid_hash = .score_margin_hash(selected$grid),
    output_hash = .score_margin_hash(selected), output_hash_scope = "BASE_EXCLUDING_SOURCE_HASHES_SELECTION_RECEIPT", cache_reuse = "NONE")
  selected$source_hashes$selection_receipt <- .score_margin_hash(receipt)
  return(list(base = selected, selected_source = selected_source, receipt = receipt))
}
#' Build FM-1.6.0 symmetric margin-core targets
#' @param base List with normalized score-grid tibble and explicit cutoff.
#' @param review List decision (apply/retain), grid base_hash, ISO UTC cutoff_utc,
#'   nonempty reason and counterevidence; independent evidence, not ticket roles.
#' @param evidence_id Nonempty admitted evidence ID for all bins.
#' @param cutoff Explicit issue/time object identical to base and review.
#' @param policy List max_radius (integer 0..2), threshold (0..1), coefficient
#'   (positive <=1), tie_tolerance (nonnegative), dual_gap (NULL or 0..1).
#'   FM16 retains 2/.1/.3/1e-12; dual_gap is an explicit expert policy.
#' @export
#' @return List judgement for adjust_score_margin_distribution(), branch,
#'   center, radius, core_margins, shell tibble, masses and identity binding.
#' @details Pure targets only: no fitting, fetching, writes or ticket handicap.
#' Review center_mode is single/dual/auto; dual uses adjacent top-two margins.
#' Explicit dual centers must be the unambiguous adjacent top pair. Auto requires
#' an explicit dual_gap (absolute probability difference); no default is learned.
#' Centers are frozen before weighting. Extend interval shells while
#' either side meets threshold; stop at first failed shell. Unresolved ties or explicit
#' retain decision preserve the original distribution. Missing support is zero.
#' Shared evidence admission and actual score reweighting use existing APIs.
BuildFmTailJudgement <- function(base, review, evidence_id, cutoff, policy) {
  match_require_cutoff(cutoff)
  match_require_cutoff(base$cutoff)
  if (!identical(base$cutoff, cutoff)) stop("Base cutoff differs")
  if (any(c("handicap", "beidan_handicap", "roles") %in% names(base)) ||
      any(c("handicap", "beidan_handicap", "roles") %in% names(review))) {
    stop("Ticket roles or line cannot govern core selection")
  }
  g <- base$grid
  checkmate::assert_tibble(g, min.rows = 1L)
  checkmate::assert_names(names(g), identical.to = c("home_goals", "away_goals", "probability"))
  for (k in c("home_goals", "away_goals")) checkmate::assert_integerish(g[[k]], lower = 0, any.missing = FALSE)
  checkmate::assert_numeric(g$probability, lower = 0, upper = 1, finite = TRUE, any.missing = FALSE)
  if (anyDuplicated(g[c("home_goals", "away_goals")]) || abs(sum(g$probability) - 1) > 1e-12) stop("Unique normalized score grid required")
  checkmate::assert_list(review)
  checkmate::assert_choice(review$decision, c("apply", "retain"))
  for (k in c("base_hash", "cutoff_utc", "reason", "counterevidence")) checkmate::assert_character(review[[k]], len = 1L, min.chars = 1L, any.missing = FALSE)
  if (!identical(review$base_hash, .score_margin_hash(g))) stop("Review grid binding differs")
  if (!grepl("Z$", review$cutoff_utc)) stop("Review UTC cutoff required")
  rt <- suppressWarnings(lubridate::ymd_hms(review$cutoff_utc, tz = "UTC", quiet = TRUE))
  if (is.na(rt) || as.numeric(rt) != as.numeric(cutoff$cutoff_utc)) stop("Review cutoff differs")
  checkmate::assert_character(evidence_id, len = 1L, min.chars = 1L, any.missing = FALSE)
  checkmate::assert_list(policy)
  checkmate::assert_names(names(policy), identical.to = c("max_radius", "threshold", "coefficient", "tie_tolerance", "dual_gap"))
  checkmate::assert_int(policy$max_radius, lower = 0L, upper = 2L)
  checkmate::assert_number(policy$threshold, lower = 0, upper = 1, finite = TRUE)
  checkmate::assert_number(policy$coefficient, lower = .Machine$double.eps, upper = 1, finite = TRUE)
  checkmate::assert_number(policy$tie_tolerance, lower = 0, upper = 1e-6, finite = TRUE)
  checkmate::assert_choice(review$center_mode, c("single", "dual", "auto"))
  if (!is.null(policy$dual_gap)) checkmate::assert_number(policy$dual_gap, lower = 0, upper = 1, finite = TRUE)
  if (review$center_mode == "auto" && is.null(policy$dual_gap)) stop("Auto center requires explicit dual_gap")
  m <- g |> dplyr::mutate(margin = home_goals - away_goals) |>
    dplyr::group_by(margin) |> dplyr::summarise(probability = sum(probability), .groups = "drop") |>
    dplyr::arrange(dplyr::desc(probability), margin)
  modes <- m$margin[max(m$probability) - m$probability <= policy$tie_tolerance]
  centers <- if (length(modes) == 1L) as.integer(modes) else integer()
  pair <- integer(); gap <- NA_real_
  if (nrow(m) >= 2L) {
    top_pair <- m$margin[m$probability >= m$probability[2L] - policy$tie_tolerance]
    if (length(top_pair) == 2L && abs(diff(top_pair)) == 1L) {
      pair <- sort(as.integer(top_pair)); gap <- m$probability[1L] - m$probability[2L]
    }
  }
  if (review$center_mode == "dual") {
    checkmate::assert_integerish(review$centers, len = 2L, any.missing = FALSE)
    if (!length(pair) || !identical(sort(as.integer(review$centers)), pair)) stop("Dual centers require unambiguous adjacent top-two margins")
    centers <- pair
  } else if (review$center_mode == "auto" && length(pair) && gap <= policy$dual_gap + policy$tie_tolerance) {
    centers <- pair
  }
  center <- if (length(centers) == 1L) centers else NA_integer_
  radius <- NA_integer_; core <- integer()
  shells <- tibble::tibble(distance = integer(), left_probability = double(), right_probability = double(), accepted = logical())
  branch <- if (review$decision == "retain") "retained_review" else if (!length(centers)) "retained_mode_tie" else if (length(centers) == 2L) "dual_center_tail" else "single_center_tail"
  reason <- paste(review$reason, "Counterevidence:", review$counterevidence)
  bins <- tibble::tibble(bin_id = "retained", min_margin = -Inf, max_margin = Inf, target_mass = 1, evidence_id = evidence_id, reason = reason)
  normalizer <- 1; core_mass <- NA_real_; final_core_mass <- NA_real_
  if (branch %in% c("single_center_tail", "dual_center_tail")) {
    radius <- 0L
    for (distance in seq_len(policy$max_radius)) {
      left <- sum(m$probability[m$margin == min(centers) - distance])
      right <- sum(m$probability[m$margin == max(centers) + distance])
      accepted <- max(left, right) >= policy$threshold
      shells <- dplyr::bind_rows(shells, tibble::tibble(distance = distance, left_probability = left, right_probability = right, accepted = accepted))
      if (!accepted) break
      radius <- distance
    }
    core <- seq.int(min(centers) - radius, max(centers) + radius)
    core_mass <- sum(m$probability[m$margin %in% core])
    weighted <- m$probability * ifelse(m$margin %in% core, 1, policy$coefficient)
    normalizer <- sum(weighted)
    final_core_mass <- core_mass / normalizer
    full <- tibble::tibble(margin = seq.int(min(m$margin), max(m$margin))) |>
      dplyr::left_join(m, by = "margin", relationship = "one-to-one") |>
      dplyr::mutate(probability = dplyr::coalesce(probability, 0))
    bins <- full |> dplyr::transmute(bin_id = paste0("margin_", margin),
      min_margin = as.numeric(margin), max_margin = as.numeric(margin),
      target_mass = probability * ifelse(margin %in% core, 1, policy$coefficient) / normalizer,
      evidence_id = .env$evidence_id, reason = .env$reason)
    bins <- dplyr::bind_rows(bins, tibble::tibble(bin_id = c("lower_outer", "upper_outer"),
      min_margin = c(-Inf, max(full$margin) + 1), max_margin = c(min(full$margin) - 1, Inf),
      target_mass = 0, evidence_id = evidence_id, reason = reason)) |> dplyr::arrange(min_margin)
  }
  judgement <- list(model_id = "FM-1.6.0", rationale = paste(branch, reason), bins = bins)
  return(list(judgement = judgement, branch = branch, center = center, centers = centers, radius = radius,
    core_margins = core, shells = shells, core_mass = core_mass,
    final_core_mass = final_core_mass, normalizer = normalizer, policy = policy,
    binding_hash = .score_margin_hash(list(base_identity = .score_margin_hash(base),
      review = review, evidence_id = evidence_id, cutoff = cutoff, policy = policy,
      judgement = judgement, implementation = paste(deparse(body(BuildFmTailJudgement)), collapse = "\n")))))
}
---
title: "FM-1.6.0：可靠性来源切换与单／双中心扩展"
format: html
execute:
  cache: false
  freeze: false
  error: false
---

本版将讨论形成的两条规则实现到R package并更新beidan-strategy。基本面low/uncertain、市场充分且一致时直接选市场网格，不固定混合原生；单／双中心自动阈值为相邻最高两档差≤0.01（1个百分点，包含等号），专家起始值，非标定结果。扩展最多2层、任侧≥0.10整对保留、外围0.3。#4/#11/#59/#23/#24已知赛果，只作端到端规则验收，不是独立回测。正式FM15冻结输出不改写，尚无FM16整期效果或前瞻准入证据。

```{r}
suppressPackageStartupMessages(library(tidyverse));root<-normalizePath('..');out<-file.path(root,'results/fm15-26102-20261012');dest<-file.path(root,'results/fm16-release-20261012');impl<-file.path(out,'implementation')
library(beidan,lib.loc=file.path(dest,'library'))
reticulate::use_python(file.path(root,'.venv/bin/python'),required=TRUE)
reticulate::import('sys',convert=FALSE)$path$insert(0L,file.path(impl,'packages/beidan/inst/python'))
shared<-reticulate::import('beidan_backend.temporal_learning',convert=FALSE);backend<-reticulate::import('beidan_backend.fundamental_probability',convert=FALSE)
m<-jsonlite::fromJSON(file.path(out,'manifest.json'));dm<-jsonlite::fromJSON(file.path(out,'market-diagnostic-manifest.json'));nm<-jsonlite::fromJSON(file.path(out,'native-manifest.json'))
stopifnot(digest::digest(file=file.path(out,m$batch_file),algo='sha256')==m$sha256,digest::digest(file=file.path(out,dm$diagnostic_file),algo='sha256')==dm$sha256,digest::digest(file=file.path(out,nm$native_file),algo='sha256')==nm$sha256)
x<-readRDS(file.path(out,m$batch_file));d<-readRDS(file.path(out,dm$diagnostic_file));native<-readRDS(file.path(out,nm$native_file))
coverage<-read_csv(file.path(out,'coverage-corrected.csv'),show_col_types=FALSE)
policy<-list(max_radius=2L,threshold=.1,coefficient=.3,tie_tolerance=1e-12,dual_gap=.01)
audit<-probabilities<-margins<-list();artifacts<-list()
for(id in paste0('26102:',c(4,11,59,23,24))) {
 e<-x$entries[[id]];f<-native$entries[[id]]$fixture
 fixture<-tibble(fixture_id=id,issue_id='26102',home=f$home,away=f$away);cutoff<-e$base$cutoff
 native_base<-e$base;market_base<-NULL;ref<-d$references[[id]]
 if(!is.null(ref))market_base<-list(grid=ref$model$grid,cutoff=cutoff,model_id='FROZEN_JOINT_MARKET_DC',source_hashes=list(market_diagnostic=dm$sha256,market_receipt=beidan:::.score_margin_hash(ref$model$receipt)),max_source_available_utc=max(ref$model$euro$quote_at,ref$model$asian$quote_at,lubridate::ymd_hms(map_chr(ref$evidence_rows,'data_available_ts'),tz='UTC')),intended_use='HISTORICAL_DIAGNOSTIC')
 sufficient<-!is.null(market_base)
 reason<-if(id=='26102:23')'Retrospective review: three available Euro companies all favor away, all three channels prior, joint residuals small; partial basket accepted for diagnostic only'else if(sufficient)'Retrospective review: no opponent-strength/lineup modelling; full Euro basket plus Asian/total support market scale'else'Retrospective review: missing Euro and totals prevents joint-market switch'
 review<-list(confidence='uncertain',market_sufficient=sufficient,market_consistent=sufficient,reason=reason,counterevidence='Not a measured numerical confidence score; target results already known; no prospective claim',evidence_ids='native-review',cutoff_utc=format(cutoff$cutoff_utc,'%Y-%m-%dT%H:%M:%SZ',tz='UTC'),native_hash=beidan:::.score_margin_hash(native_base),market_hash=if(is.null(market_base))'ABSENT'else beidan:::.score_margin_hash(market_base),author='ROOT_POST_RESULT',review_version='FM-1.6.0_RULE_ACCEPTANCE')
 selection_hashes<-list(original_forecast=m$sha256,market_snapshot=dm$sha256,fm_source_selection_inputs=beidan:::.score_margin_hash(list(native=native_base,market=market_base,review=review,fixture=fixture,cutoff=cutoff)),fm_source_selection_code=digest::digest(paste(deparse(body(beidan:::SelectFmProbabilitySource)),collapse='\n'),algo='sha256'),fm_source_selection_dependencies=beidan:::.score_margin_code(impl))
 rows<-e$evidence_rows
 ctx<-backend$build_adjustment_evidence_context(rows,as.list(fixture),shared$Cutoff$decision_epoch('26102',review$cutoff_utc),selection_hashes,shared$AvailabilityPolicy$historical_proxy('FM16_POST_RESULT_RULE_ACCEPTANCE_ONLY'),'HISTORICAL_DIAGNOSTIC',impl)
 selected<-beidan:::SelectFmProbabilitySource(native_base,market_base,review,ctx,fixture,cutoff,impl)
 stopifnot(identical(selected,beidan:::SelectFmProbabilitySource(native_base,market_base,review,ctx,fixture,cutoff,impl)))
 base<-selected$base
 tail_review<-list(decision='apply',center_mode='auto',base_hash=beidan:::.score_margin_hash(base$grid),cutoff_utc=review$cutoff_utc,reason='FM16 explicit source and auto adjacent centers',counterevidence='Expert policy; no independent accuracy validation')
 pol<-beidan:::BuildFmTailJudgement(base,tail_review,'native-review',cutoff,policy)
 hashes<-c(selection_hashes,list(source_selection_receipt=beidan:::.score_margin_hash(selected$receipt),base_artifact=beidan:::.score_margin_hash(base),margin_judgement=beidan:::.score_margin_hash(pol$judgement),direction_implementation=beidan:::.score_margin_code(impl),tail_binding=pol$binding_hash))
 ctx2<-backend$build_adjustment_evidence_context(rows,as.list(fixture),shared$Cutoff$decision_epoch('26102',review$cutoff_utc),hashes,shared$AvailabilityPolicy$historical_proxy('FM16_POST_RESULT_RULE_ACCEPTANCE_ONLY'),'HISTORICAL_DIAGNOSTIC',impl)
 final<-beidan::adjust_score_margin_distribution(base,pol$judgement,ctx2,fixture,cutoff,impl)
 stopifnot(identical(final,beidan::adjust_score_margin_distribution(base,pol$judgement,ctx2,fixture,cutoff,impl)))
 # Seal score distribution before the actual Beidan line is supplied.
 saveRDS(list(selection=selected,policy=pol,final=final),file.path(dest,paste0('score-',gsub(':','-',id),'.rds')))
 p<-beidan::project_score_outcomes(final,f$handicap,impl)
 stopifnot(abs(sum(p$probability)-1)<1e-12)
 probabilities[[id]]<-p |> mutate(fixture_id=id,.before=1)
 margins[[id]]<-final$margins |> mutate(fixture_id=id,.before=1)
 audit[[id]]<-tibble(fixture_id=id,home=f$home,away=f$away,handicap=f$handicap,confidence=review$confidence,market_sufficient=sufficient,selected_source=selected$selected_source,center_mode=pol$branch,centers=paste(pol$centers,collapse=','),radius=pol$radius,euro_companies=coverage$euro_company_count[match(id,coverage$fixture_id)])
 artifacts[[id]]<-list(selection=selected,policy=pol,final=final,probabilities=p,selection_hashes=selection_hashes,tail_hashes=hashes)
}
audit<-bind_rows(audit);probabilities<-bind_rows(probabilities);margins<-bind_rows(margins)
stopifnot(nrow(audit)==5L,nrow(probabilities)==15L,audit$selected_source[audit$fixture_id=='26102:24']=='native',all(audit$selected_source[audit$fixture_id!='26102:24']=='market'))
for(id in names(artifacts)){canonical<-artifacts[[id]]$selection$base;canonical$source_hashes$selection_receipt<-NULL;stopifnot(beidan:::.score_margin_hash(canonical)==artifacts[[id]]$selection$receipt$output_hash,beidan:::.score_margin_hash(artifacts[[id]]$selection$receipt)==artifacts[[id]]$selection$base$source_hashes$selection_receipt)}
write_csv(audit,file.path(dest,'audit.csv'));write_csv(probabilities,file.path(dest,'probabilities.csv'));write_csv(margins,file.path(dest,'margins.csv'));saveRDS(artifacts,file.path(dest,'artifacts.rds'))
knitr::kable(audit,caption='实际裁决为ROOT的事后规则验收，未调用JEV')
knitr::kable(probabilities |> select(fixture_id,outcome,probability,rank,tied_rank) |> mutate(probability=100*probability),digits=2,caption='FM16让球类别概率，单位%，按最终完整类别排序')
knitr::kable(margins |> filter(between(margin,-3,5)) |> mutate(across(c(base_probability,probability),~100*.x)),digits=2,caption='净胜球原始及重加权概率，单位%；完整支持未删除')
```

真实JEV调用及数值置信评分尚未接入；这次实现的是可执行、绑定证据的等级裁决接口。传递学习/决策清单：原生estimate_recent_venue_goals与原市场project_dc_market_handicap是先前已冻结输入，其原收据与实现身份保留；本次SelectFmProbabilitySource与BuildFmTailJudgement是显式专家决策，之后adjust_score_margin_distribution、project_score_outcomes消费共享准入；build_adjustment_evidence_context/export_adjustment_evidence_context及prepare_learning_context/verify_learning_context承担全部时序、分区、权重和独立重放，未复制学习框架。新裁决正文、作者/版本、输入/函数体/依赖哈希均绑定到收据。

三路市场一致并非保证赛果：#23三家欧赔均偏客只是部分篮子充分性示例，不能把本例理由当通用自动准入。报告须给出实际残差、报价年龄、篮子覆盖及冻结充分/一致理由。基本面不确定但市场缺失时保留原生、标明诊断限制，不伪造高置信。原生近期权重、ρ及其他未讨论参数不改变。

权威实现：`SelectFmProbabilitySource`直接选用已验证网格，`BuildFmTailJudgement`构造单／双中心整数分区目标，既有`adjust_score_margin_distribution`重加权及`project_score_outcomes`冻结后投影。旧FM15函数移出当前源树，不加兼容包装；原FM15安装库、输入快照及已盘点实现仍只供原冻结诊断重放，不作为FM16接口。当前source选择不学习阈值或历史拟合，仅消费已共享准入的证据及显式审查。此前必要的score_margin_direction、fundamental_probability及共享context_replay模块尚未跟踪，本次连同其测试/文档纳入提交以补齐新接口的运行依赖；这些既有文件不改行为。NAMESPACE仅暂存5个必需FM导出，其他会话的导出与Nova工作不纳入提交。

函数／测试映射：`packages/beidan/tests/testthat/test-fm-probability-source.R`覆盖全部12种来源门控、无市场、截止/哈希变更、未来/目标污染、缺失/空/重复/非法支持及证据绑定；`test-fm-tail-judgement.R`覆盖单中心旧行为、双中心、反射、1个百分点边界、并列/非相邻/三档模糊、停止/半径上限、分区归一化及共享调整/投影。两项新专项合计179断言通过；既有市场/比分与基本面适配依赖的两项R测试合计130断言、Python适配2项测试通过。R CMD INSTALL到声明私有库验证实际可加载；不以load_all替代。依赖不新增，来自项目配置；R4.6.1、项目Python .venv、Quarto，渲染不安装依赖。

复现：`R CMD INSTALL -l results/fm16-release-20261012/library packages/beidan`；设`FM_NATIVE_TEST_ROOT=$PWD`后用声明库运行两项专项测试（load_helpers=FALSE）；`quarto render quarto/fm16_release_20261012.qmd --no-cache`。所有来源及原批次SHA在选择/调整收据内，改截止、来源或实现须重建；不跨截止缓存。全套测试、专项结果、审查及未通过项记录如下，不以专项通过替代全仓。

```{r}
