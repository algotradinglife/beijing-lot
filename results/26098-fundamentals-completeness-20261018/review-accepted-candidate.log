    69	## 原始缓存核验与恢复字段
    70	
    71	使用包内权威分析页解析器，核验同场provider及主客队ID；保留精确来源版本，不写回基础表。恢复赛事标签/链接和中立场标记为逐来源证据；缺少标记不填false。历史赛事ID/标签来自已解析blocks的原始列，中立场只接受显式“(中)”或“（中）”标记，其余为未知而非已证实非中立场。
    72	
    73	```{python}
    74	#| include: false
    75	import csv, hashlib, json, sqlite3, sys
    76	from pathlib import Path
    77	sys.path.insert(0,str(Path(r.root)/'packages/beidan/inst/python'))
    78	from beidan_backend.fundamentals import analysis_record, plain_text
    79	from bs4 import BeautifulSoup
    80	out=Path(r.output)
    81	with (out/'provenance.csv').open() as f: provenance=list(csv.DictReader(f))
    82	with (out/'identities.csv').open() as f: identities={row['fixture_id']:row for row in csv.DictReader(f)}
    83	raw_root=Path(r.raw_input)/'raw'
    84	raw_receipts=json.loads((Path(r.raw_input)/'raw-receipts.json').read_text())
    85	archive_index={(p['fixture_id'],p['source'],p['url'],p['sha256']):p for p in raw_receipts}
    86	assert len(archive_index)==len(raw_receipts)==len(provenance)==439
    87	bodies={}; source_context=[]; history_metadata=[]; parse_failures=[]
    88	from datetime import datetime
    89	for p in provenance:
    90	 key=(p['fixture_id'],p['source'],p['url'],p['sha256'])
    91	 archived=archive_index[key]
    92	 assert archived['path']=='raw/'+p['sha256']+'.bin'
    93	 assert datetime.fromisoformat(archived['capture_observed_at']).replace(microsecond=0)==datetime.fromisoformat(p['observed_at'].replace('Z','+00:00'))
    94	 body=(Path(r.raw_input)/archived['path']).read_bytes()
    95	 assert len(body)==archived['bytes'] and hashlib.sha256(body).hexdigest()==p['sha256']
    96	 bodies[(p['fixture_id'],p['source'],p['url'])]=body
    97	for fixture,identity in identities.items():
    98	 for source in ('titan','nowscore'):
    99	  url=(f"https://zq.titan007.com/analysis/{identity['provider_id']}cn.htm" if source=='titan' else f"https://live.nowscore.com/analysis/{identity['provider_id']}cn.html")
   100	  p=next(x for x in provenance if (x['fixture_id'],x['source'],x['url'])==(fixture,source,url))
   101	  body=bodies[(fixture,source,url)]
   102	  auxiliary=bodies.get((fixture,source,f"https://live.nowscore.com/analysisJs/data{identity['provider_id']}.js"))
   103	  try:
   104	   record=analysis_record(body,source=source,provider_id=identity['provider_id'],auxiliary_raw=auxiliary)
   105	  except (ValueError,KeyError,TypeError) as error:
   106	   parse_failures.append({'fixture_id':fixture,'source':source,'error':str(error),'sha256':p['sha256']}); continue
   107	  assert (record['home_id'],record['away_id'])==(identity['home_id'],identity['away_id'])
   108	  soup=BeautifulSoup(body,'html.parser')
   109	  links=soup.select('a.LName[href]') if source=='titan' else []
   110	  competition=plain_text(str(links[0])) if len(links)==1 else None
   111	  competition_url=links[0]['href'] if len(links)==1 else None
   112	  header=soup.find('a',href=f"//zq.titan007.com/cn/team/Summary/{identity['home_id']}.html") if source=='titan' else soup.find('a',href=f"//info.nowscore.com/cn/team/Summary.aspx?teamid={identity['home_id']}")
   113	  header_text=header.get_text(' ',strip=True) if header else None
   114	  explicit_neutral=bool(header_text and ('(中)' in header_text or '（中）' in header_text))
   115	  explicit_home=bool(header_text and ('(主)' in header_text or '（主）' in header_text))
   116	  route=('CUP_ROUTE' if competition_url and '/cup_match/' in competition_url else 'LEAGUE_ROUTE' if competition_url and '/league_match/' in competition_url else 'UNKNOWN')
   117	  source_context.append({'fixture_id':fixture,'source':source,'competition':competition,'competition_url':competition_url,'source_route':route,'home_header':header_text,'neutral':True if explicit_neutral else False if explicit_home else None,'kickoff_utc':record['kickoff_utc'],'url':url,'observed_at':p['observed_at'],'sha256':p['sha256'],'availability_class':'HISTORICAL_PROXY','prospective_admission':False})
   118	  data_url=f"https://live.nowscore.com/analysisJs/data{identity['provider_id']}.js" if record['blocks_from_auxiliary'] else url
   119	  data_receipt=next(x for x in provenance if (x['fixture_id'],x['source'],x['url'])==(fixture,source,data_url))
   120	  for item in record['history']:
   121	   row=record['blocks'][item['block']][item['ordinal']]
   122	   history_metadata.append({'fixture_id':fixture,'source':source,'block':item['block'],'match_id':item['history_id'],'competition_id':str(row[1]),'competition':plain_text(str(row[2])) or None,'explicit_neutral':True if ('(中)' in str(row[5]) or '（中）' in str(row[5])) else None,'analysis_sha256':p['sha256'],'data_url':data_url,'data_sha256':data_receipt['sha256'],'data_observed_at':data_receipt['observed_at'],'availability_class':'HISTORICAL_PROXY','prospective_admission':False})
   123	(out/'raw-receipts.json').write_text(json.dumps(raw_receipts,ensure_ascii=False,indent=2))
   124	(out/'source-context.json').write_text(json.dumps(source_context,ensure_ascii=False,indent=2))
   125	(out/'history-metadata.json').write_text(json.dumps(history_metadata,ensure_ascii=False,indent=2))
   126	(out/'parse-failures.json').write_text(json.dumps(parse_failures,ensure_ascii=False,indent=2))
   127	assert len(raw_receipts)==439
   128	assert not parse_failures,parse_failures
   129	assert len(source_context)==292
