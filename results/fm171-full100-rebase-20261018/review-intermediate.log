"""Count-reviewed preparation for new same-support football diagnostics."""
from pathlib import Path

from .opponent_goals import prepare_opponent_goals
from .temporal_learning import implementation_closure
from .temporal_learning.core import stable_json_hash
from .temporal_learning.recent_support import inspect_recent_support


def prepare_reviewed_opponent_goals(rows, fixture, excluded_native_ids, cutoff,
                                    source_hashes, repository_root,
                                    native_policy):
    """Prepare factual count-based inputs with no calendar-age exclusion.

    Arguments follow prepare_opponent_goals, including explicit native_policy
    (recent_n, alpha, minimum_recent_matches, minimum_recent_ess). Both target
    venue groups must exist. Shared recent weights and original date spans are
    independently inspected; old dates never veto otherwise valid history.
    Missing target groups return prepared=None. Existing sparse-prior and R
    minimum support rules remain authoritative. No fitting or side effects.
    """
    implementation = implementation_closure(Path(repository_root),
        ("beidan_backend.reviewed_opponent_goals",), distributions=("pandas", "numpy"))
    bindings = {**source_hashes, "recent_preparation_code": stable_json_hash(implementation)}
    prepared = prepare_opponent_goals(rows, fixture, excluded_native_ids, cutoff,
        bindings, repository_root, native_policy)
    targets = {(fixture["home_id"], "neutral" if fixture["neutral_reported"] else "home"),
               (fixture["away_id"], "neutral" if fixture["neutral_reported"] else "away")}
    reviews = []
    seen = set()
    for context in prepared["contexts"]:
        frame = context.partitions["fit"]
        target = (frame.team_id.iloc[0], frame.venue.iloc[0])
        if target in targets:
            seen.add(target)
            reviews.append(inspect_recent_support(context, cutoff,
                native_policy["recent_n"], repository_root))
    accepted = seen == targets
    return dict(state="PREPARED" if accepted else "UNESTIMATED_TARGET_SUPPORT",
                prepared=prepared if accepted else None, reviews=reviews,
                missing_target_groups=sorted(targets - seen), native_policy=native_policy,
                implementation=implementation, source_hashes=bindings)
