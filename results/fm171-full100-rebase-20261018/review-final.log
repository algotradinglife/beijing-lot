stopifnot(f"'$qmd_sha256==digest::digest(file='"'quarto/fm171_full100_historical_20261018.qmd',algo='sha256'))
cat('Frozen QMD hash matches:',f"'$qmd_sha256,'"'\\n')
for(n in c('native','market'))stopifnot(identical(readRDS(file.path(o,paste0(n,'-rebase.rds'))),readRDS(file.path(o,'independent-replay',paste0(n,'-rebase.rds')))))
cat('Both replay objects identical\\n')
a<-jsonlite::fromJSON(file.path(o,'acceptance.json'))
for(p in names(a"'$code_hashes))stopifnot(a$code_hashes[[p]]==digest::digest(file=p,algo='"'sha256'))
cat('All acceptance code hashes match\\n')
rr<-f"'$routes;print(count(rr,source))
qualified<-0
for(i in seq_along(f$plans)){
 p<-f$plans[[i]];par<-readRDS(file.path('"'results',p"'$dataset,'"'frozen-probabilities.rds'))
 for(j in which(rr"'$dataset==p$dataset & rr$sheet==p$sheet & grepl('"'MARKET',rr"'$source))){
  e<-par$entries[[rr$fixture_id[j]]];stopifnot(e$review$confidence %in% c('"'low','uncertain'));qualified<-qualified+1
 }
 stopifnot(2*nrow(p"'$tickets)<=p$requested_stake_cny)
}
cat('"'Confidence-qualified market route rows:',qualified,'\\n')
print(readr::read_csv(file.path(o,'comparison.csv'),show_col_types=FALSE) |> select(sheet,requested_stake_cny,estimable_stake_cny,payout_cny,net_cny,monetary_complete))
