     5	  cache: false
     6	  freeze: false
     7	  error: false
     8	params:
     9	  project_root: "."
    10	---
    11	
    12	事后固定政策诊断，不是前瞻检验。沿用原四轮实际用过的去重场次池14/14/13/11场，固定8个不同七场组合、每组125注、单注2元、每轮2000元；不扩池，避免新增标签可用性偏差。概率固定为100%完整、尾部压缩前的原FM来源裁决分布。比较两个因素：原构组/复用均衡构组 × 统一30–154名/错开1–125、126–250、251–375、376–500名（各2组）。不使用实际SP，不推算收益。
    13	
    14	均衡组要求每场出现floor(56/N)到ceiling(56/N)次；在该约束下用成熟lpSolve二元整数规划选择8个不同七场组，最大化全部组的单场Top1对数概率之和。该质量分数只作固定破平偏好，不是拟合或调优，不保证最优票单概率质量。区间错开时按各组Top1对数概率之和降序、组内ID破平，将较高模型信心组分配较浅区间。四项政策事先写在本文件，未按目标赛果挑种子/方案/阈值。执行先冻结构组及票单，再读取固定赛果。
    15	
    16	```{r}
    17	#| include: false
    18	suppressPackageStartupMessages(library(tidyverse))
    19	root<-normalizePath(params$project_root,mustWork=TRUE)
    20	library(beidan,lib.loc=file.path(root,'r_lib'))
    21	stopifnot(requireNamespace('lpSolve',quietly=TRUE))
    22	w<-file.path(root,'results/fm17-upcoming-20261017')
    23	f<-readRDS(file.path(w,'frozen-probabilities.rds'));b<-readRDS(file.path(w,'plans.rds'))
    24	source_probs<-file.path(root,'results/margin-truncated-rank-20261017/conditional-probabilities.csv')
    25	q<-readr::read_csv(source_probs,show_col_types=FALSE) |> filter(threshold==1) |> select(fixture_id,outcome,probability)
    26	stopifnot(!anyDuplicated(q[c('fixture_id','outcome')]))
    27	output<-file.path(root,'results/margin-risk-diversification-20261017');dir.create(output,recursive=TRUE,showWarnings=FALSE)
    28	group_records<-list();ticket_records<-list();membership<-list();policy_receipts<-list()
    29	for(i in 1:4){
    30	 p<-b$plans[[i]];cutoff<-p$selection_receipt$cutoff
    31	 stopifnot(inherits(cutoff$cutoff_utc,'POSIXct'),!is.na(cutoff$cutoff_utc))
    32	 ids<-sort(unique(p$legs$fixture_id));n<-length(ids);minimum<-floor(56/n);maximum<-ceiling(56/n)
    33	 for(id in ids){
    34	  entry<-f$entries[[id]]$base
    35	  stopifnot(identical(as.numeric(entry$cutoff$cutoff_utc),as.numeric(cutoff$cutoff_utc)),entry$max_source_available_utc<cutoff$cutoff_utc)
    36	 }
    37	 quality<-q |> filter(fixture_id %in% ids) |> group_by(fixture_id) |> summarise(log_top=log(max(probability)),.groups='drop') |> arrange(fixture_id)
    38	 stopifnot(identical(quality$fixture_id,ids))
    39	 combinations<-utils::combn(seq_len(n),7L)
    40	 incidence<-matrix(0,nrow=n,ncol=ncol(combinations))
    41	 for(k in seq_len(ncol(combinations)))incidence[combinations[,k],k]<-1
    42	 scores<-as.numeric(crossprod(quality$log_top,incidence))
    43	 fit<-lpSolve::lp('max',scores,rbind(rep(1,ncol(incidence)),incidence,incidence),c('=',rep('>=',n),rep('<=',n)),c(8,rep(minimum,n),rep(maximum,n)),all.bin=TRUE)
    44	 stopifnot(fit$status==0L)
    45	 chosen<-which(fit$solution>.5)
    46	 stopifnot(length(chosen)==8L,all(rowSums(incidence[,chosen,drop=FALSE])>=minimum),all(rowSums(incidence[,chosen,drop=FALSE])<=maximum))
    47	 balanced<-list()
    48	 for(k in seq_along(chosen))balanced[[k]]<-ids[combinations[,chosen[k]]]
    49	 original<-list()
    50	 for(g in 1:8) original[[g]]<-sort(p$legs$fixture_id[p$legs$group_slot==g])
    51	 for(construction in c('original','balanced')){
    52	  groups<-if(construction=='original')original else balanced
    53	  keys<-vapply(groups,paste,character(1),collapse='|')
    54	  stopifnot(length(unique(keys))==8L,all(lengths(groups)==7L))
    55	  group_quality<-numeric(8)
    56	  for(g in 1:8)group_quality[g]<-sum(quality$log_top[match(groups[[g]],quality$fixture_id)])
    57	  priority<-order(-group_quality,keys)
    58	  # Two groups per interval, assigned before opening labels.
    59	  depth_start<-integer(8);depth_start[priority]<-rep(c(1L,126L,251L,376L),each=2L)
    60	  for(g in 1:8){
    61	   group_ids<-groups[[g]];gid<-paste0('R',i,':',construction,':G',g);cid<-paste0(gid,'|7')
    62	   gl<-tibble(group_id=gid,fixture_id=group_ids,leg_order=1:7)
    63	   supports<-q |> filter(fixture_id %in% group_ids) |> transmute(candidate_id=cid,fixture_id,outcome,allowed=TRUE,preference=match(outcome,c('W','D','L')))
    64	   space<-beidan::parlay_enumerate_tickets(gl,q,cutoff=cutoff,supports=supports,n_legs=7L)
    65	   ranked<-beidan::parlay_rank_tickets(space$tickets,space$candidate_tickets,cutoff=cutoff,ranking='probability_desc') |> as_tibble()
    66	   stopifnot(nrow(ranked)==2187L,abs(sum(ranked$probability)-1)<1e-9,!anyDuplicated(ranked$ticket_id))
    67	   for(window in c('uniform','staggered')){
    68	    lo<-if(window=='uniform')30L else depth_start[g]
    69	    bought<-ranked |> filter(rank>=lo,rank<=lo+124L)
    70	    stopifnot(nrow(bought)==125L)
    71	    ticket_records[[length(ticket_records)+1L]]<-bought |> transmute(round=i,construction,window,group=g,ticket_id,rank,probability)
    72	    group_records[[length(group_records)+1L]]<-tibble(round=i,construction,window,group=g,rank_start=lo,rank_end=lo+124L,model_mass=sum(bought$probability),cost_cny=250,fixtures=paste(group_ids,collapse='|'))
    73	   }
    74	   membership[[length(membership)+1L]]<-tibble(round=i,construction,group=g,fixture_id=group_ids)
    75	  }
    76	 }
    77	 policy_receipts[[i]]<-list(round=i,cutoff=cutoff,pool=ids,minimum_reuse=minimum,maximum_reuse=maximum,solver='lpSolve',solver_version=as.character(packageVersion('lpSolve')),solver_status=fit$status,candidate_groups=ncol(combinations),objective=fit$objval,chosen_indices=chosen,source_probabilities_sha256=digest::digest(file=source_probs,algo='sha256'))
    78	}
    79	group_plan<-bind_rows(group_records);tickets<-bind_rows(ticket_records);members<-bind_rows(membership)
    80	stopifnot(nrow(group_plan)==128L,nrow(tickets)==16000L)
    81	freeze<-list(groups=group_plan,tickets=tickets,membership=members,receipts=policy_receipts,probability_sha256=digest::digest(file=source_probs,algo='sha256'),plans_sha256=digest::digest(file=file.path(w,'plans.rds'),algo='sha256'),implementation_sha256=digest::digest(file=file.path(root,'quarto/margin_risk_diversification_20261017.qmd'),algo='sha256'),generated_at_utc=format(Sys.time(),tz='UTC',format='%Y-%m-%dT%H:%M:%SZ'),purpose='POSTEVENT_FIXED_POLICY_NO_OUTCOME_SELECTION')
    82	saveRDS(freeze,file.path(output,'frozen-comparison-plan.rds'))
    83	# Only now open target labels. This order does not make a retrospectively designed experiment prospective.
    84	s<-jsonlite::fromJSON(file.path(root,'results/margin-ranking-20261017-review/settlement-state.json'))
    85	actual_rows<-list();labels<-character()
    86	for(i in 1:4){
    87	 path<-file.path(s$run_directory,s$plans$output[i],'results.json');labels<-c(labels,path)
    88	 actual_rows[[i]]<-as_tibble(jsonlite::fromJSON(path)$fixture_results) |> transmute(round=i,fixture_id,actual=outcome)
    89	}
    90	a<-bind_rows(actual_rows);stopifnot(!anyDuplicated(a[c('round','fixture_id')]))
    91	evaluated<-list()
    92	for(j in seq_len(nrow(group_plan))){
    93	 row<-group_plan[j,];ids<-members |> filter(round==row$round,construction==row$construction,group==row$group) |> pull(fixture_id)
    94	 labels_for_group<-tibble(fixture_id=ids) |> left_join(a |> filter(round==row$round) |> select(-round),by='fixture_id',relationship='one-to-one')
    95	 purchases<-tickets |> filter(round==row$round,construction==row$construction,window==row$window,group==row$group)
    96	 # Authoritative physical ticket key uses source outcome codes W/D/L=1/2/3.
    97	 possible<-rep(TRUE,nrow(purchases))
    98	 for(k in seq_len(nrow(labels_for_group))){
    99	  if(is.na(labels_for_group$actual[k]))next
   100	  token<-paste0(labels_for_group$fixture_id[k],':',match(labels_for_group$actual[k],c('W','D','L')))
   101	  parts<-strsplit(purchases$ticket_id,'|',fixed=TRUE)
   102	  possible<-possible & vapply(parts,`%in%`,logical(1),x=token)
   103	 }
   104	 known<-sum(!is.na(labels_for_group$actual))
   105	 hit<-if(known==7L)any(possible) else if(any(possible))NA else FALSE
