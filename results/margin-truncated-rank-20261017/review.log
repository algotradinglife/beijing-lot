library(jsonlite)
f<-readRDS(\"results/fm17-upcoming-20261017/frozen-probabilities.rds\"); b<-readRDS(\"results/fm17-upcoming-20261017/plans.rds\")
z<-read.csv(\"results/margin-truncated-rank-20261017/conditional-probabilities.csv\")
x<-read.csv(\"results/margin-truncated-rank-20261017/groups.csv\")
s<-fromJSON(\"results/margin-ranking-20261017-review/settlement-state.json\")
stopifnot(nrow(z)==52*9*3,nrow(x)==288)
for(id in unique(z"'$fixture_id)){
 e<-f$entries[[id]];stopifnot(identical(e$base,e$selection$base),identical(e$base$cutoff,f$cutoff),e$base$max_source_available_utc<f$cutoff$cutoff_utc)
 h<-unique(f$probabilities$handicap[f$probabilities$fixture_id==id])
 m<-tapply(e$base$grid$probability,e$base$grid$home_goals-e$base$grid$away_goals,sum)
 for(t in unique(z$threshold)){
  sm<-sort(m,decreasing=TRUE); boundary<-sm[which(cumsum(sm)>=t)[1]]
  keep<-m>=boundary; v<-setNames(rep(0,3),c("W","D","L"))
  for(j in which(keep)){a<-as.numeric(names(m)[j])+h;o<-if(a>0)"W" else if(a==0)"D" else "L";v[o]<-v[o]+m[j]/sum(m[keep])}
  r<-z[z$fixture_id==id & z$threshold==t,];stopifnot(max(abs(r$probability-v[r$outcome]))<1e-12)
 }
}
for(i in 1:4){
 actual<-fromJSON(file.path(s$run_directory,s$plans$output[i],"results.json"))$fixture_results
 for(g in 1:8){
  legs<-b$plans[[i]]$legs;legs<-legs[legs$group_slot==g,];legs<-legs[order(legs$round),]
  obs<-actual$outcome[match(legs$fixture_id,actual$fixture_id)]
  for(t in unique(z$threshold)){
   ps<-lapply(legs$fixture_id,function(id){r<-z[z$fixture_id==id & z$threshold==t & z$probability>0,];setNames(r$probability,r$outcome)})
   gr<-expand.grid(lapply(ps,names),stringsAsFactors=FALSE)
   prob<-rep(1,nrow(gr));ok<-rep(TRUE,nrow(gr))
   for(j in 1:7){prob<-prob*ps[[j]][gr[[j]]];if(!is.na(obs[j]))ok<-ok & gr[[j]]==obs[j]}
   r<-x[x$round==i & x$group==g & x$threshold==t,]
   stopifnot(nrow(gr)==r$theory)
   if(all(!is.na(obs)) && any(ok)){
    # Verify rank except exact ties, whose canonical key ordering belongs to package.
    pwin<-prob[ok];stopifnot(r$winning_rank>sum(prob>pwin),r$winning_rank<=sum(prob>=pwin))
   }
   stopifnot(r$state==if(!any(ok))"EXCLUDED" else if(anyNA(obs))"PENDING" else "RANKED")
  }
 }
}
