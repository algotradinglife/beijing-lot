#' Fit an opponent-normalized Poisson attack and defence model
#' @param prepared Python object returned by prepare_opponent_goals(), including
#'   verified shared contexts, complete weight ledgers and their receipts.
#' @param fixture Named list with home_id, away_id, competition_id and explicit
#'   logical neutral_reported; IDs refer to the target fixture.
#' @param cutoff Explicit shared Cutoff object bound to the prepared contexts.
#' @param policy Named list with ridge (positive fixed glmnet lambda),
#'   minimum_target_matches (integer venue support floor), convergence_tolerance
#'   and maximum_iterations. No target labels or market values are accepted.
#' @param repository_root Explicit path containing the project Python backend.
#' @return List of one-row parameter and same-support raw-parameter tibbles,
#'   coefficient/support/observation tibbles, shared receipts and a fit receipt.
#' @details Research only. Uses glmnet Poisson ridge with an unpenalized intercept
#'   and home indicator; attack/defence features receive equal shrinkage toward
#'   zero. Competition is fixed by the source-reported target league. Sparse,
#'   disconnected target teams, wrong cutoffs or changed implementation fail.
#'   No fetching or writes. Non-neutrality is not independently verified.
FitOpponentGoals <- function(prepared, fixture, cutoff, policy, repository_root) {
  root <- normalizePath(repository_root,mustWork=TRUE)
  if (!inherits(prepared,"python.builtin.object") || !inherits(cutoff,"python.builtin.object") ||
      !is.list(fixture) || !is.logical(fixture$neutral_reported) ||
      length(fixture$neutral_reported)!=1L || is.na(fixture$neutral_reported)) stop("Explicit prepared context, cutoff and venue required")
  checkmate::assert_names(names(policy),identical.to=c("ridge","minimum_target_matches","convergence_tolerance","maximum_iterations"))
  checkmate::assert_number(policy$ridge,lower=.Machine$double.eps)
  checkmate::assert_int(policy$minimum_target_matches,lower=2L)
  checkmate::assert_number(policy$convergence_tolerance,lower=.Machine$double.eps)
  checkmate::assert_int(policy$maximum_iterations,lower=1L)
  reticulate::use_python(file.path(root,".venv/bin/python"),required=TRUE)
  backend <- reticulate::import("beidan_backend.opponent_goals",convert=FALSE)
  backend$verify_opponent_preparation(prepared,fixture,cutoff,root)
  observations <- dplyr::bind_rows(reticulate::py_to_r(prepared$observations))
  support <- dplyr::bind_rows(reticulate::py_to_r(prepared$support))
  if (!nrow(observations) || anyNA(observations) || anyDuplicated(observations$row_key) ||
      !all(observations$competition_id==fixture$competition_id) ||
      any(!is.finite(observations$weight)|observations$weight<=0)) stop("Opponent observations contract differs")
  home_venue <- if(fixture$neutral_reported) "neutral" else "home"
  away_venue <- if(fixture$neutral_reported) "neutral" else "away"
  home <- dplyr::filter(observations,team_id==fixture$home_id,venue==home_venue)
  away <- dplyr::filter(observations,team_id==fixture$away_id,venue==away_venue)
  if(min(nrow(home),nrow(away))<policy$minimum_target_matches) stop("Sparse target competition/venue support")
  teams <- sort(unique(c(observations$team_id,observations$opponent_id)))
  # Matrix sparse model columns use numeric team positions, preserving IDs.
  attack <- match(observations$team_id,teams)
  defence <- match(observations$opponent_id,teams)
  adjacency <- Matrix::sparseMatrix(i=attack,j=defence,x=1,dims=c(length(teams),length(teams)))
  # Mature igraph connectivity avoids estimating disconnected relative strengths.
  graph <- igraph::graph_from_adjacency_matrix(adjacency,mode="undirected",weighted=TRUE,diag=FALSE)
  components <- igraph::components(graph)$membership
  if(components[match(fixture$home_id,teams)]!=components[match(fixture$away_id,teams)]) stop("Disconnected target strength network")
  selected_component <- components[match(fixture$home_id,teams)]
  observations <- observations[components[attack]==selected_component,,drop=FALSE]
  teams <- sort(unique(c(observations$team_id,observations$opponent_id)))
  attack <- match(observations$team_id,teams); defence <- match(observations$opponent_id,teams)
  n <- nrow(observations); k <- length(teams)
  design <- Matrix::sparseMatrix(i=rep(seq_len(n),3),
    j=c(rep(1L,n),1L+attack,1L+k+defence),
    x=c(observations$home_indicator,rep(1,2*n)),dims=c(n,1L+2L*k))
  colnames(design) <- c("home_indicator",paste0("attack:",teams),paste0("defence:",teams))
  if(sum(observations$goals)==0) stop("Positive goal mass required")
  fit <- glmnet::glmnet(design,observations$goals,family="poisson",alpha=0,
    lambda=policy$ridge,weights=observations$weight,standardize=FALSE,
    intercept=TRUE,penalty.factor=c(0,rep(1,2*k)),
    control=list(thresh=policy$convergence_tolerance,maxit=policy$maximum_iterations))
  if(fit$jerr!=0L || length(fit$lambda)!=1L) stop("Poisson ridge did not converge")
  target <- Matrix::sparseMatrix(i=rep(1:2,3),
    j=c(c(1L,1L),1L+match(c(fixture$home_id,fixture$away_id),teams),
        1L+k+match(c(fixture$away_id,fixture$home_id),teams)),
    x=c(if(fixture$neutral_reported)c(.5,.5)else c(1,0),rep(1,4)),dims=c(2,1L+2L*k))
  predicted <- as.numeric(stats::predict(fit,newx=target,type="response",s=policy$ridge))
  if(any(!is.finite(predicted)|predicted<=0)) stop("Positive finite predicted goal means required")
  parameters <- tibble::tibble(lambda_home=predicted[1],lambda_away=predicted[2])
  raw <- tibble::tibble(lambda_home=(stats::weighted.mean(home$goals,home$weight)+stats::weighted.mean(away$against,away$weight))/2,
    lambda_away=(stats::weighted.mean(away$goals,away$weight)+stats::weighted.mean(home$against,home$weight))/2)
  if(any(unlist(raw)<=0)) stop("Positive same-support raw means required")
  coefficients <- tibble::tibble(term=rownames(stats::coef(fit,s=policy$ridge)),value=as.numeric(stats::coef(fit,s=policy$ridge)))
  receipts <- reticulate::py_to_r(prepared$receipts)
  admission <- reticulate::py_to_r(prepared$admission$receipt$payload)
  dependencies <- list(glmnet=as.character(utils::packageVersion("glmnet")),Matrix=as.character(utils::packageVersion("Matrix")),igraph=as.character(utils::packageVersion("igraph")))
  shared <- reticulate::import("beidan_backend.temporal_learning",convert=FALSE)
  cache_key <- reticulate::py_to_r(shared$temporal_cache_key(cutoff,
    c(admission$source_hashes,list(fit_policy=digest::digest(policy,algo="sha256"),
      dependencies=digest::digest(dependencies,algo="sha256"),groups=digest::digest(receipts,algo="sha256"))),
    admission$implementation_hashes,shared$AvailabilityPolicy$historical_proxy("DATE_PLUS_ONE_UTC_OPPONENT_NETWORK_DIAGNOSTIC"),
    "HISTORICAL_DIAGNOSTIC",shared$PartitionPolicy("FIXED_PRIOR_FIT",0L,0L,1L),
    shared$WeightingPolicy$expanding_equal(minimum_ess=1)))
  receipt <- list(model="OPPONENT_POISSON_RIDGE_RESEARCH_1",cutoff=reticulate::py_to_r(cutoff$identity),
    policy=policy,fixture=fixture,admission=admission,cache_key=cache_key,cache_reuse="NONE",
    group_receipts_sha256=digest::digest(receipts,algo="sha256"),
    observations_sha256=digest::digest(observations,algo="sha256"),
    R_code_sha256=digest::digest(file=file.path(root,"packages/beidan/R/opponent_goals.R"),algo="sha256"),
    dependencies=dependencies,
    parameters_sha256=digest::digest(parameters,algo="sha256"),coefficients_sha256=digest::digest(coefficients,algo="sha256"),
    target_label_optimization=FALSE,intended_use="HISTORICAL_DIAGNOSTIC",fitted_rows=n)
  list(parameters=parameters,same_support_raw=raw,coefficients=coefficients,
       support=support,observations=observations,receipts=receipts,
       ledgers=reticulate::py_to_r(prepared$ledgers),receipt=receipt)
}
"""Domain preparation for opponent-normalized Poisson attack/defence research.

Every admission, partition, recent mass, ESS and implementation receipt comes
from shared temporal_learning. R owns the statistical fit through glmnet.
"""
from pathlib import Path
from dataclasses import asdict
import hashlib
import pandas as pd
from .temporal_learning import (Cutoff, AvailabilityFilter, AvailabilityPolicy,
    PartitionPolicy, WeightingPolicy, prepare_learning_context)
from .temporal_learning.context_replay import verify_learning_context
from .temporal_learning.core import stable_json_hash


def prepare_opponent_goals(rows, fixture, excluded_native_ids, cutoff,
                           source_hashes, repository_root, policy):
    """Return prior goal observations, per-team venue weights and full receipts.

    rows: unique row_key per source fixture/scope/match, date-only factual scores,
    competition_id and boolean neutral_reported. excluded_native_ids is the
    full target/future roster, including deliberately bad early dates. Original
    date+1 UTC availability is diagnostic only. Duplicate prior match copies
    must agree on every fitting fact; contradictions fail closed. Rows with no
    competition metadata must be explicitly removed by the caller and counted.
    policy: recent_n, alpha, minimum_recent_matches, minimum_recent_ess;
    sparse team/venue groups use the shared expanding-equal long prior.
    Return contexts alongside their receipts, making independent verification
    possible before R fits. No fitting, file writes or market inputs.
    """
    if (not isinstance(cutoff,Cutoff) or cutoff.kind!='DECISION_EPOCH'
            or fixture.get('issue_id')!=cutoff.target_issue
            or not excluded_native_ids or fixture.get('provider_id') not in excluded_native_ids
            or len(excluded_native_ids)!=len(set(excluded_native_ids)) or not source_hashes):
        raise ValueError('Explicit bound cutoff and complete target/future roster required')
    if (set(policy)!={'recent_n','alpha','minimum_recent_matches','minimum_recent_ess'}
            or type(policy['recent_n']) is not int or policy['recent_n']<1
            or type(policy['minimum_recent_matches']) is not int
            or policy['minimum_recent_matches']<policy['recent_n']
            or not 0<policy['alpha']<1 or policy['minimum_recent_ess']<=0):
        raise ValueError('Explicit valid opponent recent policy required')
    frame=pd.DataFrame(rows)
    facts=['match_id','event_date','home_id','away_id','home_score','away_score',
           'score_scope','competition_id','neutral_reported']
    if frame.empty or not set(facts+['row_key'])<=set(frame) or frame.row_key.duplicated().any():
        raise ValueError('Nonempty unique factual rows required')
    dates=pd.to_datetime(frame.event_date,format='%Y-%m-%d',utc=True,errors='raise')
    frame['label_available_ts']=dates+pd.Timedelta(days=1)
    frame['data_available_ts']=frame.label_available_ts
    frame['event_order_ts']=dates
    frame['issue_year']=dates.dt.year
    frame['issue_code']=frame.match_id.map(lambda m:cutoff.target_issue if m in excluded_native_ids else 'MATCH:'+m)
    root=Path(repository_root)
    bindings={**source_hashes,'input_rows':stable_json_hash(rows),'fixture':stable_json_hash(fixture),
              'excluded_roster':stable_json_hash(sorted(excluded_native_ids)),
              'policy':stable_json_hash(policy),
              'R_fit':hashlib.sha256((root/'packages/beidan/R/opponent_goals.R').read_bytes()).hexdigest()}
    availability=AvailabilityFilter(AvailabilityPolicy.historical_proxy(
        'DATE_PLUS_ONE_UTC_OPPONENT_NETWORK_DIAGNOSTIC'),data_available_column='data_available_ts')
    admission=prepare_learning_context(frame,cutoff,source_hashes=bindings,repository_root=root,
        implementation_modules=('beidan_backend.opponent_goals',),
        implementation_distributions=('pandas','numpy'),availability=availability,
        intended_use='HISTORICAL_DIAGNOSTIC',partition_policy=PartitionPolicy('FIXED_PRIOR_FIT',0,0,1),
        weighting_policy=WeightingPolicy.expanding_equal(minimum_ess=1))
    verify_learning_context(admission,repository_root=root)
    prior=admission.partitions['fit']
    if prior[facts].isna().any().any():raise ValueError('Prior fitting facts cannot be missing')
    for col in ['match_id','home_id','away_id','competition_id','score_scope']:
        if not prior[col].map(lambda x:isinstance(x,str) and bool(x)).all():
            raise ValueError('Nonempty character factual identities required')
    for col in ['home_score','away_score']:
        if not prior[col].map(lambda x:not isinstance(x,bool) and isinstance(x,(int,float))
                              and float(x).is_integer() and 0<=x<=2147483647).all():
            raise ValueError('Nonnegative integer scores required')
    if not prior.neutral_reported.map(lambda x:type(x)is bool).all():
        raise ValueError('Boolean neutral source marker required')
    if prior.home_id.eq(prior.away_id).any():raise ValueError('Distinct oriented team identities required')
    if (prior.groupby('match_id')[facts].nunique(dropna=False)>1).any().any():
        raise ValueError('Conflicting prior match copies require adjudication')
    if not isinstance(fixture.get('competition_id'),str) or not fixture['competition_id']:
        raise ValueError('Explicit target competition identity required')
    prior=prior[prior.competition_id.eq(fixture['competition_id'])]
    if prior.empty:raise ValueError('No prior target-competition network')
    unique=prior.sort_values(['match_id','row_key'],kind='stable').drop_duplicates('match_id').reset_index(drop=True)
    # One scoring observation per team per match. Venue grouping is native input.
    observations=[]
    for side,own,opponent,goals,against in [('home','home_id','away_id','home_score','away_score'),
                                           ('away','away_id','home_id','away_score','home_score')]:
        f=unique.copy();f['team_id']=f[own];f['opponent_id']=f[opponent]
        f['goals']=f[goals];f['against']=f[against]
        f['venue']=f.neutral_reported.map(lambda n:'neutral' if n else side)
        f['home_indicator']=f.neutral_reported.map(lambda n:.5 if n else float(side=='home'))
        f['row_key']=f.match_id+':'+side
        observations.append(f)
    goals=pd.concat(observations,ignore_index=True).sort_values(['team_id','venue','event_order_ts','match_id'],kind='stable')
    contexts=[];weighted=[];support=[]
    for (team,venue),group in goals.groupby(['team_id','venue'],sort=True):
        recent=len(group)>=policy['minimum_recent_matches']
        wp=(WeightingPolicy.recent_state_blend(policy['recent_n'],policy['alpha'],
               minimum_ess=policy['minimum_recent_ess'],recent_order_column='event_order_ts')
            if recent else WeightingPolicy.expanding_equal(minimum_ess=1))
        ctx=prepare_learning_context(group,cutoff,source_hashes={**bindings,
            'admission':stable_json_hash(admission.receipt.payload),'group':stable_json_hash([team,venue])},
            repository_root=root,implementation_modules=('beidan_backend.opponent_goals',),
            implementation_distributions=('pandas','numpy'),availability=availability,
            intended_use='HISTORICAL_DIAGNOSTIC',partition_policy=PartitionPolicy('FIXED_PRIOR_FIT',0,0,1),
            weighting_policy=wp)
        verify_learning_context(ctx,repository_root=root)
        fit=ctx.partitions['fit'].copy();ledger=ctx.weight_ledger
        fit['weight']=ledger.weight.to_numpy()
        fit['long_mass']=ledger.long_mass.to_numpy();fit['recent_mass']=ledger.recent_mass.to_numpy()
        weighted.append(fit)
        contexts.append(ctx)
        support.append(dict(team_id=team,venue=venue,matches=len(fit),recent_active=recent,
            ess=ctx.receipt.payload['weight_receipt']['effective_sample_size']))
    combined=pd.concat(weighted,ignore_index=True)
    ledgers=[dict(team_id=ctx.partitions['fit'].team_id.iloc[0],
        venue=ctx.partitions['fit'].venue.iloc[0],
        ledger=ctx.weight_ledger.assign(row_key=ctx.partitions['fit'].row_key.to_numpy())
          .to_json(orient='records',date_format='iso',double_precision=15)) for ctx in contexts]
    return dict(observations=combined[['row_key','match_id','event_date','team_id','opponent_id',
        'goals','against','competition_id','venue','home_indicator','weight','long_mass','recent_mass']].to_dict('records'),
        support=support,admission=admission,contexts=contexts,receipts=[c.receipt.payload for c in contexts],ledgers=ledgers,
        admitted_matches=len(unique),admitted_rows=len(prior),duplicates_removed=len(prior)-len(unique),
        policy=policy,cutoff=cutoff.cutoff_ts.isoformat())


def verify_opponent_preparation(prepared, fixture, cutoff, repository_root):
    """Independently bind exported domain observations to verified shared fits.

    Verifies all contexts with shared replay and reconciles the R boundary rows,
    venue support and full ledger exports. Mutated observations, wrong fixture,
    cutoff, receipts or R implementation fail. No fitting or side effects.
    """
    root=Path(repository_root)
    admission=verify_learning_context(prepared['admission'],repository_root=root)
    expected=admission.receipt.payload['source_hashes']
    if (not isinstance(cutoff,Cutoff) or admission.cutoff!=cutoff
            or prepared['cutoff']!=cutoff.cutoff_ts.isoformat()
            or expected.get('fixture')!=stable_json_hash(fixture)
            or expected.get('policy')!=stable_json_hash(prepared['policy'])
            or expected.get('R_fit')!=hashlib.sha256((root/'packages/beidan/R/opponent_goals.R').read_bytes()).hexdigest()):
        raise ValueError('Prepared fixture/cutoff/policy/implementation differs')
    rows=[];support=[];receipts=[];ledgers=[]
    for context in prepared['contexts']:
        verify_learning_context(context,repository_root=root)
        if context.cutoff!=cutoff or context.receipt.payload['source_hashes'].get('admission')!=stable_json_hash(admission.receipt.payload):
            raise ValueError('Group cutoff/admission differs')
        fit=context.partitions['fit'].copy();ledger=context.weight_ledger
        team=fit.team_id.iloc[0];venue=fit.venue.iloc[0]
        policy=prepared['policy']
        expected_weighting=(WeightingPolicy.recent_state_blend(policy['recent_n'],policy['alpha'],
            minimum_ess=policy['minimum_recent_ess'],recent_order_column='event_order_ts')
            if len(fit)>=policy['minimum_recent_matches'] else WeightingPolicy.expanding_equal(minimum_ess=1))
        if (context.receipt.payload['weight_receipt']['policy']!=asdict(expected_weighting)
                or context.receipt.payload['source_hashes'].get('group')!=stable_json_hash([team,venue])
                or context.receipt.payload['source_hashes'].get('fixture')!=expected['fixture']
                or not fit.team_id.eq(team).all() or not fit.venue.eq(venue).all()):
            raise ValueError('Group weighting policy or identity differs')
        fit['weight']=ledger.weight.to_numpy()
        fit['long_mass']=ledger.long_mass.to_numpy();fit['recent_mass']=ledger.recent_mass.to_numpy()
        rows.extend(fit[['row_key','match_id','event_date','team_id','opponent_id',
            'goals','against','competition_id','venue','home_indicator','weight','long_mass','recent_mass']].to_dict('records'))
        support.append(dict(team_id=team,venue=venue,matches=len(fit),
            recent_active=context.receipt.payload['weight_receipt']['policy']['kind']=='RECENT_STATE_BLEND',
            ess=context.receipt.payload['weight_receipt']['effective_sample_size']))
        receipts.append(context.receipt.payload)
        ledgers.append(dict(team_id=team,venue=venue,ledger=ledger.assign(row_key=fit.row_key.to_numpy()).to_json(orient='records',date_format='iso',double_precision=15)))
    if any(prepared[k]!=v for k,v in [('observations',rows),('support',support),('receipts',receipts),('ledgers',ledgers)]):
        raise ValueError('Exported opponent preparation differs from shared contexts')
    # An independently valid context must still describe the admitted football
    # facts, not fabricated rows with an unchanged source-binding string.
    prior=admission.partitions['fit']
    unique=prior[prior.competition_id.eq(fixture['competition_id'])].sort_values(
        ['match_id','row_key'],kind='stable').drop_duplicates('match_id')
    lookup=unique.set_index('match_id')
    factual_keys=[]
    for row in rows:
        side=row['row_key'].rsplit(':',1)[-1]
        if side not in ('home','away') or row['match_id'] not in lookup.index:
            raise ValueError('Group rows differ from admitted source facts')
        fact=lookup.loc[row['match_id']]
        opponent='away' if side=='home' else 'home'
        values=dict(match_id=str(fact.name),event_date=fact.event_date,team_id=fact[side+'_id'],
            opponent_id=fact[opponent+'_id'],goals=fact[side+'_score'],against=fact[opponent+'_score'],
            competition_id=fact.competition_id,venue='neutral' if fact.neutral_reported else side,
            home_indicator=.5 if fact.neutral_reported else float(side=='home'))
        if any(row[k]!=v for k,v in values.items()):
            raise ValueError('Group rows differ from admitted source facts')
        factual_keys.append(row['row_key'])
    expected_keys={m+':'+side for m in unique.match_id for side in ('home','away')}
    if len(factual_keys)!=len(expected_keys) or set(factual_keys)!=expected_keys:
        raise ValueError('Incomplete or duplicate admitted scoring groups')
    return prepared
"""Shared publication validation for serialized opponent-fit receipts."""
import hashlib
from io import StringIO
from pathlib import Path
import numpy as np
import pandas as pd
from .core import (Cutoff, TemporalContractError, utc, effective_sample_size,
    AvailabilityFilter,AvailabilityPolicy,WeightingPolicy,EffectiveSamplePolicy,_weight_ledger)
from .provenance import verify_implementation_closure


def validate_serialized_opponent_fit(fit, cutoff, repository_root):
    """Validate full diagnostic admission/group chronology and weight evidence.

    fit contains receipt, group receipts and original 15-digit JSON ledgers.
    cutoff is an explicit shared decision epoch. Source/label maxima must precede
    it; fixture IDs, code and cache identities must bind. This validates a frozen
    export, not a replacement for independent raw-input fitting replay. JSON
    rounding has a fixed 1e-10 mass tolerance; ESS uses the shared implementation.
    No fits, chronology inference, fetching or writes.
    """
    if not isinstance(cutoff,Cutoff) or cutoff.kind!='DECISION_EPOCH' or not isinstance(fit,dict):
        raise TemporalContractError('Explicit serialized fit and decision cutoff required')
    root=Path(repository_root);r=fit.get('receipt',{});admission=r.get('admission',{})
    if (r.get('cutoff')!=cutoff.identity or r.get('target_label_optimization')is not False
            or r.get('intended_use')!='HISTORICAL_DIAGNOSTIC'
            or r.get('fixture',{}).get('issue_id')!=cutoff.target_issue):
        raise TemporalContractError('Fitting cutoff, fixture or intended use differs')
    required={'cutoff_identity','cutoff_ts','target_issue','maximum_source_time',
              'maximum_training_label_timestamp','implementation','availability','cache_key'}
    groups=[admission,*fit.get('receipts',[])]
    if not fit.get('receipts') or len(fit.get('ledgers',[]))!=len(fit['receipts']):
        raise TemporalContractError('Complete group ledgers and receipts required')
    for group in groups:
        if not required<=set(group):raise TemporalContractError('Complete shared receipt required')
        if (group['cutoff_identity']!=cutoff.identity or utc(group['cutoff_ts'])!=cutoff.cutoff_ts
                or group['target_issue']!=cutoff.target_issue):
            raise TemporalContractError('Group cutoff differs')
        for field in ['maximum_source_time','maximum_training_label_timestamp']:
            if not utc(group[field])<cutoff.cutoff_ts:raise TemporalContractError('Group chronology crosses cutoff')
        availability=group['availability']
        if (availability.get('intended_use')!='HISTORICAL_DIAGNOSTIC'
                or availability.get('policy',{}).get('kind')!='HISTORICAL_PROXY'
                or availability['policy'].get('prospective_capable')is not False):
            raise TemporalContractError('Diagnostic proxy evidence required')
        if not isinstance(group['cache_key'],str) or len(group['cache_key'])!=64:
            raise TemporalContractError('Shared cutoff-bound cache identity required')
        verify_implementation_closure(root,group['implementation'])
    if r.get('R_code_sha256')!=hashlib.sha256((root/'packages/beidan/R/opponent_goals.R').read_bytes()).hexdigest():
        raise TemporalContractError('Fitted R implementation differs')
    binding=r.get('admission_binding')
    if not isinstance(binding,str) or len(binding)!=64:raise TemporalContractError('Exact group admission binding required')
    for group,export in zip(fit['receipts'],fit['ledgers'],strict=True):
        if group['source_hashes'].get('admission')!=binding:
            raise TemporalContractError('Group admission binding differs')
        if not isinstance(export.get('ledger'),str):raise TemporalContractError('Original JSON weight ledger required')
        ledger=pd.read_json(StringIO(export['ledger']),orient='records')
        needed={'row_key','long_mass','recent_mass','total_mass','weight','cutoff_identity','cutoff_ts','label_available_ts'}
        if ledger.empty or not needed<=set(ledger) or ledger[list(needed)].isna().any().any() or ledger.row_key.duplicated().any():
            raise TemporalContractError('Complete keyed weight ledger required')
        if not ledger.cutoff_identity.eq(cutoff.identity).all():raise TemporalContractError('Ledger cutoff identity differs')
        if any(utc(value)!=cutoff.cutoff_ts for value in ledger.cutoff_ts):raise TemporalContractError('Ledger cutoff time differs')
        if any(not utc(value)<cutoff.cutoff_ts for value in ledger.label_available_ts):raise TemporalContractError('Ledger label chronology crosses cutoff')
        numeric=ledger[['long_mass','recent_mass','total_mass','weight']].to_numpy(float)
        if not np.isfinite(numeric).all() or (numeric<0).any() or (ledger.weight<=0).any():
            raise TemporalContractError('Finite positive weight ledger required')
        if (abs(ledger.total_mass.sum()-1)>1e-10
                or np.max(np.abs(ledger.long_mass+ledger.recent_mass-ledger.total_mass))>1e-10
                or np.max(np.abs(ledger.total_mass*len(ledger)-ledger.weight))>1e-10):
            raise TemporalContractError('Ledger component masses differ')
        weights=group['weight_receipt'];policy=weights['policy']
        wp=dict(policy);wp['effective_sample']=EffectiveSamplePolicy(**wp['effective_sample'])
        availability=group['availability']
        af=AvailabilityFilter(AvailabilityPolicy(**availability['policy']),
            label_available_column=availability['label_available_column'],
            data_available_column=availability['data_available_column'])
        history=ledger.copy()
        for column in set([af.label_available_column,wp.get('recent_order_column')])-{None}:
            history[column]=pd.to_datetime(history[column],utc=True,errors='raise')
        rebuilt=_weight_ledger(history,cutoff,af,WeightingPolicy(**wp))
        for column in ['long_mass','recent_mass','total_mass','weight']:
            if np.max(np.abs(ledger[column].to_numpy(float)-rebuilt[column].to_numpy(float)))>1e-10:
                raise TemporalContractError('Ledger differs from independently rebuilt shared weights')
        if (len(ledger)!=weights['rows'] or abs(ledger.long_mass.sum()-weights['long_history_mass'])>1e-10
                or abs(ledger.recent_mass.sum()-weights['recent_state_mass'])>1e-10
                or abs(effective_sample_size(ledger.weight.to_numpy(float))-weights['effective_sample_size'])>1e-8):
            raise TemporalContractError('Ledger mass/ESS receipt differs')
        if policy['kind']=='RECENT_STATE_BLEND' and (abs(ledger.recent_mass.sum()-policy['recent_blend'])>1e-10
                or abs(ledger.long_mass.sum()-(1-policy['recent_blend']))>1e-10):
            raise TemporalContractError('Recent/long normalized blend differs')
        if effective_sample_size(ledger.weight.to_numpy(float))+1e-8<policy['effective_sample']['minimum']:
            raise TemporalContractError('Ledger effective sample floor not met')

