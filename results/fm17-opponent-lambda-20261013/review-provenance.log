"""Offline competition/venue metadata beside the verified factual history.

This module does not admit rows, infer availability, fit, fetch or write. Source
IDs are preserved; neutral markers mean source-reported neutral, not proof of
non-neutrality when absent. Existing analysis_record owns identity/score parsing.
"""
import re
from bs4 import BeautifulSoup
from .fundamentals import analysis_record, plain_text


def parse_opponent_history(raw, *, source, provider_id, expected_identity,
                           auxiliary_raw=None):
    """Return competition metadata and factual keys from a bound analysis page.

    raw/auxiliary_raw are original UTF-8 bytes. expected_identity is the existing
    six-field oriented fixture identity. Historical competition ID/name come
    from positions 1/2 of validated source arrays; never from team name guesses.
    Invalid IDs fail; empty rendered names remain None with an explicit state.
    Published empty arrays remain empty. Target
    competition is the unique history ID matching the explicit title league;
    absent/ambiguous matching yields None, not a guessed league. No side effects.
    """
    if not isinstance(raw, bytes) or not isinstance(expected_identity, dict):
        raise ValueError('Original bytes and explicit fixture identity required')
    record = analysis_record(raw, source=source, provider_id=provider_id,
                             expected_identity=expected_identity,
                             auxiliary_raw=auxiliary_raw)
    for key in ('provider_id', 'home_id', 'away_id', 'kickoff_utc'):
        if record[key] != expected_identity[key]:
            raise ValueError('Bound analysis identity differs: ' + key)
    soup = BeautifulSoup(raw.decode('utf-8-sig'), 'html.parser')
    match = re.search(r'赛季([^()（）]+)[)）]', soup.title.get_text())
    target_name = match[1].strip() if match else None
    rows = []
    for factual in record['history']:
        original = record['blocks'][factual['block']][factual['ordinal']]
        if (type(original[1]) is not int or original[1] <= 0
                or not isinstance(original[2], str)):
            raise ValueError('Positive competition ID and textual name field required')
        name=plain_text(original[2]) or None
        rows.append({**factual, 'competition_id': str(original[1]),
                     'competition_name': name,
                     'competition_name_state':'PUBLISHED_NAME' if name else 'EMPTY_RENDERED_NAME',
                     'neutral_reported': '(中)' in factual['home_text']
                         or '(中)' in factual['away_text']})
    ids = sorted({r['competition_id'] for r in rows
                  if target_name is not None and r['competition_name'] == target_name})
    # First oriented team link belongs to the match header in these templates.
    home_links=[a for a in soup.select('a[href]') if re.search(
        r'/team/(?:Summary/)?'+re.escape(record['home_id'])+r'\.html?(?:[?#].*)?$',
        a['href'],flags=re.I)]
    target_neutral=bool(home_links and '(中)' in home_links[0].get_text())
    return dict(identity={k: record[k] for k in expected_identity}, rows=rows,
                target_competition_name=target_name,
                target_competition_id=ids[0] if len(ids) == 1 else None,
                target_neutral_reported=target_neutral,
                target_venue_evidence='SOURCE_HEADER_NEUTRAL_MARKER' if target_neutral else 'NEUTRALITY_NOT_REPORTED',
                target_competition_state='MATCHED_TITLE_HISTORY' if len(ids) == 1
                    else 'ABSENT_OR_AMBIGUOUS_TITLE_HISTORY')
"""Pure independently parsed issue identity inventory; no learning or I/O."""
import re
from urllib.parse import urlsplit, parse_qs
from bs4 import BeautifulSoup
from .issue_schedule.decode import decode_response
from .issue_schedule.sources import parse_nowscore_rows


def parse_exclusion_roster(raw, *, source_url, observed_at, content_type):
    """Read the provider's actual selector universe and native roster identities.

    Returns selected issue, all declared issue IDs and issue/slot/native-ID rows.
    Existing source parser validates row identities. No numerical issue ranges
    are invented: unlisted codes do not imply officially nonexistent issues.
    No labels are returned or used, and there is no fitting, fetching or write.
    """
    url=urlsplit(source_url);query=parse_qs(url.query)
    if (url.scheme!='https' or url.hostname!='cp.nowscore.com' or url.path!='/buy/DanChang.aspx'
            or query.get('TypeID')!=['5'] or query.get('all')!=['1']):
        raise ValueError('Explicit full SPF provider URL required')
    text=decode_response(raw,content_type)
    soup=BeautifulSoup(text,'html.parser')
    select=soup.select_one('#dropIssueNum')
    if select is None:raise ValueError('Provider issue selector required')
    options=select.select('option')
    issues=[o.get('value') for o in options]
    selected=[o.get('value') for o in options if o.has_attr('selected')]
    if (len(selected)!=1 or len(issues)!=len(set(issues))
            or not all(isinstance(i,str) and re.fullmatch(r'\d{5,6}',i) for i in issues)):
        raise ValueError('Unique actual selected issue and declared issue IDs required')
    if 'issueNum' in query and query['issueNum']!=selected:
        raise ValueError('Requested and selected source issue differ')
    rows=parse_nowscore_rows(text,issue_id=selected[0],observed_at=observed_at,source_url=source_url)
    roster=[dict(issue_id=selected[0],slot=r.slot,provider_id=r.provider_match_id) for r in rows]
    if not roster or len({r['provider_id'] for r in roster})!=len(roster):
        raise ValueError('Complete unique nonempty source roster required')
    return dict(selected_issue=selected[0],declared_issues=issues,roster=roster)
"""One immutable NAS dataset for the bounded opponent-lambda diagnostic."""
import hashlib
import json
import os
from pathlib import Path
import pandas as pd
import numpy as np
import pyarrow as pa
from filelock import FileLock
from .catalog import paths, registry
from . import versioning
from .settlement_backfill import write_parquet_atomically
from .temporal_learning import Cutoff
from .temporal_learning.serialized_opponent_fit import validate_serialized_opponent_fit
from .temporal_learning.provenance import verify_implementation_closure

KEYS={'audit':['fixture_id'],'probabilities':['fixture_id','model','outcome'],
      'metrics':['cohort','issue_id','comparison','model'],
      'lambdas':['fixture_id'],'margins':['fixture_id','model','stage','margin'],
      'coefficients':['fixture_id','term'],'observations':['fixture_id','row_key'],
      'support':['fixture_id','team_id','venue'],'snapshots':['snapshot_id']}


def publish_opponent_research(tables, receipt, label, *, environ, repository_root):
    """Publish typed diagnostic tables and complete fitting/cutoff evidence.

    Tables are explicit Arrow objects keyed as KEYS. Audit lists every attempted
    native fixture with a UTC cutoff; lambdas/probabilities/observations etc.
    contain only successfully estimated fixtures. Receipt binds input/code
    hashes, independent replay, fitting receipts and full shared weight ledgers.
    Historical proxies cannot authorize prospective use. Uses existing atomic
    writers, catalog roots, shared publication lock and publish_version().
    Same label cannot change content/bindings. On a failure the prior catalog
    and current pointer are restored; rejected versions remain inventoried.
    No fetching, fitting or selection. Empty/malformed inputs fail closed.
    """
    root=Path(repository_root)
    if (set(tables)!=set(KEYS) or not isinstance(receipt,dict)
            or receipt.get('intended_use')!='POSTHOC_HISTORICAL_DIAGNOSTIC'
            or receipt.get('formal_FM_unchanged')is not True):
        raise ValueError('Complete diagnostic tables and unchanged formal FM required')
    for key in ['input_hashes','implementation_hashes']:
        if not receipt.get(key) or not all(isinstance(v,str) and len(v)==64 and
            all(c in '0123456789abcdef' for c in v) for v in receipt[key].values()):
            raise ValueError('Complete SHA256 input and code identities required')
    if (receipt.get('independent_replay',{}).get('status')!='FULL_IDENTICAL_REPLAY'
            or receipt['independent_replay'].get('sha256')!=receipt['input_hashes'].get('forecasts')):
        raise ValueError('Independent exact forecast replay required')
    if not receipt.get('publication_implementation'):raise ValueError('Transitive publication implementation required')
    verify_implementation_closure(root,receipt['publication_implementation'])
    frames={}
    for name,table in tables.items():
        if not isinstance(table,pa.Table) or not set(KEYS[name])<=set(table.column_names):
            raise ValueError('Arrow tables and complete keys required')
        frame=table.to_pandas()
        if frame.empty or frame[KEYS[name]].isna().any().any() or frame.duplicated(KEYS[name]).any():
            raise ValueError('Nonempty unique non-null table keys required: '+name)
        for column in set(KEYS[name])&{'fixture_id','model','outcome','issue_id','team_id','row_key'}:
            if not (pa.types.is_string(table.schema.field(column).type) or pa.types.is_large_string(table.schema.field(column).type)):
                raise ValueError('Character identity types required')
        frames[name]=frame
    audit=frames['audit'];estimated=set(audit.fixture_id[audit.state.eq('ESTIMATED')])
    snapshots=frames['snapshots']
    if not {'snapshot_id','payload','sha256'}<=set(snapshots):raise ValueError('Complete replay snapshot payloads required')
    for row in snapshots.itertuples():
        if not isinstance(row.payload,str) or hashlib.sha256(row.payload.encode('utf-8')).hexdigest()!=row.sha256:
            raise ValueError('Replay snapshot payload digest differs')
    if (not estimated or set(frames['lambdas'].fixture_id)!=estimated
            or set(receipt.get('fits',{}))!=estimated or set(receipt.get('cutoffs',{}))!=set(audit.fixture_id)):
        raise ValueError('Exact audit, estimate, fitting receipt and cutoff scopes required')
    if (not pa.types.is_timestamp(tables['audit'].schema.field('cutoff_utc').type)
            or tables['audit'].schema.field('cutoff_utc').type.tz!='UTC' or audit.cutoff_utc.isna().any()):
        raise ValueError('Typed UTC fixture cutoffs required')
    for row in audit.itertuples():
        cutoff=Cutoff.decision_epoch(row.fixture_id.split(':')[0],receipt['cutoffs'][row.fixture_id])
        if row.cutoff_utc!=cutoff.cutoff_ts:raise ValueError('Audit cutoff differs from receipt')
        if row.fixture_id not in estimated:continue
        validate_serialized_opponent_fit(receipt['fits'][row.fixture_id],cutoff,root)
    for name in ['probabilities','margins','coefficients','observations','support']:
        if not set(frames[name].fixture_id)<=estimated:raise ValueError('Unestimated or foreign fixture in model tables')
    for name in ['probabilities','margins']:
        f=frames[name]
        if (not f.probability.between(0,1).all() or f.probability.isna().any()):raise ValueError('Finite probability masses required')
        group=['fixture_id','model']+(['stage'] if name=='margins' else [])
        if not f.groupby(group).probability.sum().sub(1).abs().lt(1e-8).all():raise ValueError('Normalized probability triples/grids required')
        if name=='probabilities' and (not f.outcome.isin(['W','D','L']).all() or not f.groupby(group).size().eq(3).all()):
            raise ValueError('Complete W/D/L probability triples required')
    for column in ['lambda_home','lambda_away']:
        if not frames['lambdas'][column].gt(0).all() or not np.isfinite(frames['lambdas'][column]).all():raise ValueError('Positive finite goal means required')
    base=paths.dataset_path('fm17_opponent_research',require_exists=False,environ=environ)
    paths.root_path('hot',environ=environ)
    binding=hashlib.sha256(json.dumps(receipt,sort_keys=True,separators=(',',':')).encode()).hexdigest()
    destination=versioning.version_directory(base,label)
    with FileLock(paths.catalog_root(environ=environ)/'source-issue-publication.lock',timeout=30):
        catalog=registry.load_catalog(environ=environ);old_catalog=json.loads(json.dumps(catalog))
        previous=versioning.read_current(base)
        if destination.exists() and json.loads((destination/'receipt.json').read_bytes())!=receipt:
            raise versioning.VersionError('Published fitting receipt identity differs')
        def write(directory):
            entries={}
            for name,table in tables.items():
                path=directory/'tables'/(name+'.parquet');result=write_parquet_atomically(table,path)
                entries[name]=dict(kind='whole',rows=result['rows'],files=[dict(name=path.name,rows=result['rows'],sha256=result['sha256'])])
            versioning.write_json_atomically(dict(version=label,tables=entries,source=receipt),directory/'manifest.json')
            versioning.write_json_atomically(receipt,directory/'receipt.json')
            return dict(binding_sha256=binding)
        published=False
        try:
            result=versioning.publish_version(base,label,write);published=result['status']=='published'
            schema_id='fm17_opponent_research_v1'
            versioning.write_json_atomically(dict(schema_id=schema_id,keys=KEYS,
                tables={k:{f.name:str(f.type) for f in t.schema} for k,t in tables.items()},
                nullable='Audit lambda/metadata columns null for unestimated fixtures; all model probability keys and values nonnull.',
                intended_use='POSTHOC_HISTORICAL_DIAGNOSTIC'),paths.schema_path(schema_id,require_exists=False,environ=environ))
            catalog['datasets']['fm17_opponent_research']=dict(kind='dataset',format='parquet',
                location='frozen:datasets/fm17_opponent_research',schema_id=schema_id,
                version=result['current']['label_version'],owner='research:fm17-opponent-lambda',retention='retained',tables=len(tables))
            versioning.write_json_atomically(catalog,registry.catalog_path(environ=environ))
        except BaseException:
            if published:
                if registry.load_catalog(environ=environ)!=old_catalog:
                    versioning.write_json_atomically(old_catalog,registry.catalog_path(environ=environ))
                if previous is None:(base/'current.json').unlink(missing_ok=True)
                else:versioning.write_json_atomically(previous,base/'current.json')
                os.replace(destination,base/('.failed-'+label))
            raise
    return dict(dataset='fm17_opponent_research',version=result['current']['label_version'],
                status=result['status'],binding_sha256=binding)
"""Bounded offline metadata replay; no source replacement or temporal learning."""
import argparse
import hashlib
import json
from pathlib import Path
import sqlite3
from beidan_backend.catalog.paths import location
from beidan_backend.opponent_history import parse_opponent_history
from beidan_backend.versioning import write_json_atomically


if __name__ == '__main__':
    parser=argparse.ArgumentParser()
    parser.add_argument('--input',required=True);parser.add_argument('--output',required=True)
    parser.add_argument('--fixture',action='append',help='Bounded fixture selection for deterministic integration tests')
    args=parser.parse_args()
    inp=Path(args.input);out=Path(args.output);out.mkdir(parents=True,exist_ok=True)
    inputs=json.loads(inp.read_bytes())
    fixtures={f['fixture_id']:f for f in inputs['fixtures']}
    if args.fixture:
        if not set(args.fixture)<=set(fixtures):raise ValueError('Unknown requested fixture')
        fixtures={k:v for k,v in fixtures.items() if k in args.fixture}
    # One stable read transaction; never initialize, refresh or mutate this cache.
    with sqlite3.connect(f"file:{location('hot:source-extraction/raw.sqlite')}?mode=ro",uri=True) as con:
        con.execute('BEGIN')
        rows=con.execute('select source,url,observed_at,sha256,body from captures').fetchall()
    captures={}
    for source,url,at,sha,body in rows:
        if hashlib.sha256(body).hexdigest()!=sha:raise ValueError('Raw capture digest mismatch')
        captures[(source,url,sha)]=(body,at)
    parsed=[];ledger=[]
    for fid,f in fixtures.items():
        evidence=[p for p in inputs['provenance'] if p['fixture_id']==fid]
        for source in ('titan','nowscore'):
            ps=[p for p in evidence if p['source']==source and '/analysis/' in p['url']]
            if len(ps)!=1:continue
            p=ps[0];capture=captures.get((source,p['url'],p['sha256']))
            state=dict(fixture_id=fid,source=source,url=p['url'],sha256=p['sha256'],observed_at=p['observed_at'])
            if not f['kickoff_utc']:
                ledger.append({**state,'state':'MISSING_FROZEN_CLOCK','error':''});continue
            if capture is None:
                ledger.append({**state,'state':'RAW_NOT_IN_CACHE','error':''});continue
            body,at=capture
            aux=[q for q in evidence if q['source']==source and 'analysisJs/' in q['url']]
            auxbody=None;auxsha=None
            if aux:
                if len(aux)!=1:raise ValueError('Ambiguous auxiliary provenance')
                a=aux[0];ac=captures.get((source,a['url'],a['sha256']))
                if ac is None:
                    ledger.append({**state,'state':'AUXILIARY_NOT_IN_CACHE','error':''});continue
                auxbody=ac[0];auxsha=a['sha256']
            identity={k:f[k] for k in ('provider_id','home','away','home_id','away_id','kickoff_utc')}
            # Existing source parser returns canonical ISO with +00:00.
            identity['kickoff_utc']=identity['kickoff_utc'].replace('Z','+00:00')
            try:
                result=parse_opponent_history(body,source=source,provider_id=f['provider_id'],
                    expected_identity=identity,auxiliary_raw=auxbody)
            except ValueError as error:
                ledger.append({**state,'state':'PARSER_OR_IDENTITY_REJECTED','error':str(error)});continue
            # Preserve original bytes in short-lived declared NVMe evidence.
            writepath=out/'raw'/f"{p['sha256']}.html";writepath.parent.mkdir(exist_ok=True)
            if not writepath.exists():writepath.write_bytes(body)
            if auxbody is not None:
                ap=out/'raw'/f'{auxsha}.js'
                if not ap.exists():ap.write_bytes(auxbody)
            parsed.append({**state,'auxiliary_sha256':auxsha,'result':result})
            ledger.append({**state,'state':'PARSED','error':''})
    result=dict(input_sha256=hashlib.sha256(inp.read_bytes()).hexdigest(),parsed=parsed,ledger=ledger,
        parser_sha256=hashlib.sha256(Path('packages/beidan/inst/python/beidan_backend/opponent_history.py').read_bytes()).hexdigest(),
        source_parser_sha256=hashlib.sha256(Path('packages/beidan/inst/python/beidan_backend/fundamentals.py').read_bytes()).hexdigest(),
        client_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),availability='HISTORICAL_PROXY',network_attempts=0)
    target=out/'metadata.json'
    if target.exists():
        if json.loads(target.read_bytes())!=result:raise ValueError('Immutable replay differs')
    else:write_json_atomically(result,target)
    print(json.dumps(dict(parsed=len(parsed),states={s:sum(l['state']==s for l in ledger) for s in sorted({l['state'] for l in ledger})})))
"""Independent provider-listed roster inventory for exact future-ID exclusion."""
import argparse
import hashlib
import json
from pathlib import Path
import sqlite3
from beidan_backend.catalog.paths import location
from beidan_backend.opponent_roster import parse_exclusion_roster
from beidan_backend.versioning import write_json_atomically
from beidan_backend.temporal_learning.provenance import implementation_closure


if __name__=='__main__':
    parser=argparse.ArgumentParser();parser.add_argument('--output',required=True)
    args=parser.parse_args();out=Path(args.output);out.mkdir(parents=True,exist_ok=True)
    with sqlite3.connect(f"file:{location('hot:source-extraction/raw.sqlite')}?mode=ro",uri=True) as con:
        rows=con.execute("select capture_id,source,url,observed_at,sha256,body,content_type from captures where url like '%/buy/DanChang.aspx%' order by capture_id").fetchall()
    packets=[];ledger=[]
    for cid,source,url,at,sha,body,ctype in rows:
        if source!='nowscore':continue
        if hashlib.sha256(body).hexdigest()!=sha:raise ValueError('Exclusion roster raw digest mismatch')
        receipt=dict(capture_id=cid,url=url,observed_at=at,sha256=sha,content_type=ctype)
        try:packet=parse_exclusion_roster(body,source_url=url,observed_at=at,content_type=ctype)
        except ValueError as e:
            ledger.append({**receipt,'state':'REJECTED','error':str(e)});continue
        packets.append({**receipt,**packet});ledger.append({**receipt,'state':'PARSED','error':''})
        p=out/'raw'/f'{sha}.html';p.parent.mkdir(exist_ok=True)
        if not p.exists():p.write_bytes(body)
    if not packets:raise ValueError('No independently parsed roster inventory')
    result=dict(packets=packets,ledger=ledger,network_attempts=0,
        availability='HISTORICAL_IDENTITY_EXCLUSION_ONLY',
        implementation=implementation_closure(Path.cwd(),('beidan_backend.opponent_roster',),distributions=('beautifulsoup4',)),
        parser_sha256=hashlib.sha256(Path('packages/beidan/inst/python/beidan_backend/opponent_roster.py').read_bytes()).hexdigest(),
        client_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest())
    path=out/'rosters.json'
    if path.exists():
        if json.loads(path.read_bytes())!=result:raise ValueError('Immutable exclusion roster replay differs')
    else:write_json_atomically(result,path)
    print(json.dumps(dict(packets=len(packets),selected_issues=sorted({p['selected_issue'] for p in packets}))))
"""Thin explicit staging-to-catalog client, with verified local input hashes."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import pyarrow.parquet as pq
from beidan_backend.opponent_publication import publish_opponent_research
from beidan_backend.versioning import write_json_atomically
from beidan_backend.temporal_learning.provenance import implementation_closure


if __name__=='__main__':
    parser=argparse.ArgumentParser();parser.add_argument('--staging',required=True)
    parser.add_argument('--label',required=True);parser.add_argument('--output',required=True)
    args=parser.parse_args();staging=Path(args.staging)
    manifest=json.loads((staging/'manifest.json').read_bytes())
    if hashlib.sha256((staging/'receipt.json').read_bytes()).hexdigest()!=manifest['receipt_sha256']:
        raise ValueError('Staging receipt digest differs')
    tables={}
    for name,sha in manifest['tables'].items():
        p=staging/(name+'.parquet')
        if hashlib.sha256(p.read_bytes()).hexdigest()!=sha:raise ValueError('Staging table digest differs')
        tables[name]=pq.read_table(p)  # Declared local NVMe staging, never NAS reads.
    receipt=json.loads((staging/'receipt.json').read_bytes())
    receipt['publication_implementation']=implementation_closure(Path.cwd(),('beidan_backend.opponent_publication',),
        distributions=('pyarrow','pandas','numpy','filelock'))
    receipt['publication_client_sha256']=hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    result=publish_opponent_research(tables,receipt,args.label,environ=dict(os.environ),repository_root=Path.cwd())
    write_json_atomically(result,Path(args.output));print(json.dumps(result))

