  jsonlite::write_json(list(status="FULL_IDENTICAL_REPLAY",forecasts=length(entries),sha256=digest::digest(file=path,algo="sha256")),file.path(out,"replay.json"),pretty=TRUE,auto_unbox=TRUE)
