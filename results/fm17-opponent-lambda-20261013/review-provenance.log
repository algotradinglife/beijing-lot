"""Bounded offline metadata replay; no source replacement or temporal learning."""
import argparse
import hashlib
import json
from pathlib import Path
import sqlite3
from beidan_backend.catalog.paths import location
from beidan_backend.opponent_history import parse_opponent_history
from beidan_backend.versioning import write_json_atomically


if __name__ == '__main__':
    parser=argparse.ArgumentParser()
    parser.add_argument('--input',required=True);parser.add_argument('--output',required=True)
    parser.add_argument('--fixture',action='append',help='Bounded fixture selection for deterministic integration tests')
    args=parser.parse_args()
    inp=Path(args.input);out=Path(args.output);out.mkdir(parents=True,exist_ok=True)
    inputs=json.loads(inp.read_bytes())
    fixtures={f['fixture_id']:f for f in inputs['fixtures']}
    if args.fixture:
        if not set(args.fixture)<=set(fixtures):raise ValueError('Unknown requested fixture')
        fixtures={k:v for k,v in fixtures.items() if k in args.fixture}
    # One stable read transaction; never initialize, refresh or mutate this cache.
    with sqlite3.connect(f"file:{location('hot:source-extraction/raw.sqlite')}?mode=ro",uri=True) as con:
        con.execute('BEGIN')
        rows=con.execute('select source,url,observed_at,sha256,body from captures').fetchall()
    captures={}
    for source,url,at,sha,body in rows:
        if hashlib.sha256(body).hexdigest()!=sha:raise ValueError('Raw capture digest mismatch')
        captures[(source,url,sha)]=(body,at)
    parsed=[];ledger=[]
    for fid,f in fixtures.items():
        evidence=[p for p in inputs['provenance'] if p['fixture_id']==fid]
        for source in ('titan','nowscore'):
            ps=[p for p in evidence if p['source']==source and '/analysis/' in p['url']]
            if len(ps)!=1:continue
            p=ps[0];capture=captures.get((source,p['url'],p['sha256']))
            state=dict(fixture_id=fid,source=source,url=p['url'],sha256=p['sha256'],observed_at=p['observed_at'])
            if not f['kickoff_utc']:
                ledger.append({**state,'state':'MISSING_FROZEN_CLOCK','error':''});continue
            if capture is None:
                ledger.append({**state,'state':'RAW_NOT_IN_CACHE','error':''});continue
            body,at=capture
            aux=[q for q in evidence if q['source']==source and 'analysisJs/' in q['url']]
            auxbody=None;auxsha=None
            if aux:
                if len(aux)!=1:raise ValueError('Ambiguous auxiliary provenance')
                a=aux[0];ac=captures.get((source,a['url'],a['sha256']))
                if ac is None:
                    ledger.append({**state,'state':'AUXILIARY_NOT_IN_CACHE','error':''});continue
                auxbody=ac[0];auxsha=a['sha256']
            identity={k:f[k] for k in ('provider_id','home','away','home_id','away_id','kickoff_utc')}
            # Existing source parser returns canonical ISO with +00:00.
            identity['kickoff_utc']=identity['kickoff_utc'].replace('Z','+00:00')
            try:
                result=parse_opponent_history(body,source=source,provider_id=f['provider_id'],
                    expected_identity=identity,auxiliary_raw=auxbody)
            except ValueError as error:
                ledger.append({**state,'state':'PARSER_OR_IDENTITY_REJECTED','error':str(error)});continue
            # Preserve original bytes in short-lived declared NVMe evidence.
            writepath=out/'raw'/f"{p['sha256']}.html";writepath.parent.mkdir(exist_ok=True)
            if not writepath.exists():writepath.write_bytes(body)
            if auxbody is not None:
                ap=out/'raw'/f'{auxsha}.js'
                if not ap.exists():ap.write_bytes(auxbody)
            parsed.append({**state,'auxiliary_sha256':auxsha,'result':result})
            ledger.append({**state,'state':'PARSED','error':''})
    result=dict(input_sha256=hashlib.sha256(inp.read_bytes()).hexdigest(),parsed=parsed,ledger=ledger,
        parser_sha256=hashlib.sha256(Path('packages/beidan/inst/python/beidan_backend/opponent_history.py').read_bytes()).hexdigest(),
        source_parser_sha256=hashlib.sha256(Path('packages/beidan/inst/python/beidan_backend/fundamentals.py').read_bytes()).hexdigest(),
        client_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),availability='HISTORICAL_PROXY',network_attempts=0)
    target=out/'metadata.json'
    if target.exists():
        if json.loads(target.read_bytes())!=result:raise ValueError('Immutable replay differs')
    else:write_json_atomically(result,target)
    print(json.dumps(dict(parsed=len(parsed),states={s:sum(l['state']==s for l in ledger) for s in sorted({l['state'] for l in ledger})})))
"""Independent provider-listed roster inventory for exact future-ID exclusion."""
import argparse
import hashlib
import json
from pathlib import Path
import sqlite3
from beidan_backend.catalog.paths import location
from beidan_backend.opponent_roster import parse_exclusion_roster
from beidan_backend.versioning import write_json_atomically
from beidan_backend.temporal_learning.provenance import implementation_closure


if __name__=='__main__':
    parser=argparse.ArgumentParser();parser.add_argument('--output',required=True)
    args=parser.parse_args();out=Path(args.output);out.mkdir(parents=True,exist_ok=True)
    with sqlite3.connect(f"file:{location('hot:source-extraction/raw.sqlite')}?mode=ro",uri=True) as con:
        rows=con.execute("select capture_id,source,url,observed_at,sha256,body,content_type from captures where url like '%/buy/DanChang.aspx%' order by capture_id").fetchall()
    packets=[];ledger=[]
    for cid,source,url,at,sha,body,ctype in rows:
        if source!='nowscore':continue
        if hashlib.sha256(body).hexdigest()!=sha:raise ValueError('Exclusion roster raw digest mismatch')
        receipt=dict(capture_id=cid,url=url,observed_at=at,sha256=sha,content_type=ctype)
        try:packet=parse_exclusion_roster(body,source_url=url,observed_at=at,content_type=ctype)
        except ValueError as e:
            ledger.append({**receipt,'state':'REJECTED','error':str(e)});continue
        packets.append({**receipt,**packet});ledger.append({**receipt,'state':'PARSED','error':''})
        p=out/'raw'/f'{sha}.html';p.parent.mkdir(exist_ok=True)
        if not p.exists():p.write_bytes(body)
    if not packets:raise ValueError('No independently parsed roster inventory')
    result=dict(packets=packets,ledger=ledger,network_attempts=0,
        availability='HISTORICAL_IDENTITY_EXCLUSION_ONLY',
        implementation=implementation_closure(Path.cwd(),('beidan_backend.opponent_roster',),distributions=('beautifulsoup4',)),
        parser_sha256=hashlib.sha256(Path('packages/beidan/inst/python/beidan_backend/opponent_roster.py').read_bytes()).hexdigest(),
        client_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest())
    path=out/'rosters.json'
    if path.exists():
        if json.loads(path.read_bytes())!=result:raise ValueError('Immutable exclusion roster replay differs')
    else:write_json_atomically(result,path)
    print(json.dumps(dict(packets=len(packets),selected_issues=sorted({p['selected_issue'] for p in packets}))))
"""Immutable NAS lifecycle and typed contracts, with isolated catalog roots."""
from copy import deepcopy
import hashlib
from datetime import datetime,timezone
import json
from pathlib import Path
import pyarrow as pa
import pytest
from beidan_backend import versioning
from beidan_backend.opponent_publication import publish_opponent_research
from beidan_backend.temporal_learning.provenance import implementation_closure
from test_serialized_opponent_fit import fitted,ROOT


@pytest.fixture
def publication(fitted,tmp_path):
    fit,cutoff=fitted
    frozen=tmp_path/'frozen';hot=tmp_path/'hot';hot.mkdir();(frozen/'registry').mkdir(parents=True);(frozen/'schemas').mkdir()
    versioning.write_json_atomically(dict(schema='beijing_lot_catalog_v1',datasets={}),frozen/'registry/catalog.json')
    f='26102:6';ct=datetime(2020,2,1,tzinfo=timezone.utc)
    tables=dict(audit=pa.table(dict(fixture_id=[f],state=['ESTIMATED'],cutoff_utc=[ct])),
        probabilities=pa.table(dict(fixture_id=[f]*3,model=['OPPONENT_NATIVE']*3,outcome=['W','D','L'],probability=[.5,.3,.2])),
        metrics=pa.table(dict(cohort=['ESTIMATED_PAIRED'],issue_id=['ALL'],comparison=['model_only'],model=['OPPONENT_NATIVE'],n=[1])),
        lambdas=pa.table(dict(fixture_id=[f],lambda_home=[2.],lambda_away=[1.])),
        margins=pa.table(dict(fixture_id=[f]*3,model=['OPPONENT_NATIVE']*3,stage=['base']*3,margin=[-1,0,1],probability=[.2,.3,.5])),
        coefficients=pa.table(dict(fixture_id=[f],term=['Intercept'],value=[.1])),
        observations=pa.table(dict(fixture_id=[f],row_key=['m1:home'],goals=[2])),
        support=pa.table(dict(fixture_id=[f],team_id=['A'],venue=['home'],matches=[12])),
        snapshots=pa.table(dict(snapshot_id=['inputs'],payload=['{}'],sha256=[hashlib.sha256(b'{}').hexdigest()])))
    receipt=dict(intended_use='POSTHOC_HISTORICAL_DIAGNOSTIC',formal_FM_unchanged=True,
        input_hashes={'forecasts':'a'*64},implementation_hashes={'code':'b'*64},
        independent_replay=dict(status='FULL_IDENTICAL_REPLAY',sha256='a'*64),
        publication_implementation=implementation_closure(ROOT,('beidan_backend.opponent_publication',),distributions=('pyarrow','pandas','numpy','filelock')),
        fits={f:fit},cutoffs={f:ct.isoformat()})
    return tables,receipt,{'BEIDAN_PARQUET_ROOT':str(frozen),'BEIDAN_HOT_ROOT':str(hot)}


def test_publishes_and_same_label_is_immutable(publication):
    tables,receipt,env=publication
    first=publish_opponent_research(tables,receipt,'20261013-v1',environ=env,repository_root=ROOT)
    assert first['status']=='published'
    assert publish_opponent_research(tables,receipt,'20261013-v1',environ=env,repository_root=ROOT)['status']=='unchanged'
    altered=deepcopy(receipt);altered['implementation_hashes']['code']='c'*64
    with pytest.raises(versioning.VersionError):publish_opponent_research(tables,altered,'20261013-v1',environ=env,repository_root=ROOT)
    changed=tables.copy();changed['probabilities']=tables['probabilities'].set_column(3,'probability',pa.array([.6,.2,.2]))
    with pytest.raises(versioning.VersionError):publish_opponent_research(changed,receipt,'20261013-v1',environ=env,repository_root=ROOT)
    manifest=json.loads((Path(env['BEIDAN_PARQUET_ROOT'])/'datasets/fm17_opponent_research/versions/20261013-v1/manifest.json').read_bytes())
    assert set(manifest['tables'])==set(tables)


@pytest.mark.parametrize('change',['cutoff','cutoff_array','foreign','duplicate','mass','missing_fit','no_replay','infinite_lambda','snapshot'])
def test_invalid_publication_fails_closed(publication,change):
    tables,receipt,env=publication;tables=tables.copy();receipt=deepcopy(receipt)
    if change=='cutoff':receipt['cutoffs']['26102:6']='2020-02-02T00:00:00Z'
    if change=='cutoff_array':receipt['cutoffs']=list(receipt['cutoffs'].values())
    if change=='foreign':tables['observations']=pa.table(dict(fixture_id=['26102:99'],row_key=['r'],goals=[2]))
    if change=='duplicate':tables['audit']=pa.concat_tables([tables['audit'],tables['audit']])
    if change=='mass':tables['probabilities']=tables['probabilities'].set_column(3,'probability',pa.array([.5,.5,.5]))
    if change=='missing_fit':receipt['fits']={}
    if change=='no_replay':receipt['independent_replay']={}
    if change=='infinite_lambda':tables['lambdas']=tables['lambdas'].set_column(1,'lambda_home',pa.array([float('inf')]))
    if change=='snapshot':tables['snapshots']=tables['snapshots'].set_column(1,'payload',pa.array(['changed']))
    with pytest.raises(ValueError):publish_opponent_research(tables,receipt,'bad-v1',environ=env,repository_root=ROOT)
    assert not (Path(env['BEIDAN_PARQUET_ROOT'])/'datasets/fm17_opponent_research/current.json').exists()


def test_registration_failure_restores_previous_pointer(publication,monkeypatch):
    tables,receipt,env=publication
    publish_opponent_research(tables,receipt,'20261013-v1',environ=env,repository_root=ROOT)
    base=Path(env['BEIDAN_PARQUET_ROOT'])/'datasets/fm17_opponent_research';before=versioning.read_current(base)
    original=versioning.write_json_atomically
    def reject_registration(value,path):
        if Path(path).name=='catalog.json':raise OSError('injected catalog failure')
        return original(value,path)
    monkeypatch.setattr(versioning,'write_json_atomically',reject_registration)
    with pytest.raises(OSError,match='injected'):
        publish_opponent_research(tables,receipt,'20261013-v2',environ=env,repository_root=ROOT)
    assert versioning.read_current(base)==before
    assert (base/'.failed-20261013-v2').is_dir()
    assert not (base/'versions/20261013-v2').exists()
"""Publication receipt validation uses real shared contexts and full ledgers."""
from copy import deepcopy
import hashlib
import json
from pathlib import Path
import pytest
from beidan_backend.opponent_goals import prepare_opponent_goals
from beidan_backend.temporal_learning import Cutoff
from beidan_backend.temporal_learning.serialized_opponent_fit import validate_serialized_opponent_fit

ROOT=Path(__file__).resolve().parents[4]


@pytest.fixture
def fitted():
    fixture=dict(fixture_id='26102:6',issue_id='26102',provider_id='TARGET',home_id='A',away_id='B',competition_id='35',neutral_reported=False)
    cutoff=Cutoff.decision_epoch('26102','2020-02-01T00:00:00Z')
    rows=[dict(row_key=f'r{i}',match_id=f'm{i}',event_date=f'2020-01-{i+1:02}',home_id='A' if i%2==0 else 'B',
        away_id='B' if i%2==0 else 'A',home_score=2,away_score=1,score_scope='SOURCE_PUBLISHED_FULL_TIME',competition_id='35',neutral_reported=False) for i in range(24)]
    prepared=prepare_opponent_goals(rows,fixture,['TARGET'],cutoff,{'source':'a'*64},ROOT,
        dict(recent_n=8,alpha=.5,minimum_recent_matches=12,minimum_recent_ess=8))
    receipt=dict(cutoff=cutoff.identity,fixture=fixture,intended_use='HISTORICAL_DIAGNOSTIC',target_label_optimization=False,
        admission=prepared['admission'].receipt.payload,
        admission_binding=prepared['receipts'][0]['source_hashes']['admission'],
        R_code_sha256=hashlib.sha256((ROOT/'packages/beidan/R/opponent_goals.R').read_bytes()).hexdigest())
    return dict(receipt=receipt,receipts=prepared['receipts'],ledgers=prepared['ledgers']),cutoff


def test_real_serialized_context_and_original_ledgers_validate(fitted):
    fit,cutoff=fitted
    assert validate_serialized_opponent_fit(fit,cutoff,ROOT) is None
    assert validate_serialized_opponent_fit(json.loads(json.dumps(fit)),cutoff,ROOT) is None


@pytest.mark.parametrize('mutation',['cutoff','future','binding','R_code','empty_ledger','masses','redistributed'])
def test_detached_or_mutated_learning_exports_fail(fitted,mutation):
    fit,cutoff=fitted;fit=deepcopy(fit)
    if mutation=='cutoff':fit['receipt']['admission']['target_issue']='26101'
    if mutation=='future':fit['receipts'][0]['maximum_source_time']='2020-02-01T00:00:00Z'
    if mutation=='binding':fit['receipt']['admission_binding']='f'*64
    if mutation=='R_code':fit['receipt']['R_code_sha256']='f'*64
    if mutation=='empty_ledger':fit['ledgers']=[]
    if mutation in ('masses','redistributed'):
        ledger=json.loads(fit['ledgers'][0]['ledger'])
        if mutation=='masses':ledger[0]['total_mass']=.7
        else:
            # Preserve aggregate mass and ESS, but exchange old/recent weights.
            for field in ['long_mass','recent_mass','total_mass','weight']:
                ledger[0][field],ledger[-1][field]=ledger[-1][field],ledger[0][field]
        fit['ledgers'][0]['ledger']=json.dumps(ledger)
    with pytest.raises(ValueError):validate_serialized_opponent_fit(fit,cutoff,ROOT)
