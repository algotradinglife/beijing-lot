"""Shared chronology, weight mass and boundary invariance for opponent inputs."""
from pathlib import Path
from copy import deepcopy
import pytest
from beidan_backend.opponent_goals import prepare_opponent_goals, verify_opponent_preparation
from beidan_backend.temporal_learning import Cutoff

ROOT=Path(__file__).resolve().parents[4]
FIXTURE=dict(fixture_id='26102:6',issue_id='26102',provider_id='TARGET',
    home_id='A',away_id='B',competition_id='35',neutral_reported=False)
POLICY=dict(recent_n=8,alpha=.5,minimum_recent_matches=12,minimum_recent_ess=8)


@pytest.fixture
def rows():
    return [dict(row_key=f'r{i}',match_id=f'm{i}',event_date=f'2020-01-{i+1:02}',
        home_id='A' if i%2==0 else 'B',away_id='B' if i%2==0 else 'A',
        home_score=2,away_score=1,score_scope='SOURCE_PUBLISHED_FULL_TIME',
        competition_id='35',neutral_reported=False) for i in range(24)]


def test_mass_receipts_and_full_replay(rows):
    cutoff=Cutoff.decision_epoch('26102','2020-02-01T00:00:00Z')
    out=prepare_opponent_goals(rows,FIXTURE,['TARGET','FUTURE'],cutoff,{'source':'a'*64},ROOT,POLICY)
    assert out['admitted_matches']==24
    assert len(out['observations'])==48
    assert len(out['contexts'])==4
    for c in out['contexts']:
        assert c.weight_ledger.long_mass.sum()==pytest.approx(.5)
        assert c.weight_ledger.recent_mass.sum()==pytest.approx(.5)
        assert c.receipt.payload['maximum_training_label_timestamp']<cutoff.cutoff_ts.isoformat()
    assert verify_opponent_preparation(out,FIXTURE,cutoff,ROOT) is out


def test_sparse_opponents_shrink_to_long_history(rows):
    out=prepare_opponent_goals(rows[:8],FIXTURE,['TARGET'],Cutoff.decision_epoch('26102','2020-02-01T00:00:00Z'),{'source':'a'*64},ROOT,POLICY)
    assert all(not s['recent_active'] for s in out['support'])
    assert all(c.weight_ledger.recent_mass.sum()==0 for c in out['contexts'])


def test_future_and_exact_target_mutation_invariance(rows):
    cutoff=Cutoff.decision_epoch('26102','2020-02-01T00:00:00Z')
    extra=[{**rows[0],'row_key':'future','match_id':'future','event_date':'2020-02-01'},
           {**rows[0],'row_key':'target','match_id':'TARGET'},
           {**rows[0],'row_key':'bad-future-roster','match_id':'FUTURE'}]
    a=prepare_opponent_goals(rows+extra,FIXTURE,['TARGET','FUTURE'],cutoff,{'source':'a'*64},ROOT,POLICY)
    changed=deepcopy(extra)
    for r in changed:r['home_score']=99;r['competition_id']='999'
    b=prepare_opponent_goals(rows+changed,FIXTURE,['TARGET','FUTURE'],cutoff,{'source':'a'*64},ROOT,POLICY)
    assert a['observations']==b['observations']
    assert a['support']==b['support']
    assert a['admission'].receipt.payload['cache_key']!=b['admission'].receipt.payload['cache_key']
    later=prepare_opponent_goals(rows+extra,FIXTURE,['TARGET','FUTURE'],Cutoff.decision_epoch('26102','2020-02-05T00:00:00Z'),{'source':'a'*64},ROOT,POLICY)
    assert later['admitted_matches']==25
    assert later['admission'].receipt.payload['cache_key']!=a['admission'].receipt.payload['cache_key']


def test_duplicate_agreement_and_conflict(rows):
    cutoff=Cutoff.decision_epoch('26102','2020-02-01T00:00:00Z')
    duplicated=rows+[{**rows[0],'row_key':'duplicate'}]
    out=prepare_opponent_goals(duplicated,FIXTURE,['TARGET'],cutoff,{'source':'a'*64},ROOT,POLICY)
    assert out['duplicates_removed']==1
    duplicated[-1]['home_score']=3
    with pytest.raises(ValueError,match='Conflicting prior'):
        prepare_opponent_goals(duplicated,FIXTURE,['TARGET'],cutoff,{'source':'a'*64},ROOT,POLICY)


def test_export_mutations_are_rejected(rows):
    cutoff=Cutoff.decision_epoch('26102','2020-02-01T00:00:00Z')
    out=prepare_opponent_goals(rows,FIXTURE,['TARGET'],cutoff,{'source':'a'*64},ROOT,POLICY)
    with pytest.raises(ValueError,match='fixture/cutoff'):
        verify_opponent_preparation(out,{**FIXTURE,'away_id':'C'},cutoff,ROOT)
    out['observations'][0]['weight']=10
    with pytest.raises(ValueError,match='Exported'):
        verify_opponent_preparation(out,FIXTURE,cutoff,ROOT)


@pytest.mark.parametrize('mutation', ['missing','score','venue','policy','cutoff'])
def test_invalid_input_fails_closed(rows,mutation):
    policy=deepcopy(POLICY);cutoff=Cutoff.decision_epoch('26102','2020-02-01T00:00:00Z')
    if mutation=='missing':rows[0]['competition_id']=None
    if mutation=='score':rows[0]['home_score']=-1
    if mutation=='venue':rows[0]['neutral_reported']='false'
    if mutation=='policy':policy['alpha']=1
    if mutation=='cutoff':cutoff=None
    with pytest.raises(ValueError):
        prepare_opponent_goals(rows,FIXTURE,['TARGET'],cutoff,{'source':'a'*64},ROOT,policy)
test_that("Poisson opponent model reproduces known home and away goal rates", {
  root <- Sys.getenv("FM17_OPPONENT_ROOT",unset="")
  if(!nzchar(root)) root <- normalizePath(file.path("..","..","..",".."),mustWork=TRUE)
  ns <- new.env(parent=asNamespace("beidan"))
  sys.source(file.path(root,"packages/beidan/R/opponent_goals.R"),ns)
  reticulate::use_python(file.path(root,".venv/bin/python"),required=TRUE)
  reticulate::import("sys",convert=FALSE)$path$insert(0L,file.path(root,"packages/beidan/inst/python"))
  backend <- reticulate::import("beidan_backend.opponent_goals",convert=FALSE)
  shared <- reticulate::import("beidan_backend.temporal_learning",convert=FALSE)
  fixture <- list(fixture_id="26102:6",issue_id="26102",provider_id="TARGET",
                  home_id="A",away_id="B",competition_id="35",neutral_reported=FALSE)
  history <- tibble::tibble(row_key=paste0("r",1:24),match_id=paste0("m",1:24),
    event_date=format(as.Date("2020-01-01")+0:23),home_id=rep(c("A","B"),12),
    away_id=rep(c("B","A"),12),home_score=2L,away_score=1L,
    score_scope="SOURCE_PUBLISHED_FULL_TIME",competition_id="35",neutral_reported=FALSE)
  rows <- jsonlite::fromJSON(jsonlite::toJSON(history,dataframe="rows",auto_unbox=TRUE),simplifyVector=FALSE)
  cutoff <- shared$Cutoff$decision_epoch("26102","2020-02-01T00:00:00Z")
  recent <- list(recent_n=8L,alpha=.5,minimum_recent_matches=12L,minimum_recent_ess=8)
  prepared <- backend$prepare_opponent_goals(rows,fixture,list("TARGET"),cutoff,list(source=strrep("a",64)),root,recent)
  policy <- list(ridge=.05,minimum_target_matches=12L,convergence_tolerance=1e-10,maximum_iterations=100000L)
  fit <- ns$FitOpponentGoals(prepared,fixture,cutoff,policy,root)
  expect_s3_class(fit$parameters,"tbl_df")
  expect_equal(fit$parameters$lambda_home,2,tolerance=1e-5)
  expect_equal(fit$parameters$lambda_away,1,tolerance=1e-5)
  expect_equal(fit$same_support_raw$lambda_home,2,tolerance=1e-12)
  expect_equal(fit$same_support_raw$lambda_away,1,tolerance=1e-12)
  expect_false(fit$receipt$target_label_optimization)
  expect_length(fit$ledgers,4)
  again <- ns$FitOpponentGoals(prepared,fixture,cutoff,policy,root)
  expect_identical(fit,again)
  expect_error(ns$FitOpponentGoals(prepared,fixture,shared$Cutoff$decision_epoch("26102","2020-02-02T00:00:00Z"),policy,root),"differs")
  expect_error(ns$FitOpponentGoals(prepared,fixture,NULL,policy,root),"Explicit")
  expect_error(ns$FitOpponentGoals(prepared,fixture,cutoff,modifyList(policy,list(minimum_target_matches=13L)),root),"Sparse")
  expect_error(ns$FitOpponentGoals(prepared,modifyList(fixture,list(away_id="C")),cutoff,policy,root),"differs")
  expect_error(ns$FitOpponentGoals(prepared,fixture,cutoff,modifyList(policy,list(ridge=0)),root))
})
"""Metadata extension reuses immutable real pages and source parser contracts."""
import copy
import pytest
from beidan_backend.opponent_history import parse_opponent_history
from test_unified_sources import saved_pair


def test_real_competition_metadata_and_replay():
    pages, records, identity = saved_pair()
    for source in ('titan', 'nowscore'):
        url = next(u for u in pages if source in u and '/analysis/' in u)
        auxiliary = next((v['body'] for u, v in pages.items() if 'analysisJs/' in u), None)
        result = parse_opponent_history(pages[url]['body'], source=source,
            provider_id='1870517', expected_identity=identity, auxiliary_raw=auxiliary)
        assert len(result['rows']) == len(records[source]['history'])
        assert result['target_competition_id'] is None  # Old titles lack league.
        assert ('35','英乙') in {(r['competition_id'],r['competition_name']) for r in result['rows']}
        assert all(r['competition_id'].isdigit() for r in result['rows'])
        assert all(isinstance(r['neutral_reported'], bool) for r in result['rows'])
        assert result == parse_opponent_history(pages[url]['body'], source=source,
            provider_id='1870517', expected_identity=identity, auxiliary_raw=auxiliary)


@pytest.mark.parametrize('field,value', [('home_id','999'), ('provider_id','999'),
    ('kickoff_utc','2020-06-22T09:15:00+00:00')])
def test_wrong_bound_identity_fails(field, value):
    pages, _, identity = saved_pair()
    url = next(u for u in pages if 'titan' in u)
    bad = copy.deepcopy(identity); bad[field] = value
    with pytest.raises(ValueError):
        parse_opponent_history(pages[url]['body'], source='titan',
            provider_id='1870517', expected_identity=bad)


def test_invalid_competition_and_unmatched_title():
    pages, _, identity = saved_pair()
    raw = pages[next(u for u in pages if 'titan' in u)]['body']
    with pytest.raises(ValueError, match='competition'):
