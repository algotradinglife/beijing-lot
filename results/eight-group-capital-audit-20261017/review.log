    60	  stopifnot(nrow(t)==1000L,all((t |> count(group))$n==125L),!anyDuplicated(t[c('group','ticket_id')]))
    61	  pm<-matrix(0,nrow=length(ids),ncol=3)
    62	  for(j in seq_along(ids))pm[j,]<-q$probability[match(paste(ids[j],c('W','D','L')),paste(q$fixture_id,q$outcome))]
    63	  stopifnot(!anyNA(pm),all(pm>=0),all(abs(rowSums(pm)-1)<1e-9))
    64	  events<-list();ticket_mass<-numeric(nrow(t))
    65	  for(j in seq_len(nrow(t))){
    66	   z<-strsplit(t$ticket_id[j],'|',fixed=TRUE)[[1]]
    67	   events[[j]]<-setNames(as.integer(sub('.*:','',z)),sub(':[^:]+$','',z))
    68	   stopifnot(length(events[[j]])==7L,!anyDuplicated(names(events[[j]])),all(names(events[[j]]) %in% ids))
    69	   ticket_mass[j]<-prod(pm[cbind(match(names(events[[j]]),ids),unname(events[[j]]))])
    70	  }
    71	  stopifnot(max(abs(ticket_mass-t$probability))<1e-12)
    72	  group_mass<-numeric(8)
    73	  for(g in groups)group_mass[g]<-sum(ticket_mass[t$group==g])
    74	  unions<-numeric(256);memberships<-matrix(FALSE,nrow=256,ncol=8)
    75	  for(mask in 0:255){
    76	   chosen<-which(as.logical(intToBits(mask)[1:8]));memberships[mask+1L,chosen]<-TRUE
    77	   if(mask>0)unions[mask+1L]<-component(events[t$group %in% chosen],ids,function(id,code)pm[match(id,ids),code])
    78	  }
    79	  full<-unions[256]
    80	  phi<-numeric(8);unique_mass<-numeric(8)
    81	  for(g in groups){
    82	   unique_mass[g]<-full-unions[256L-2^(g-1L)]
    83	   for(mask in 0:255){if(memberships[mask+1L,g])next;k<-sum(memberships[mask+1L,]);phi[g]<-phi[g]+(unions[mask+2^(g-1L)+1L]-unions[mask+1L])/(8*choose(7,k))}
    84	   stopifnot(abs(unions[2^(g-1L)+1L]-group_mass[g])<1e-10,unique_mass[g]>=-1e-10,phi[g]>=unique_mass[g]-1e-10,phi[g]<=group_mass[g]+1e-10)
    85	   group_rows[[length(group_rows)+1L]]<-tibble(round=i,model,group=g,cost_cny=250,standalone_hit=group_mass[g],exclusive_hit=unique_mass[g],shapley_hit=phi[g],exclusive_pp_per_100cny=unique_mass[g]*40,shapley_pp_per_100cny=phi[g]*40)
    86	  }
    87	  stopifnot(abs(sum(phi)-full)<1e-10,full<=sum(group_mass)+1e-10,full>=max(group_mass)-1e-10,full<=1+1e-10)
    88	  for(a in 1:7)for(bb in (a+1):8){
    89	   joint<-group_mass[a]+group_mass[bb]-unions[2^(a-1L)+2^(bb-1L)+1L]
    90	   pair_rows[[length(pair_rows)+1L]]<-tibble(round=i,model,group_a=a,group_b=bb,joint_hit=joint,conditional_b_given_a=joint/group_mass[a],conditional_a_given_b=joint/group_mass[bb])
    91	  }
    92	  summary_rows[[length(summary_rows)+1L]]<-tibble(round=i,model,cost_cny=2000,paid_tickets=1000L,unique_physical_tickets=n_distinct(t$ticket_id),duplicate_copies=1000L-n_distinct(t$ticket_id),any_hit=full,expected_winning_tickets=sum(group_mass),expected_wins_if_any=sum(group_mass)/full,exactly_one_group_hit=sum(unique_mass),multiple_groups_hit=full-sum(unique_mass))
    93	  # Model-optimal retained subsets are diagnostic savings frontiers, not adopted allocations.
    94	  for(k in 1:8){
    95	   candidates<-which(rowSums(memberships)==k);idx<-candidates[which.max(unions[candidates])]
    96	   chosen<-which(memberships[idx,]);subset_rows[[length(subset_rows)+1L]]<-tibble(round=i,model,n_groups=k,cost_cny=250*k,saved_cny=2000-250*k,retained_groups=paste(chosen,collapse=','),any_hit=unions[idx],lost_pp=100*(full-unions[idx]),retained_fraction=unions[idx]/full)
    97	  }
    98	  for(depth in c(25L,50L,75L,100L,125L)){
    99	   chosen<-rep(FALSE,nrow(t))
   100	   for(g in groups){idx<-which(t$group==g);idx<-idx[order(t$rank[idx])];chosen[idx[seq_len(depth)]]<-TRUE}
   101	   u<-component(events[chosen],ids,function(id,code)pm[match(id,ids),code])
   102	   stopifnot(u<=full+1e-10)
   103	   depth_rows[[length(depth_rows)+1L]]<-tibble(round=i,model,depth,cost_cny=16*depth,saved_cny=2000-16*depth,any_hit=u,lost_pp=100*(full-u),retained_fraction=u/full)
   104	  }
   105	  receipts[[length(receipts)+1L]]<-list(round=i,model,cutoff=cutoff,source_receipts=sources,kernel_identity=identity,probability_matrix_sha256=rlang::hash(list(ids,pm)),ticket_event_hash=rlang::hash(list(t,events)),all_subset_union_hash=rlang::hash(unions),source_rds_sha256=digest::digest(file=file.path(w,'frozen-probabilities.rds'),algo='sha256'),plans_sha256=digest::digest(file=file.path(w,'plans.rds'),algo='sha256'),research_plan_sha256=digest::digest(file=plan_path,algo='sha256'),code_identity=get('.ParlayRiskCodeHash',envir=ns)())
   106	 }
   107	}
   108	summary<-bind_rows(summary_rows);contributions<-bind_rows(group_rows);subsets<-bind_rows(subset_rows);depths<-bind_rows(depth_rows);pairs<-bind_rows(pair_rows)
   109	stopifnot(nrow(summary)==8L,nrow(contributions)==64L,nrow(subsets)==64L,nrow(depths)==40L,nrow(pairs)==224L)
   110	for(i in 1:4)for(m in unique(summary$model)){
   111	 a<-subsets |> filter(round==i,model==m) |> arrange(n_groups);d<-depths |> filter(round==i,model==m) |> arrange(depth)
   112	 stopifnot(all(diff(a$any_hit)>=-1e-10),all(diff(d$any_hit)>=-1e-10),abs(tail(a$any_hit,1)-tail(d$any_hit,1))<1e-10)
   113	}
   114	readr::write_csv(summary,file.path(out,'summary.csv'));readr::write_csv(contributions,file.path(out,'group-contributions.csv'));readr::write_csv(subsets,file.path(out,'subset-frontier.csv'));readr::write_csv(depths,file.path(out,'depth-frontier.csv'));readr::write_csv(pairs,file.path(out,'pair-overlap.csv'))
   115	saveRDS(list(receipts=receipts,input_code_sha256=digest::digest(file=file.path(root,'quarto/eight_group_capital_audit_20261017.qmd'),algo='sha256'),purpose='LABEL_FREE_MODEL_COVERAGE_DIAGNOSTIC_NOT_POLICY_ADOPTION'),file.path(out,'receipt.rds'))
   116	```
