#'   * nested/subset events stay exact: a covering event is satisfied before a
#'     narrower event is ever decomposed.
#'
#' The residual state is canonicalized (events sorted and de-duplicated) and
#' memoized for sparse components. Components of 10--15 normalized fixtures use
#' a bounded ternary grid; other sizes use sparse Shannon decomposition. No
#' unbounded global outcome grid is materialized.
#' @param events List of canonical ticket events over `fixtures`.
#' @param fixtures Fixtures of this component.
#' @param probability_of Function `(fixture_id, code) -> probability`.
#' @return A single probability in `[0, 1]`.
#' @noRd
.parlay_ranked_component_union <- function(events, fixtures, probability_of) {
  keys <- vapply(events,function(event) paste(names(event),event,sep="=",collapse="|"),character(1))
  events <- events[order(keys)][!duplicated(sort(keys))]
  if (!identical(ComponentUnionKernelIdentity(),.ParlayKernelSourceHash()))
    stop("Compiled probability kernel identity mismatch; rebuild package")
  probabilities <- matrix(numeric(length(fixtures)*3L),nrow=length(fixtures),ncol=3L)
  for(i in seq_along(fixtures)) for(code in 1:3)
    probabilities[i,code] <- probability_of(fixtures[i],code)
  ComponentUnionKernel(events,fixtures,probabilities)
}

#' Exact coverage of the whole owned portfolio across every selected group
#'
#' Internal. The union probability over ALL owned physical tickets is the
#' probability that AT LEAST ONE owned ticket wins. Tickets are partial fixture
#' assignments, so the quantity is computed as an exact event union:
#'
#'   * physically identical tickets are harmless duplicates and are collapsed;
#'   * tickets spanning DISJOINT fixture sets are independent and combine as
#' Typed empty joint-risk summary
#' @return Zero-row tibble with CNY amounts, probabilities and Monte Carlo errors.
#' @details No inputs, missing values or side effects.
#' @noRd
.ParlayRiskEmpty <- function() {
  return(tibble::tibble(scenario_id = character(), prefix_groups = integer(),
    cost_cny = double(), purchased_tickets = integer(), expected_winning_tickets = double(),
    hit_probability = double(), break_even_probability = double(), expected_net_cny = double(),
    net_p05_cny = double(), roi_est = double(), sp_complete = logical(),
    hit_se = double(), break_even_se = double()))
}

#' Canonicalize a validated table for comparisons
#' @param data Tibble; empty tables retain their schema.
#' @param keys Existing column names defining a deterministic row order.
#' @return Sorted tibble. Invalid keys error; no side effects.
#' @noRd
.ParlayRiskCanonical <- function(data, keys) {
  return(tibble::as_tibble(data[do.call(order, unname(as.list(data[keys]))), , drop = FALSE]))
}

#' Bind loaded implementation and dependency versions
#' @return Character hash of all loaded package functions and dependency versions.
#' @details Conservative superset of transitive helpers. Generated S7 defaults
#'   can contain closures whose captured namespace environments differ between
#'   processes; signatures and bodies are bound as code, not serialized closure
#'   environments. Binding order uses locale-independent radix sorting.
#'   Runtime/dependency versions remain bound. No file reads or IO.
#' @noRd
.ParlayRiskCodeHash <- function() {
  ns <- asNamespace("beidan")
  ids <- sort(ls(ns, all.names = TRUE), method = "radix")
  code <- lapply(ids, function(id) {
    fn <- get(id, envir = ns, inherits = FALSE)
    if (is.function(fn)) return(list(name = id, arguments = deparse(formals(fn)), body = deparse(body(fn))))
    return(NULL)
  })
  deps <- c("tibble", "dplyr", "tidyr", "rlang", "checkmate", "lubridate", "S7", "Rcpp")
  versions <- stats::setNames(vapply(deps, function(pkg) as.character(utils::packageVersion(pkg)), character(1)), deps)
  return(rlang::hash(list(code = code, R = as.character(getRversion()), dependencies = versions)))
}

