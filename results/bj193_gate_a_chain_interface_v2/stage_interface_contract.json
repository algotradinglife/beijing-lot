{
  "canonical_digest": {
    "list_order": "ordered match IDs, outcome code order 3/1/0, ticket base-3 ordinal",
    "output_rule": "SHA-256 of the complete stage output with output_sha256 omitted",
    "serialization": "UTF-8 JSON; sort_keys=true; separators=(',', ':'); ensure_ascii=true"
  },
  "common_pre_event_state": {
    "forbidden_fields": [
      "target_result",
      "final_sp",
      "winning_sp",
      "payout",
      "tax",
      "roi",
      "settlement",
      "post_cutoff_message_or_market_evidence"
    ],
    "history": "H_<i contains only issues before the frozen fold boundary; outer-test outcomes never update any model within that fold",
    "required_fields": [
      "issue",
      "issue_instance",
      "cutoff_ts",
      "source_version",
      "source_row_sha256",
      "public_state_sha256",
      "missingness_json"
    ],
    "source": "v1 issue_regime_features plus public pre-event stage-specific source fields",
    "symbol": "X_i"
  },
  "contract": "BJ193_THREE_STAGE_INTERFACE_V2",
  "decision_unit": "one canonical complete issue",
  "outcome_boundary": "Gate A outcome-unexposed: target result, final/winning SP, payout, tax realization, ROI, settlement, and any post-cutoff evidence are forbidden from X_i, every stage output, fitting inputs, screens, and tie-breaks",
  "stages": {
    "STAGE_1_SELECTION": {
      "function": "theta_selection_i = f_selection(X_i,H_<i)",
      "reason_codes": [
        "MODEL_CHOICE",
        "PRIOR_ONLY_FALLBACK",
        "STATIC_FALLBACK",
        "NO_QUALIFYING_MATCH_SET",
        "INSUFFICIENT_HISTORY",
        "SOURCE_UNAVAILABLE"
      ],
      "required_fields": [
        "issue",
        "issue_instance",
        "cutoff_ts",
        "public_state_sha256",
        "history_end_issue",
        "history_end_cutoff_ts",
        "history_sha256",
        "stage_id",
        "stage_version",
        "model_id",
        "model_sha256",
        "source_action_identity",
        "availability",
        "abstention_flag",
        "fallback_flag",
        "reason_code",
        "output_sha256",
        "selector_family",
        "selector_parameters_json",
        "selected_match_ids_json",
        "candidate_scores_json",
        "selected_match_count",
        "support_count"
      ]
    },
    "STAGE_2_DIRECTION": {
      "function": "theta_direction_i = f_direction(X_i,selection_output_i,theta_selection_i,H_<i)",
      "reason_codes": [
        "MODEL_CHOICE",
        "PRIOR_ONLY_FALLBACK",
        "ALLOW_ALL_FALLBACK",
        "PROTECTION_TRIGGERED",
        "ABSTAIN_DIRECTION",
        "INSUFFICIENT_HISTORY",
        "SOURCE_UNAVAILABLE"
      ],
      "required_fields": [
        "issue",
        "issue_instance",
        "cutoff_ts",
        "public_state_sha256",
        "history_end_issue",
        "history_end_cutoff_ts",
        "history_sha256",
