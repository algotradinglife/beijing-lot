        "per_match_outcome_identity_json",
        "per_match_outcome_weight_json"
      ]
    }
  },
  "status_enum": [
    "ACTIVE",
    "NO_BET",
    "UNAVAILABLE"
  ],
  "zero_flow_rule": "NO_BET and UNAVAILABLE emit zero tickets/stake and remain distinct; unavailable never becomes a losing stake"
