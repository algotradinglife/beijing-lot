        "stage_version",
        "model_id",
        "model_sha256",
        "source_action_identity",
        "availability",
        "abstention_flag",
        "fallback_flag",
        "reason_code",
        "output_sha256",
        "stage1_output_sha256",
        "stage1_selected_match_ids_json",
        "derived_direction_action_sha256",
        "direction_adapter_version",
        "direction_adapter_sha256",
        "upstream_190_policy_id",
        "ordered_match_ids_json",
        "per_match_outcome_identity_json",
        "per_match_outcome_weight_json",
        "per_match_probability_json",
