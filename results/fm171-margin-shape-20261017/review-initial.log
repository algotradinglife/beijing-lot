 beidan:::match_require_cutoff(z$cutoff)
 cutoff <- shared$Cutoff$decision_epoch(z$cutoff$issue_id,format(z$cutoff$cutoff_utc,"%Y-%m-%dT%H:%M:%SZ",tz="UTC"))
 base <- e$results[["FM-1.7.0"]]$base
 rows <- e$evidence_rows
