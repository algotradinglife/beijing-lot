for(id in names(x$entries)) {
 e <- x$entries[[id]];f0 <- e$feature;core <- e$results$FM171$core$core_margins
 m <- e$base$grid |> mutate(margin=home_goals-away_goals,
  outcome=case_when(margin>f0$draw_margin~"W",margin==f0$draw_margin~"D",TRUE~"L"),core=margin %in% core) |>
  group_by(outcome,core) |> summarise(mass=sum(probability),.groups="drop") |>
  mutate(fixture_id=id,.before=1)
 contributions[[id]] <- m
}
contributions <- bind_rows(contributions)
cases <- scores |> filter(target_conflict) |> arrange(fixture_id,model) |>
 select(fixture_id,issue_id,home,away,league,eligible,handicap,model,actual_outcome,predicted_outcome,
 actual_rank,top1,top2,saved_top2,lost_top2,draw_probability,draw_margin_rank,draw_category_rank,
 mode,mean_margin,interval80_positions,local_mass,shape,line_locality,raw_w,raw_d,raw_l)
shape_summary <- f |> group_by(eligible,draw_group,shape,line_locality) |>
 summarise(n=n(),actual_draws=sum(actual_outcome=="D"),mean_draw_probability=mean(draw_probability),
  mean_positions=mean(interval80_positions),mean_local_mass=mean(local_mass),.groups="drop")
tables <- list(metrics=metrics,scores=scores,shape_cells=shape_cells,cases=cases,features_labeled=f,
 contributions=contributions,shape_summary=shape_summary,draw_ranks=draw_ranks)
for(name in names(tables))write_csv(tables[[name]],file.path(out,paste0(name,".csv")))
jsonlite::write_json(list(mode="POSTHOC_FIXED_POLICY_DIAGNOSTIC",forecast_sha256=manifest$sha256,
 client_sha256=digest::digest(file=file.path(root,"r/fm171_margin_shape_evaluate.R"),algo="sha256"),
 labels_sha256=digest::digest(file=label_path,algo="sha256"),
 output_hashes=as.list(set_names(map_chr(names(tables),~digest::digest(file=file.path(out,paste0(.x,".csv")),algo="sha256")),names(tables))),
 selected_policy=NULL,versions_modified=FALSE,primary_n=322L,secondary_n=345L,
 interpretation="All preset candidates and sparse cells reported. No fitted thresholds, production promotion or independent prospective validation."),
 file.path(out,"evaluation.json"),pretty=TRUE,auto_unbox=TRUE)
print(metrics |> filter(dimension=="all"))
testthat::test_that("FM171 fixed shape study preserves score mapping and symmetric width contracts", {
 root <- rprojroot::find_root(rprojroot::has_file("AGENTS.md"))
 out <- file.path(root,"results/fm171-margin-shape-20261017")
 manifest <- jsonlite::fromJSON(file.path(out,"manifest.json"))
 replay <- jsonlite::fromJSON(file.path(out,"replay.json"))
 testthat::expect_identical(replay$status,"FULL_IDENTICAL_REPLAY")
 testthat::expect_equal(replay$forecasts,346L)
 testthat::expect_identical(digest::digest(file=file.path(out,"forecasts.rds"),algo="sha256"),manifest$sha256)
 x <- readRDS(file.path(out,"forecasts.rds"))
 testthat::expect_equal(sum(x$features$eligible),323L)
 testthat::expect_equal(nrow(x$probabilities),346L*4L*3L)
 testthat::expect_false(anyDuplicated(x$probabilities[c("fixture_id","model","outcome")])>0)
 testthat::expect_false(manifest$target_labels_opened)
 for(id in names(x$entries)) {
  e <- x$entries[[id]];f <- e$feature
  testthat::expect_identical(e$base$cutoff,e$cutoff)
  testthat::expect_lt(as.numeric(e$base$max_source_available_utc),as.numeric(e$cutoff$cutoff_utc))
  m <- dplyr::summarise(dplyr::group_by(dplyr::mutate(e$base$grid,margin=home_goals-away_goals),margin),p=sum(probability),.groups="drop")
  testthat::expect_equal(f$draw_probability,sum(m$p[m$margin==f$draw_margin]),tolerance=1e-12)
  testthat::expect_equal(f$draw_margin_rank,1L+sum(m$p>f$draw_probability+1e-12))
  testthat::expect_equal(f$local_mass,sum(m$p[abs(m$margin-f$draw_margin)<=1]),tolerance=1e-12)
  testthat::expect_equal(sum(c(f$raw_w,f$raw_d,f$raw_l)),1,tolerance=1e-10)
  testthat::expect_equal(f$interval80_positions,f$interval80_hi-f$interval80_lo+1)
  testthat::expect_gte(f$interval80_mass,.8-1e-12)
  # No shorter contiguous interval reaches 80%, including outside the selected mode.
  width <- f$interval80_positions-1L
  if(width>0L)for(lo in m$margin) testthat::expect_lt(sum(m$p[m$margin>=lo & m$margin<lo+width]),.8+1e-12)
  for(name in names(e$results)) {
   z <- e$results[[name]];grid <- z$final$grid
   testthat::expect_equal(sum(grid$probability),1,tolerance=1e-10)
   testthat::expect_true(all(grid$probability>=0))
   testthat::expect_identical(z$final$cutoff,e$cutoff)
   q <- x$probabilities[x$probabilities$fixture_id==id & x$probabilities$model==name,]
   expected <- c(W=sum(grid$probability[grid$home_goals-grid$away_goals>f$draw_margin]),
    D=sum(grid$probability[grid$home_goals-grid$away_goals==f$draw_margin]),
    L=sum(grid$probability[grid$home_goals-grid$away_goals<f$draw_margin]))
   testthat::expect_equal(q$probability,unname(expected[q$outcome]),tolerance=1e-10)
   if(name=="SOURCE_FULL" || e$review$decision=="retain")testthat::expect_equal(grid$probability,e$base$grid$probability,tolerance=1e-10)
   # Uniform margin reweighting preserves relative probabilities of scores within each margin.
   original <- e$base$grid;ratio <- grid$probability/original$probability
   for(margin in unique(original$home_goals-original$away_goals)) {
    r <- ratio[original$home_goals-original$away_goals==margin & original$probability>0]
    if(length(r)>1)testthat::expect_lt(max(r)-min(r),1e-8)
   }
  }
 }
})

testthat::test_that("shape scoring replays independently, reconciles changes and rejects corrupt forecasts", {
 root <- rprojroot::find_root(rprojroot::has_file("AGENTS.md"))
 folder <- file.path(root,"results/fm171-margin-shape-20261017")
 evaluation <- jsonlite::fromJSON(file.path(folder,"evaluation.json"))
 temp <- tempfile("shape-evaluation-");dir.create(temp)
 for(name in c("forecasts.rds","manifest.json","replay.json"))testthat::expect_true(file.copy(file.path(folder,name),file.path(temp,name)))
 log <- tempfile();status <- system2("/opt/R/4.6.1/bin/Rscript",shQuote(c(file.path(root,"r/fm171_margin_shape_evaluate.R"),root,temp)),
  env=paste0("R_LIBS=",shQuote(paste(.libPaths(),collapse=":"))),stdout=log,stderr=log)
 testthat::expect_equal(status,0L,info=paste(readLines(log),collapse="\n"))
 for(name in names(evaluation$output_hashes))testthat::expect_identical(
  digest::digest(file=file.path(temp,paste0(name,".csv")),algo="sha256"),evaluation$output_hashes[[name]])
 m <- readr::read_csv(file.path(temp,"metrics.csv"),show_col_types=FALSE)
 for(cohort in unique(m$cohort)) {
  all <- dplyr::filter(m,.data$cohort==.env$cohort,dimension=="all")
  testthat::expect_true(all(all$n==if(cohort=="ELIGIBLE_322")322 else 345))
  ref <- all[all$model=="FM171",]
  testthat::expect_equal(all$hits1-ref$hits1,all$saved_top1-all$lost_top1)
  testthat::expect_equal(all$hits2-ref$hits2,all$saved_top2-all$lost_top2)
  for(model in all$model) {
   rows <- dplyr::filter(m,.data$cohort==.env$cohort,.data$model==.env$model,dimension=="shape")
   whole <- all[all$model==model,]
   testthat::expect_equal(sum(rows$n),whole$n)
   testthat::expect_equal(sum(rows$hits2),whole$hits2)
   testthat::expect_equal(weighted.mean(rows$brier,rows$n),whole$brier,tolerance=1e-12)
  }
 }
 x <- readRDS(file.path(temp,"forecasts.rds"));x$features$local_mass[1]<-.99;saveRDS(x,file.path(temp,"forecasts.rds"))
 status <- system2("/opt/R/4.6.1/bin/Rscript",shQuote(c(file.path(root,"r/fm171_margin_shape_evaluate.R"),root,temp)),
  env=paste0("R_LIBS=",shQuote(paste(.libPaths(),collapse=":"))),stdout=log,stderr=log)
 testthat::expect_true(status!=0L)
})

testthat::test_that("shape projections reject cutoff and distribution mutations", {
 root <- rprojroot::find_root(rprojroot::has_file("AGENTS.md"))
 x <- readRDS(file.path(root,"results/fm171-margin-shape-20261017/forecasts.rds"))
 e <- x$entries[[1]];final <- e$results$FM171$final;h <- e$feature$handicap
 original <- beidan::project_score_outcomes(final,h,root)
 final$cutoff$cutoff_utc <- final$cutoff$cutoff_utc+1
 testthat::expect_error(beidan::project_score_outcomes(final,h,root))
 final <- e$results$FM171$final;final$grid$probability[1]<-.999
 testthat::expect_error(beidan::project_score_outcomes(final,h,root))
 testthat::expect_identical(original,beidan::project_score_outcomes(e$results$FM171$final,h,root))
})
---
title: "FM-1.7.1净胜球形态与让平保护：固定方案探索"
format:
  html:
    embed-resources: true
params:
  repository_root: ".."
  output_dir: "results/fm171-margin-shape-20261017"
  acceptance_required: true
execute:
  cache: false
  freeze: false
  error: false
---

## 问题与预先固定的对照

目标不是让让平必然进入Top2，而是检验：让平单档排前二却在三分类排第三时，两侧累计是否主要由尾部堆积形成；集中/分散、集中位置不同，是否对应不同的保护价值。

基座为FM-1.7.1：同赛事原生lambda、冻结原生/市场来源决策、rho−0.1。四个固定方案为：完整选定来源分布SOURCE_FULL；正式FM171累计严格超过90%核心、外围0.3；核心80%外围0.3（CORE80_C03）；核心90%外围0.1（CORE90_C01）。前者减少核心档位，后者加重外围压缩。边界概率并列整组纳入，原独立retain审查保持原分布。所有方案都先重加权完整比分，再按北单线映射，不直接抬让平、不返拟合lambda、不强制排序。另展示冻结同赛事alpha及较晚北单对照。

所有参数在本轮评分前写入config/fm171_margin_shape_study.json，未用本轮目标标签择优；前述三期结果已知，本轮仍是事后探索，不能解释为盲测/滚动样本外。正式版本不变。没有新增采集、拟合、下注或线上发布。

## 输入、截止与合同

346个冻结fixture/cutoff，其中345场有标签。主分析排除23场同赛事原生支持不足而留存父版的行，共322场；混合345场仅作敏感性对照。229场市场路由仍按原冻结决策，原生成功替换94场；原生是否使用与是否已算出原生参数分别披露。

净胜球D=主进球−客进球；有符号北单让球h，让平档为−h；让胜=P(D>−h)、让平=P(D=−h)、让负=P(D<−h)。概率0–1，图示百分比。比分网格每行唯一主客进球组合；feature每fixture唯一；projection每fixture/model/outcome唯一且三类归一化；margin每fixture/model/integer margin唯一。critical输入哈希、截止或归一化失败立即停止。

逐场显式T−24h从父冻结包继承。Shared temporal_learning负责所有来源准入、最大时间、上下文/实现绑定、收据与重放，无客户端时序复制。新敏感性网格经build_adjustment_evidence_context、BuildFmTailJudgement、adjust_score_margin_distribution、project_score_outcomes形成；原生lambda只从封存same_support_raw重建。日粒度/盘口可用性含历史代理，不能授权前瞻使用。已有原生学习链prepare_opponent_goals、FitOpponentGoals及共享learning上下文不重新拟合；本次不选择参数、不训练分组阈值，来源切换也不重新裁决。输入源、模型、客户端及传递实现身份在manifest和逐场收据中绑定，换cutoff须重建，禁止缓存跨cutoff复用。

```{r}
suppressPackageStartupMessages(library(tidyverse))
root <- normalizePath(params$repository_root,mustWork=TRUE)
out <- file.path(root,params$output_dir)
manifest <- jsonlite::fromJSON(file.path(out,"manifest.json"))
replay <- jsonlite::fromJSON(file.path(out,"replay.json"))
stopifnot(replay$status=="FULL_IDENTICAL_REPLAY",replay$sha256==manifest$sha256,
 digest::digest(file=file.path(out,"forecasts.rds"),algo="sha256")==manifest$sha256)
status <- system2("/opt/R/4.6.1/bin/Rscript",shQuote(c(file.path(root,"r/fm171_margin_shape_evaluate.R"),root,out)),
 env=paste0("R_LIBS=",shQuote(paste(.libPaths(),collapse=":"))),stdout=file.path(out,"qmd-evaluation.log"),stderr=file.path(out,"qmd-evaluation.log"))
stopifnot(status==0L)
evaluation <- jsonlite::fromJSON(file.path(out,"evaluation.json"))
for(n in names(evaluation$output_hashes))stopifnot(digest::digest(file=file.path(out,paste0(n,".csv")),algo="sha256")==evaluation$output_hashes[[n]])
x <- readRDS(file.path(out,"forecasts.rds"))
metrics <- read_csv(file.path(out,"metrics.csv"),show_col_types=FALSE)
f <- read_csv(file.path(out,"features_labeled.csv"),show_col_types=FALSE)
cases <- read_csv(file.path(out,"cases.csv"),show_col_types=FALSE)
knitr::kable(x$features |> count(eligible,selected_source,native_changed),caption="估计覆盖；eligible排除父版留存原生")
```

## 整体、逐期与误伤

Top1/Top2计数越高越好；Brier和log loss越低越好。saved/lost相对FM171逐场配对，净增等于救回减误伤；不能只展示救回。较晚北单不是同T−24h证据。

```{r}
knitr::kable(metrics |> filter(dimension=="all") |> select(cohort,model,n,hits1,hits2,brier,logloss,saved_top2,lost_top2),digits=6)
knitr::kable(metrics |> filter(cohort=="ELIGIBLE_322",dimension=="issue_id") |>
 select(stratum,model,n,hits1,hits2,brier,logloss),digits=6,caption="主队列逐期表现")
```

## 集中程度与集中位置分别看

覆盖80%概率的最短连续整数区间，以整数档位数计宽；不强制围绕众数对称。相同宽度先取覆盖质量较大者，再按距均值、左端顺序确定。宽≤3为NARROW，4–5为MEDIUM，≥6为BROAD。让平及左右各一球合计质量≥0.6为HIGH，0.4–0.6为MEDIUM，低于0.4为LOW。这些仅是预先固定的描述分组，不作为新生产路由。让平单档名次用高于其概率1e−12的档位数加一，边界并列同名次；三类别排序并列按W、D、L，与既有诊断一致。

```{r}
knitr::kable(f |> filter(eligible) |> count(shape,line_locality,draw_group),caption="主队列分布形态及让平位置支持数")
knitr::kable(metrics |> filter(cohort=="ELIGIBLE_322",dimension=="shape") |>
 select(stratum,model,n,hits1,hits2,saved_top2,lost_top2,brier,logloss),digits=5)
knitr::kable(metrics |> filter(cohort=="ELIGIBLE_322",dimension=="line_locality") |>
 select(stratum,model,n,hits1,hits2,saved_top2,lost_top2,brier,logloss),digits=5)
```

```{r}
#| fig-width: 10
#| fig-height: 4
f |> filter(eligible) |>
 ggplot(aes(interval80_positions,local_mass,colour=draw_group)) +
 geom_point(alpha=.45,position=position_jitter(width=.06,height=0,seed=171)) +
 scale_y_continuous(labels=scales::percent) +
 labs(x="覆盖80%质量的最短连续区间：整数档数",y="让平±1球合计概率",colour="让平位置") + theme_minimal()
```

## 核心问题：单档前二、类别第三

这里只能解释预先固定的敏感性方案是否改变了保护；样本少时不从一两场净增推导通用规则。两侧完整质量、核心/外围贡献CSV可逐场复核；相同精确胜差的不同比分条件比例保持不变。

```{r}
knitr::kable(metrics |> filter(cohort=="ELIGIBLE_322",dimension=="draw_group") |>
 select(stratum,model,n,hits1,hits2,saved_top2,lost_top2,brier,logloss),digits=5)
knitr::kable(cases |> filter(eligible,model %in% c("FM171","SOURCE_FULL","CORE80_C03","CORE90_C01")) |>
 select(fixture_id,home,away,handicap,model,actual_outcome,actual_rank,shape,interval80_positions,
 local_mass,draw_probability,raw_w,raw_l,top2,saved_top2,lost_top2),digits=4,caption="全部目标冲突场，含未改善/误伤")
```

## 结论及局限

本轮不登记赢家、不更新FM版本。各方案全部报告，分组阈值不根据结果调优。分散分布中的单档前二不必然值得保护；整体集中也不等于质量集中在让平附近。应检查精确胜差概率与两侧累计质量是否真实失衡，再决定后续假设。若要形成实际决策规则，必须冻结候选后，用标签在截止前可用的新期历史通过共享学习上下文确定/验证阈值，再作未见期验证。此次三期只支持探索。

rho为专家固定值、原置信路由未重审、23场原生不足、历史可用时间代理、部分已知结果、细分小样本、同一三期多次讨论等，均限制因果与推广解释。没有票单与收益重放，不报告ROI。

