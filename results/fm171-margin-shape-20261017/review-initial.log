  "shape_policy": {
    "interval_mass": 0.8,
    "narrow_max_integer_positions": 3,
    "medium_max_integer_positions": 5,
    "local_radius": 1,
    "local_mass_high": 0.6,
    "local_mass_low": 0.4
  },
  "selection_policy": "None; all fixed candidates reported. No outcome-based threshold fitting or model promotion.",
  "primary_cohort": "Successful native same-competition replacements plus frozen market routes; exclude 23 unsupported native rows",
  "secondary_cohort": "All 345 settled rows, with unsupported-parent provenance explicit",
  "availability": "Inherited historical proxies, diagnostic only",
  "parameters_selected_from_target_labels": false
}
