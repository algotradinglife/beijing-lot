    14	quotes<-bind_rows(q$quotes) |> mutate(quote_at=lubridate::ymd_hms(quote_at,tz='UTC'),scheduled_kickoff=lubridate::ymd_hms(scheduled_kickoff,tz='UTC'))
    15	stopifnot(all(quotes$sp_raw>0),!anyNA(quotes))
    16	bound<-quotes |> left_join(fixtures |> select(fixture_id,native_id=provider_id,target_handicap=handicap,target_kickoff=kickoff_at),by='fixture_id',relationship='many-to-one') |>
    17	 mutate(identity_matches=provider_id==native_id & handicap==target_handicap & scheduled_kickoff==target_kickoff)
    18	write_csv(bound |> filter(!identity_matches|is.na(identity_matches)),file.path(out,'sp-identity-rejections.csv'))
    19	quotes<-bound |> filter(identity_matches) |> select(fixture_id,outcome,quote_at,sp_raw,raw_sha256,receipt_sha256) |> distinct()
    20	bindings<-list(input=digest::digest(file=file.path(out,'sp-observed-inputs.json'),algo='sha256'),fixtures=digest::digest(file=file.path(out,'fixtures.csv'),algo='sha256'),
    21	 client=digest::digest(file='r/fm171_26103_sp_freeze.R',algo='sha256'))
    22	probabilities<-audit<-receipts<-list()
    23	for(id in fixtures$fixture_id) {
    24	 f<-fixtures |> filter(fixture_id==id);h<-quotes |> filter(fixture_id==id)
