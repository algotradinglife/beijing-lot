FILE src/fm171_26103_metadata.py
     1	"""Offline domain client. No fitting, chronology admission or network requests.
     2	
     3	Reads R-exported, hash-verified NAS fundamentals; metadata from the authoritative
     4	raw cache must match the published provenance hashes. Produces competition/venue
     5	keys for R to join to factual history. Missing/ambiguous metadata stays missing.
     6	"""
     7	import sys
     8	import json
     9	import hashlib
    10	from pathlib import Path
    11	from beidan_backend.unified_sources import SourceClient
    12	from beidan_backend.opponent_history import parse_opponent_history
    13	from beidan_backend.fundamentals import analysis_record
    14	
    15	root=Path(sys.argv[1]).resolve()
    16	out=root/'results/fm171-26103-draw-20261017'
    17	x=json.loads((out/'inputs.json').read_text())
    18	client=SourceClient()
    19	packets=[]
    20	for f in x['fixtures']:
    21	    id=f['fixture_id']
    22	    # All accepted factual history in this pinned issue is selected_source=titan.
    23	    # Do not reparse a second source whose rows are never used as fitting facts.
    24	    assert {h['selected_source'] for h in x['history']}=={'titan'}
    25	    for source in ('titan',):
    26	        refs=[p for p in x['provenance'] if p['fixture_id']==id and p['source']==source]
    27	        analysis=[p for p in refs if '/analysis/' in p['url']]
    28	        if len(analysis)!=1:
    29	            packets.append(dict(fixture_id=id,source=source,state='MISSING_ANALYSIS_PROVENANCE'))
    30	            continue
    31	        receipts=[]
    32	        try:
    33	            ref=analysis[0]
    34	            cap=client.request(source,ref['url'],max_age=0,cache_only=True)
    35	            assert cap['receipt']['sha256']==ref['sha256'], 'Published analysis hash changed'
    36	            receipts.append(cap['receipt'])
    37	            aux=None
    38	            aux_refs=[p for p in refs if '/analysisJs/' in p['url']]
    39	            if aux_refs:
    40	                assert len(aux_refs)==1
    41	                a=client.request(source,aux_refs[0]['url'],max_age=0,cache_only=True)
    42	                assert a['receipt']['sha256']==aux_refs[0]['sha256'], 'Published auxiliary hash changed'
    43	                aux=a['data'];receipts.append(a['receipt'])
    44	            # Identity is parsed from each bound source, not guessed from names or clocks.
    45	            head=analysis_record(cap['data'],source=source,provider_id=f['provider_id'],auxiliary_raw=aux,identity_only=True)
    46	            expected={k:head[k] for k in ['provider_id','home','away','home_id','away_id','kickoff_utc']}
    47	            assert expected['home_id']==f['home_id'] and expected['away_id']==f['away_id'], 'Published oriented teams differ'
    48	            parsed=parse_opponent_history(cap['data'],source=source,provider_id=f['provider_id'],expected_identity=expected,auxiliary_raw=aux)
    49	            packets.append(dict(fixture_id=id,source=source,state='PARSED',result=parsed,receipts=receipts))
    50	        except (ValueError,AssertionError,KeyError) as error:
    51	            packets.append(dict(fixture_id=id,source=source,state='REJECTED',error=str(error),receipts=receipts))
    52	    if len(packets)%50==0:print('metadata',len(packets),flush=True)
    53	body=dict(packets=packets,input_sha256=hashlib.sha256((out/'inputs.json').read_bytes()).hexdigest(),client_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),network_attempts=sum(r['network_attempts'] for p in packets for r in p.get('receipts',[])))
    54	assert body['network_attempts']==0
    55	path=out/'metadata.json'
    56	text=json.dumps(body,ensure_ascii=False,sort_keys=True,separators=(',',':'))
    57	# Receipt processed_at changes on cache replay; the raw identities remain bound.
    58	if 'replay' in sys.argv:
    59	    old=json.loads(path.read_text())
    60	    for b in (old,body):
    61	        for p in b['packets']:
    62	            for r in p.get('receipts',[]):r.pop('processed_at',None)
    63	    assert old==body
    64	    (out/'metadata-replay.json').write_text(json.dumps({'status':'IDENTICAL_METADATA_REPLAY','packets':len(packets)}))
    65	else:
    66	    assert not path.exists(), 'Refuse overwriting frozen metadata'
    67	    path.write_text(text)
    68	print('complete',len(packets),body['network_attempts'])

FILE src/fm171_26103_sp_intake.py
     1	"""Offline replay of existing observed prematch-SP receipts; no as-of selection.
     2	
     3	Only existing authoritative prematch parser interprets original saved bytes.
     4	No settlement SP, network fetching or historical learning occurs in this client.
     5	"""
     6	import sys
     7	import json
     8	import hashlib
     9	from pathlib import Path
    10	from beidan_backend.prematch_sp import parse_prematch_sp
    11	
    12	root=Path(sys.argv[1]).resolve();out=root/'results/fm171-26103-draw-20261017'
    13	rows=[];receipts=[];diagnostics=[]
    14	for path in sorted((root/'results').rglob('26103.source.json')):
    15	    if '/raw-sp/26103/' not in str(path):continue
    16	    r=json.loads(path.read_text())
    17	    if r.get('market')!='beidan_handicap_sp_reference':continue
    18	    assert r['issue_id']=='26103' and r['quote_time_basis']=='observed_availability'
    19	    raw=root/r['raw_paths']['nowscore_beidan_sp_raw']
    20	    sha=hashlib.sha256(raw.read_bytes()).hexdigest()
    21	    assert sha==r['raw_sha256']['nowscore_beidan_sp']
    22	    q,d=parse_prematch_sp(raw.read_bytes(),r['schedule'],r['observed_at'],research_only=r['research_only'])
    23	    identities={s['fixture_key']:s for s in r['schedule']}
    24	    for a in q:
    25	        s=identities[a['fixture_id']]
    26	        rows.append({**a,'provider_id':s['provider_id_nowscore'],'handicap':s['handicap'],
    27	                     'scheduled_kickoff':s['kickoff_at'],'receipt_path':str(path.relative_to(root)),
    28	                     'receipt_sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'raw_sha256':sha})
    29	    diagnostics.extend(d)
    30	    receipts.append(dict(path=str(path.relative_to(root)),raw_path=str(raw.relative_to(root)),raw_sha256=sha,receipt_sha256=hashlib.sha256(path.read_bytes()).hexdigest(),quotes=len(q)))
    31	body=dict(quotes=rows,receipts=receipts,diagnostics=diagnostics,network_attempts=0,
    32	          client_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
    33	          parser_sha256=hashlib.sha256((root/'packages/beidan/inst/python/beidan_backend/prematch_sp.py').read_bytes()).hexdigest())
    34	(out/'sp-observed-inputs.json').write_text(json.dumps(body,ensure_ascii=False,sort_keys=True,separators=(',',':')))
    35	print('receipts',len(receipts),'quote rows',len(rows),'fixtures',len({r['fixture_id'] for r in rows}))

