    20	pm<-jsonlite::fromJSON(file.path(prior_dir,'manifest.json'));pr<-jsonlite::fromJSON(file.path(prior_dir,'replay.json'))
    21	stopifnot(pr$status=='FULL_IDENTICAL_REPLAY',pr$sha256==pm$sha256,digest::digest(file=file.path(prior_dir,'forecasts.rds'),algo='sha256')==pm$sha256)
