     1	# Rscript r/fm171_26103_calibrate.R ROOT [replay]
     2	# Fixed prior-issue domain calibration. All chronology/weights/receipts are shared.
     3	args<-commandArgs(TRUE);root<-normalizePath(args[1],mustWork=TRUE);setwd(root);replay<-length(args)>1L&&args[2]=='replay'
