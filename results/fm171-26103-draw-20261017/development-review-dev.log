    51	  sources<-c(bindings,list(history_frame=reticulate::py_to_r(core$stable_frame_hash(frame)),nominated=beidan:::.score_margin_hash(study$prior_issues),delay=beidan:::.score_margin_hash(delay)))
    52	  ctx<-shared$prepare_learning_context(frame,cutoff,source_hashes=sources,repository_root=pl$Path(root),
    53	   implementation_modules=list('beidan_backend.temporal_learning.issue_partitions','beidan_backend.temporal_learning.diagnostic_labels'),implementation_distributions=list('numpy','pandas'),
    54	   availability=shared$AvailabilityFilter(shared$AvailabilityPolicy$historical_proxy('FM171_DECISION_PLUS_DELAY_NOT_OBSERVED'),data_available_column='data_available_ts'),
    55	   intended_use='HISTORICAL_DIAGNOSTIC',partition_policy=shared$PartitionPolicy('FIXED_PRIOR_FIT',0L,0L,1L),
    56	   weighting_policy=shared$WeightingPolicy$expanding_equal(minimum_ess=policy$minimum_global_ess))
