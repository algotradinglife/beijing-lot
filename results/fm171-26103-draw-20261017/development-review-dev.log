    26	 h<-h |> mutate(row_key=paste(fixture_id,outcome,quote_at,raw_sha256,sep=':'),issue_code='SP_CAPTURE',issue_year=2026L,
    27	  label_available_ts=format(quote_at,'%Y-%m-%dT%H:%M:%OS6Z',tz='UTC'),data_available_ts=label_available_ts)
