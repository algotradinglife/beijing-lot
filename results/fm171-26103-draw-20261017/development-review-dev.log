    35	   availability=shared$AvailabilityFilter(shared$AvailabilityPolicy$observed('SAVED_PREMATCH_REFERENCE_SP_CAPTURE'),data_available_column='data_available_ts'),
    36	   intended_use='HISTORICAL_DIAGNOSTIC',partition_policy=shared$PartitionPolicy('FIXED_PRIOR_FIT',0L,0L,1L),weighting_policy=shared$WeightingPolicy$expanding_equal(minimum_ess=1)),error=function(e)e)
