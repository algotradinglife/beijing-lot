    60	}
    61	print(x$audit |> group_by(mode) |> summarise(fixtures=n(),uniform=sum(uniform),min_lead=min(lead_hours),max_lead=max(lead_hours),.groups='drop'))

FILE r/fm171_26103_evaluate.R
     1	# Rscript r/fm171_26103_evaluate.R ROOT
     2	# Descriptive scoring only. Target labels never return to the freeze clients.
     3	root<-normalizePath(commandArgs(TRUE)[1],mustWork=TRUE);setwd(root)
     4	suppressPackageStartupMessages(library(tidyverse));library(beidan,lib.loc=file.path(root,'r_lib'))
