    60	   min(sum(admitted$draw_target==1),sum(admitted$draw_target==0))>=policy$minimum_global_class_count)
    61	  # Same fixed domain moment-shrinkage formula as the previously frozen GLOBAL candidate; no tuning.
    62	  n<-sum(weights);mu<-weighted.mean(admitted$baseline_draw,weights);observed_rate<-weighted.mean(admitted$draw_target,weights)
    63	  shrunk<-(n*observed_rate+policy$pseudocount_matches*mu)/(n+policy$pseudocount_matches)
    64	  delta<-qlogis(shrunk)-qlogis(mu)
    65	  params<-list(model='GLOBAL',delay_hours=delay,n=n,mu=mu,observed=observed_rate,shrunk=shrunk,delta=delta,pseudocount_matches=policy$pseudocount_matches)
    66	  receipt<-reticulate::py_to_r(models$bind_model_receipt(ctx,cutoff,model_identity='FM171_DRAW_HISTORY_GLOBAL',model_parameters=params))
    67	  receipt$R_bindings<-bindings;receipt$parameters<-params
    68	  ledger<-bind_rows(jsonlite::fromJSON(reticulate::py_to_r(ctx$weight_ledger$to_json(orient='records',date_format='iso',double_precision=15L)),simplifyVector=FALSE));ledger$fixture_id<-admitted$fixture_id
    69	  p<-original$probability[original$outcome=='D'];q<-plogis(qlogis(p)+delta)
    70	  target<-original |> mutate(probability=if_else(outcome=='D',q,(1-q)*probability/(1-p)))
    71	  base<-list(grid=e$final$grid |> select(home_goals,away_goals,probability),cutoff=e$cutoff,model_id='FM171_PLUS_GLOBAL_HISTORY',source_hashes=bindings,
    72	   max_source_available_utc=max(e$base$max_source_available_utc,lubridate::ymd_hms(receipt$maximum_source_time,tz='UTC')),intended_use='HISTORICAL_DIAGNOSTIC')
    73	  dd<--as.integer(f$handicap);eid<-'prior-draw-calibration'
    74	  judgement<-list(model_id=name,rationale='Frozen prior-only historical let-draw log-odds residual; preserve both complete side proportions',
    75	   bins=tibble(bin_id=c('lower','draw','upper'),min_margin=c(-Inf,dd,dd+1),max_margin=c(dd-1,dd,Inf),
    76	    target_mass=target$probability[match(c('L','D','W'),target$outcome)],evidence_id=eid,reason='Fixed prior-only empirical-rate calibration'))
    77	  time<-format(base$max_source_available_utc,'%Y-%m-%dT%H:%M:%SZ',tz='UTC')
    78	  rows<-list(list(evidence_id=eid,fixture_id=id,source_hash=beidan:::.score_margin_hash(receipt),row_key=eid,issue_code='PRIOR_CALIBRATION_EVIDENCE',issue_year=2026L,label_available_ts=time,data_available_ts=time))
    79	  binding<-c(bindings,list(base_artifact=beidan:::.score_margin_hash(base),margin_judgement=beidan:::.score_margin_hash(judgement),fitted_model=beidan:::.score_margin_hash(receipt)))
    80	  score_ctx<-adjustment$build_adjustment_evidence_context(rows,as.list(e$fixture),cutoff,binding,shared$AvailabilityPolicy$historical_proxy('FM171_EMPIRICAL_DRAW_DIAGNOSTIC_ONLY'),'HISTORICAL_DIAGNOSTIC',root)
    81	  final<-adjust_score_margin_distribution(base,judgement,score_ctx,e$fixture,e$cutoff,root)
    82	  projected<-project_score_outcomes(final,as.integer(f$handicap),root) |> select(outcome,probability)
