FILE r/fm171_26103_sp_freeze.R
     1	# Rscript r/fm171_26103_sp_freeze.R ROOT [replay]
     2	# Shared explicit admission of observed prematch reference SP. Never settlement SP.
     3	args<-commandArgs(TRUE);root<-normalizePath(args[1],mustWork=TRUE);setwd(root);replay<-length(args)>1L&&args[2]=='replay'
     4	suppressPackageStartupMessages(library(tidyverse));library(beidan,lib.loc=file.path(root,'r_lib'))
