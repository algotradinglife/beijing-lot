    27	history<-prior$audit |> filter(model=='GLOBAL_D48') |> select(fixture_id,issue_code=issue_id,decision_ts=cutoff_utc) |>
    28	 inner_join(prior$probabilities |> filter(model=='FM171',outcome=='D') |> select(fixture_id,baseline_draw=probability),by='fixture_id',relationship='one-to-one') |>
    29	 inner_join(labels |> select(fixture_id,actual_outcome),by='fixture_id',relationship='one-to-one') |>
    30	 mutate(draw_target=as.double(actual_outcome=='D'),data_available_ts=decision_ts,issue_year=2026L) |>
    31	 select(-actual_outcome)
    32	stopifnot(nrow(history)==322L,!anyDuplicated(history$fixture_id),all(history$issue_code%in%study$prior_issues),!study$target_issue%in%history$issue_code,!anyNA(history))
    33	bindings<-list(native=nm$sha256,prior_forecasts=pm$sha256,prior_labels=digest::digest(file=label_path,algo='sha256'),
    34	 client=digest::digest(file='r/fm171_26103_calibrate.R',algo='sha256'),policy=digest::digest(file='config/fm171_draw_history_study.json',algo='sha256'),
    35	 study=digest::digest(file='config/fm171_26103_draw_study.json',algo='sha256'),prior_client=digest::digest(file='r/fm171_draw_history_freeze.R',algo='sha256'),
    36	 direction_implementation=beidan:::.score_margin_code(root))
    37	horizon<-shared$Cutoff$decision_epoch('DIAGNOSTIC_CLOCK_HORIZON',policy$clock_horizon)
