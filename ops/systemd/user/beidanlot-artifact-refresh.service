[Unit]
Description=Beijing-Lot decision artifact refresh loop
Wants=network-online.target
After=network-online.target
PartOf=beidanlot-decision-dashboard.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/soccer/beijing-lot
Environment=PYTHONPATH=%h/workspace/soccer/beijing-lot:%h/workspace/soccer/beijing-lot/src
ExecStart=%h/workspace/soccer/beijing-lot/.venv/bin/python scripts/live_artifact_refresh_loop.py --db data/derived/500_bjdc/500_bjdc.sqlite --issue current --interval 300 --timeout 300 --max-refresh-age-minutes 90
Restart=always
RestartSec=10

