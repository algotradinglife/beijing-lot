[Unit]
Description=Beijing-Lot no-agent historical 500 to Nowscore ID backfill
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/drwho1985/workspace/algotradinglife/beijing-lot
Environment=PYTHONPATH=/home/drwho1985/workspace/algotradinglife/beijing-lot
ExecStart=/home/drwho1985/workspace/algotradinglife/beijing-lot/.venv/bin/python /home/drwho1985/workspace/algotradinglife/beijing-lot/scripts/run_next_historical_id_mapping.py --data-root /run/media/drwho1985/Sandisk/data/beijing-lot/markets/raw/legacy-titan-clean --risk-acknowledgment /run/media/drwho1985/Sandisk/data/beijing-lot/markets/raw/legacy-titan-clean/titan-risk-ack.json --workers 4
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity

[Install]
WantedBy=default.target
