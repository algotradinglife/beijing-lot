[Unit]
Description=Beijing-Lot immutable correct-score bookmaker price capture loop
Wants=network-online.target
After=network-online.target
PartOf=beidanlot-decision-dashboard.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/soccer/beijing-lot
Environment=PYTHONPATH=%h/workspace/soccer/beijing-lot:%h/workspace/soccer/beijing-lot/src
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/workspace/soccer/beijing-lot/.venv/bin/python scripts/live_correct_score_price_refresh_loop.py --db data/derived/500_bjdc/500_bjdc.sqlite --issue current --interval 60 --observation-horizon-minutes 1440 --observation-bucket-minutes 30 --prefreeze-minutes 10 --freeze-grace-minutes 20 --retry-backoff-minutes 60 --page-attempts 3 --page-retry-delay 2
Restart=always
RestartSec=10
