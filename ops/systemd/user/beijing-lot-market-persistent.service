[Unit]
Description=Historical market collection on persistent Sandisk storage

[Service]
Type=simple
WorkingDirectory=/home/drwho1985/.codex/worktrees/0aac/beijing-lot
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TMPDIR=/dev/shm
ExecStartPre=/usr/bin/mountpoint -q /run/media/drwho1985/Sandisk
ExecStartPre=/home/drwho1985/workspace/algotradinglife/beijing-lot/.venv/bin/python /home/drwho1985/.codex/worktrees/0aac/beijing-lot/scripts/check_persistent_data_layout.py --contract /home/drwho1985/.codex/worktrees/0aac/beijing-lot/config/persistent_data_layout.json
ExecStartPre=/usr/bin/test -f /run/media/drwho1985/Sandisk/data/beijing-lot/markets/manifests/market-forward-persistent-v1/ready.json
ExecStart=/home/drwho1985/workspace/algotradinglife/beijing-lot/.venv/bin/python -u scripts/collect_market_history.py --plan /run/media/drwho1985/Sandisk/data/beijing-lot/markets/manifests/market-forward-persistent-v1/plan.json --index /run/media/drwho1985/Sandisk/data/beijing-lot/markets/manifests/market-forward-persistent-v1/existing-captures.json --output /run/media/drwho1985/Sandisk/data/beijing-lot/markets/raw/market-forward-persistent-v1 --ledger /run/media/drwho1985/Sandisk/data/beijing-lot/runtime/state/request_ledger.sqlite --budget-id market-observed-history-one-second-v2 --request-budget 994386 --min-free-bytes 21474836480 --min-interval-seconds 1
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
