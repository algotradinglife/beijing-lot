def validate_read(max_age, cache_only):
    """Reject invalid freshness/options before any per-source recovery or I/O."""
    if isinstance(max_age, bool) or not isinstance(max_age, (int, float)) or not math.isfinite(max_age) or max_age < 0:
        raise ValueError("finite nonnegative max_age seconds required")
    if type(cache_only) is not bool:
        raise ValueError("cache_only must be boolean")


class ReplayConfigurationError(ValueError):
    """Malformed caller replay pins; never downgrade to a source gap."""


class ImplementationIntegrityError(RuntimeError):
    """Source implementations changed within one factual collection."""


class IdentityResolutionError(ValueError):
    """Unresolved fixture identity retaining captured evidence and diagnostics."""
    def __init__(self, receipts, rejections):
        super().__init__('no analysis identity matches the issue/slot roster')
        self.receipts = receipts
        self.rejections = rejections
        self.failed_network_attempts = sum(r["network_attempts"] for r in rejections)


def canonical(value):
    """Stable JSON observation representation, preserving null and empty values."""
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)


def validate_identity(identity):
    """Require explicit native ID, names, team IDs and timezone-aware kickoff."""
    if not isinstance(identity, dict) or set(identity) != set(IDENTITY):
        raise ValueError("explicit fixture identity fields required")
    for field in IDENTITY[:-1]:
        value = identity[field]
        if not isinstance(value, str) or not value or value.strip() != value:
            raise ValueError("invalid fixture identity: " + field)
    for field in ("provider_id", "home_id", "away_id"):
        if not re.fullmatch(r"[1-9]\d*", identity[field]):
            raise ValueError("invalid native ID: " + field)
    if identity["home_id"] == identity["away_id"]:
        raise ValueError("same home and away ID")
    try:
        at = datetime.fromisoformat(identity["kickoff_utc"])
    except (ValueError, TypeError) as exc:
        raise ValueError("invalid fixture kickoff") from exc
    if at.utcoffset() is None:
        raise ValueError("fixture kickoff requires timezone")
    return identity


def identity_matches(record, identity):
    """Exact native fixture and oriented team IDs; clocks and aliases are evidence."""
    return all(record[k] == identity[k] for k in ("provider_id", "home_id", "away_id"))


