"""Raw-response SQLite store for explicit, deduplicated source extraction.

SQLite transactions publish responses; filelock serializes cache checks and
network requests across processes using this SAME store. No import-time I/O.
Raw captures are immutable, including parser failures. Only validated captures
can satisfy ordinary reads. Parser callbacks run again on every cache read.
"""
from __future__ import annotations

from contextlib import closing
from datetime import datetime, timezone
import hashlib
import json
import math
from pathlib import Path
import sqlite3
import time
from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit

from filelock import FileLock

from .transport import FetchError, fetch_issue_page


class CapturePinError(ValueError):
    """Requested immutable capture does not belong to this source/URL."""


class CaptureIntegrityError(ValueError):
    """Persisted original bytes or chronology failed integrity validation."""


class CacheMissError(ValueError):
    """No raw capture exists for an explicitly offline request."""


def canonical_url(url: str) -> str:
    """Canonicalize query ordering without collapsing duplicate query values."""
    parts = urlsplit(url)
    if parts.scheme != "https" or not parts.hostname or parts.username or parts.password or parts.fragment:
        raise ValueError("source URL must be HTTPS without credentials or fragment")
    return urlunsplit((parts.scheme, parts.netloc.lower(), parts.path,
                      urlencode(sorted(parse_qsl(parts.query, keep_blank_values=True))), ""))


class ExtractionCache:
    """Explicit SQLite path; never read credentials or choose data roots implicitly.

    Raw bodies are BLOBs; no request headers or private keys are persisted.
    Account isolation uses a non-secret namespace fingerprint supplied by callers.
    This store does not read or change existing collectors' ledgers or budgets.
    """

    def __init__(self, path: str):
        if not isinstance(path, str) or not path.strip():
            raise ValueError("cache path required")
        self.path = Path(path).resolve()
        if not self.path.parent.is_dir():
            raise ValueError("cache parent must already exist")
        self.lock = FileLock(str(self.path) + ".lock", timeout=120)
        with closing(sqlite3.connect(self.path)) as con, con:
            con.execute("""CREATE TABLE IF NOT EXISTS captures (
                capture_id INTEGER PRIMARY KEY, request_key TEXT NOT NULL,
                source TEXT NOT NULL, url TEXT NOT NULL, observed_at TEXT NOT NULL,
                body BLOB NOT NULL, sha256 TEXT NOT NULL, content_type TEXT,
                valid INTEGER NOT NULL DEFAULT 0, error TEXT)""")
            con.execute("CREATE INDEX IF NOT EXISTS capture_request ON captures(request_key, capture_id)")
            con.execute("""CREATE TABLE IF NOT EXISTS rate (
                source TEXT PRIMARY KEY, last_attempt REAL NOT NULL,
                interval_sec REAL NOT NULL)""")

    def extract(self, source, url, parser, *, max_age, min_interval,
                namespace="public", timeout=25, retries=2, cache_only=False,
                capture_id=None, headers_factory=None, opener=None, offline=None, reuse_raw=False):
        """Return parsed data and receipt, fetching at most once per raw-response TTL.

        max_age is finite seconds >=0; zero forces a new observation unless
        reuse_raw/cache_only is explicit. reuse_raw fetches only absent raw URLs. cache_only
        accepts old captures and NEVER fetches; capture_id pins immutable replay,
        including explicit revalidation after a prior parser-contract failure.
        Always select the latest raw capture, never fall back to older successes.
        offline={body:bytes, observed_at:aware ISO, content_type:str|None} imports
        evidence without network. Its original observation time is retained.
        Failed parsers leave invalid raw captures; exceptions propagate. HTTP
        transient retries are bounded and EVERY attempt is source-rate-limited.
        Cached readers bypass the fetch mutex; concurrent misses recheck under it.
        Different parsing/context callbacks reuse bytes, never derived results.
        """
        url = canonical_url(url)
        if source not in {"novaapi", "titan", "nowscore"}:
            raise ValueError("unknown source")
        floor = 2.1 if source == "novaapi" else 1.0
        for label, value, minimum in (("max_age", max_age, 0), ("min_interval", min_interval, floor), ("timeout", timeout, .001)):
            if type(value) not in (int, float) or not math.isfinite(value) or value < minimum:
                raise ValueError(f"invalid {label}; minimum {minimum}")
        if type(retries) is not int or not 0 <= retries <= 3:
            raise ValueError("retries must be integer 0..3")
        if type(cache_only) is not bool or type(reuse_raw) is not bool or not isinstance(namespace, str) or not namespace:
            raise ValueError("invalid cache_only/namespace")
        if capture_id is not None and (type(capture_id) is not int or capture_id <= 0 or not cache_only):
            raise ValueError("capture_id requires cache_only and a positive integer")
        key = hashlib.sha256(json.dumps([source, url, namespace], separators=(",", ":")).encode()).hexdigest()
        at = None
        if offline is not None:
            if cache_only:
                raise ValueError("offline import cannot be combined with cache_only")
            if not isinstance(offline, dict) or not isinstance(offline.get("body"), bytes):
                raise ValueError("offline body must be bytes")
            at = datetime.fromisoformat(offline["observed_at"].replace("Z", "+00:00"))
            if at.tzinfo is None or at.timestamp() > time.time():
                raise ValueError("offline observation must be timezone-aware and not future")
        # SQLite owns short transactions; cached readers must not wait for HTTP.
        with closing(sqlite3.connect(self.path)) as con:
            con.row_factory = sqlite3.Row
            cached = self._cached(con, key, parser, max_age=max_age, cache_only=cache_only, reuse_raw=reuse_raw, offline=offline, capture_id=capture_id, at=at)
            if cached is not None:
                return cached
        # Recheck under the fetch mutex: simultaneous misses still download once.
        with self.lock, closing(sqlite3.connect(self.path)) as con:
            con.row_factory = sqlite3.Row
            cached = self._cached(con, key, parser, max_age=max_age, cache_only=cache_only, reuse_raw=reuse_raw, offline=offline, capture_id=capture_id, at=at)
            if cached is not None:
                return cached
            attempts = 0
            if offline is None:
                for attempt in range(retries + 1):
                    previous = con.execute("SELECT last_attempt,interval_sec FROM rate WHERE source=?", (source,)).fetchone()
                    interval = max(min_interval, previous["interval_sec"] if previous else 0)
                    if previous:
                        time.sleep(max(0, previous["last_attempt"] + interval - time.time()))
                    # Commit before the request: crashes/failures still consume spacing.
                    with con:
                        con.execute("INSERT INTO rate VALUES(?,?,?) ON CONFLICT(source) DO UPDATE SET last_attempt=excluded.last_attempt, interval_sec=excluded.interval_sec", (source, time.time(), interval))
                    attempts += 1
                    try:
                        response = fetch_issue_page(url, timeout=timeout, retries=0,
                            headers=headers_factory() if headers_factory else None, opener=opener)
                        break
                    except FetchError as error:
                        if attempt == retries or (error.status is not None and error.status not in {408, 429, 500, 502, 503, 504}):
                            error.network_attempts = attempts
                            raise
                body, observed_at, content_type = response.body, response.observed_at, response.content_type
            else:
                body, observed_at, content_type = offline["body"], at.astimezone(timezone.utc).isoformat(), offline.get("content_type")
            digest = hashlib.sha256(body).hexdigest()
            # Raw publication precedes parsing. Parser failure is evidence, not an empty success.
            with con:
                cursor = con.execute("INSERT INTO captures(request_key,source,url,observed_at,body,sha256,content_type) VALUES(?,?,?,?,?,?,?)", (key, source, url, observed_at, body, digest, content_type))
            row = con.execute("SELECT * FROM captures WHERE capture_id=?", (cursor.lastrowid,)).fetchone()
            return self._parse(con, row, parser, False, attempts)

    def _cached(self, con, key, parser, *, max_age, cache_only, reuse_raw, offline, capture_id, at):
        """Read/revalidate committed immutable bytes without a network mutex.

        Return None only when fetching/importing is necessary. Missing pinned
        captures, raw corruption and invalid chronology fail closed.
        """
        if offline is not None:
            row = con.execute("SELECT * FROM captures WHERE request_key=? AND sha256=? AND observed_at=? ORDER BY capture_id DESC LIMIT 1",
                (key, hashlib.sha256(offline["body"]).hexdigest(), at.astimezone(timezone.utc).isoformat())).fetchone()
        elif capture_id is None:
            row = con.execute("SELECT * FROM captures WHERE request_key=? ORDER BY julianday(observed_at) DESC, capture_id DESC LIMIT 1", (key,)).fetchone()
        else:
            row = con.execute("SELECT * FROM captures WHERE request_key=? AND capture_id=?", (key, capture_id)).fetchone()
        if row is not None:
            observed = datetime.fromisoformat(row["observed_at"])
            age = time.time() - observed.timestamp()
            if age < 0:
                raise CaptureIntegrityError("cached observation is in the future")
            if reuse_raw or cache_only or offline is not None or age < max_age:
                return self._parse(con, row, parser, True, 0)
        if cache_only:
            if capture_id is not None:
                raise CapturePinError("capture pin is missing or does not match request")
            raise CacheMissError("no validated cached capture for request")
        return None

    def _parse(self, con, row, parser, cache_hit, attempts):
        """Integrity check, replay parser, publish validation and provenance."""
        if hashlib.sha256(row["body"]).hexdigest() != row["sha256"]:
            raise CaptureIntegrityError("raw capture hash mismatch")
        receipt = {k: row[k] for k in ("capture_id", "request_key", "source", "url", "observed_at", "sha256", "content_type")}
        receipt.update(cache_hit=cache_hit, network_attempts=attempts, cache_path=str(self.path),
            processed_at=datetime.now(timezone.utc).isoformat())
        try:
            data = parser(row["body"], row["observed_at"], row["content_type"])
        except Exception as error:
            error.extraction_receipt = receipt
            # Do not persist exception text: an upstream error may echo credentials.
            with con:
                con.execute("UPDATE captures SET valid=0,error=? WHERE capture_id=?", ("parser_contract_failure", row["capture_id"]))
            raise
        with con:
            con.execute("UPDATE captures SET valid=1,error=NULL WHERE capture_id=?", (row["capture_id"],))
        return {"data": data, "receipt": receipt}
"""Subscription-free factual resource facade with explicit reconciliation.

Titan primary; Nowscore supplements absent fields only after fixture identity
validation. Empty collections mean observed empty, not absence. Conflicts retain
both observations and quarantine the effective field. No historical admission.
"""
from __future__ import annotations

from datetime import datetime
import hashlib
import json
import math
from pathlib import Path
import re
from urllib.parse import urlsplit

from bs4 import BeautifulSoup

from . import fundamentals, extraction_cache, transport, source_extraction, fundamental_tables
from .extraction_cache import ExtractionCache
from .source_extraction import extract_nowscore_issue, extract_titan_markets
from .settlement import parser as settlement

IDENTITY = ("provider_id", "home", "away", "home_id", "away_id", "kickoff_utc")
SCALARS = ("kickoff_utc", "venue", "weather", "temperature")
SCHEDULE_SCHEMA = dict(fixture_id="character", source="character", resource="character",
    provider_id="character", kickoff_at="timestamp", kickoff_date="date",
    kickoff_hhmm="character", kickoff_js_date="date", sale_end_at="timestamp",
    fixture_status="character", score="character", state="character",
    url="character", observed_at="timestamp", sha256="character")
SOURCE_HOSTS = {"titan": {"zq.titan007.com", "1x2d.titan007.com", "m.titan007.com"},
                "nowscore": {"live.nowscore.com", "cp.nowscore.com", "1x2.nowscore.com"}}
# Authoritative English play names; native Nowscore type IDs are resolved
# internally from this map and are never accepted from callers.
BEIDAN_PLAYS = {"handicap_result": 5, "total_goals": 6, "odd_even": 7,
                "correct_score": 8, "half_full_time": 9}


def validate_read(max_age, cache_only):
    """Reject invalid freshness/options before any per-source recovery or I/O."""
    if isinstance(max_age, bool) or not isinstance(max_age, (int, float)) or not math.isfinite(max_age) or max_age < 0:
        raise ValueError("finite nonnegative max_age seconds required")
    if type(cache_only) is not bool:
        raise ValueError("cache_only must be boolean")


class ReplayConfigurationError(ValueError):
    """Malformed caller replay pins; never downgrade to a source gap."""


class ImplementationIntegrityError(RuntimeError):
    """Source implementations changed within one factual collection."""


class IdentityResolutionError(ValueError):
    """Unresolved fixture identity retaining captured evidence and diagnostics."""
    def __init__(self, receipts, rejections):
        super().__init__('no analysis identity matches the issue/slot roster')
        self.receipts = receipts
        self.rejections = rejections
        self.failed_network_attempts = sum(r["network_attempts"] for r in rejections)


def canonical(value):
    """Stable JSON observation representation, preserving null and empty values."""
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)


def validate_identity(identity):
    """Require explicit native ID, names, team IDs and timezone-aware kickoff."""
    if not isinstance(identity, dict) or set(identity) != set(IDENTITY):
        raise ValueError("explicit fixture identity fields required")
    for field in IDENTITY[:-1]:
        value = identity[field]
        if not isinstance(value, str) or not value or value.strip() != value:
            raise ValueError("invalid fixture identity: " + field)
    for field in ("provider_id", "home_id", "away_id"):
        if not re.fullmatch(r"[1-9]\d*", identity[field]):
            raise ValueError("invalid native ID: " + field)
    if identity["home_id"] == identity["away_id"]:
        raise ValueError("same home and away ID")
    try:
        at = datetime.fromisoformat(identity["kickoff_utc"])
