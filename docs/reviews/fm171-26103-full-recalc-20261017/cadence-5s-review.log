def document_bytes(body, observed_at, content_type):
    """Raw text contract only; resource parsers validate semantic identity later."""
    if not body or len(body) > 10 * 1024 * 1024:
        raise ValueError("empty or oversized source document")
    body.decode("utf-8-sig", errors="strict")
    return body


class SourceClient:
    """Shared explicit cache; construction writes schema, never fetches.

    All resource reads have explicit max_age/cache_only; defaults enforce source
    cadences Titan60s/Nowscore120s. pages inject saved bytes for deterministic
    replay. One URL is fetched once across consumers using the same cache path.
    """
    def __init__(self, cache_path=None):
        if cache_path is None:
            from .catalog.paths import location, root_path
            root_path('hot')
            cache_path = location('hot:source-extraction/raw.sqlite', require_exists=False)
            cache_path.parent.mkdir(parents=True, exist_ok=True)
        self.cache_path = str(Path(cache_path).resolve())
        self.cache = ExtractionCache(self.cache_path)

    def request(self, source, url, *, max_age, cache_only=False, pages=None, opener=None, capture_id=None, reuse_raw=False):
        """Read original bytes and immutable receipt; no Nova credentials."""
        validate_read(max_age, cache_only)
        if source not in SOURCE_HOSTS or urlsplit(url).hostname not in SOURCE_HOSTS[source]:
            raise ValueError("URL host does not match declared source")
        result = self.cache.extract(source, url, document_bytes, max_age=max_age,
            min_interval=60 if source == "titan" else 120, cache_only=cache_only,
            offline=None if cache_only or pages is None else pages[url], opener=opener, capture_id=capture_id, reuse_raw=reuse_raw)
        return result

    def fundamentals(self, issue, slot, *, max_age, cache_only=False, pages=None, opener=None):
        """Resolve a Northsingle issue/slot internally and return typed facts.

        Read the shared issue roster once per URL/TTL. Native fixture/team IDs
        bind analysis identity; kickoff date/clock remain separate evidence; display aliases
        do not override published team IDs. Where a team ID is absent, require
        exact displayed names. Never infer a date from the sales grouping date.
        Missing/duplicate slots and unresolved identity raise before admitting
        facts. Both analysis URLs are read once per call, including refresh=0;
        preloaded raw captures/errors feed the same authoritative reconciler.
        Raw/cache receipts include the issue page and transitive parser hashes.
        """
        from .issue_schedule.contract import validate_issue_id, SOURCE_TZ
        validate_issue_id(issue)
        validate_read(max_age, cache_only)
        if type(slot) is not int or slot <= 0 or slot > 2**31 - 1:
            raise ValueError("slot must be a positive integer")
        roster = self.issue(issue, max_age=max_age, cache_only=cache_only, pages=pages, opener=opener)
        return self._fundamentals_from_roster(issue, slot, roster, max_age=max_age,
            cache_only=cache_only, pages=pages, opener=opener)

    def _fundamentals_from_roster(self, issue, slot, roster, *, max_age, cache_only=False, pages=None, opener=None, reuse_raw=False):
        """Internal identity resolution using a single already validated roster."""
        from .issue_schedule.contract import SOURCE_TZ
        selected = [row for row in roster["data"] if row["slot"] == slot]
        if len(selected) != 1:
            raise ValueError("issue/slot is missing or ambiguous in source roster")
        row = selected[0]
        roster_native_id = row["native_id"]
        if not isinstance(roster_native_id, str) or not re.fullmatch(r"[0-9]+", roster_native_id) or not roster_native_id.strip("0"):
            raise ValueError("roster has no valid native match ID")
        # Numeric provider routes are unpadded; retain the roster's original text.
        provider_id = roster_native_id.lstrip("0")
        preloaded, candidates, rejections = {}, [], []
        for source, host, suffix in (("titan", "zq.titan007.com", "htm"), ("nowscore", "live.nowscore.com", "html")):
            url = f"https://{host}/analysis/{provider_id}cn.{suffix}"
            head = None
            try:
                capture = self.request(source, url, max_age=max_age, cache_only=cache_only, pages=pages, opener=opener, reuse_raw=reuse_raw)
                preloaded[url] = capture
    def extract(self, source, url, parser, *, max_age, min_interval,
                namespace="public", timeout=25, retries=2, cache_only=False,
                capture_id=None, headers_factory=None, opener=None, offline=None, reuse_raw=False):
        """Return parsed data and receipt, fetching at most once per raw-response TTL.

        max_age is finite seconds >=0; zero forces a new observation unless
        reuse_raw/cache_only is explicit. reuse_raw fetches only absent raw URLs. cache_only
        accepts old captures and NEVER fetches; capture_id pins immutable replay,
        including explicit revalidation after a prior parser-contract failure.
        Always select the latest raw capture, never fall back to older successes.
        offline={body:bytes, observed_at:aware ISO, content_type:str|None} imports
        evidence without network. Its original observation time is retained.
        Failed parsers leave invalid raw captures; exceptions propagate. HTTP
        transient retries are bounded and EVERY attempt is source-rate-limited.
        Cached readers bypass the fetch mutex; concurrent misses recheck under it.
        Different parsing/context callbacks reuse bytes, never derived results.
        """
        url = canonical_url(url)
        if source not in {"novaapi", "titan", "nowscore"}:
            raise ValueError("unknown source")
        floor = 2.1 if source == "novaapi" else 1.0
        for label, value, minimum in (("max_age", max_age, 0), ("min_interval", min_interval, floor), ("timeout", timeout, .001)):
            if type(value) not in (int, float) or not math.isfinite(value) or value < minimum:
                raise ValueError(f"invalid {label}; minimum {minimum}")
        if type(retries) is not int or not 0 <= retries <= 3:
            raise ValueError("retries must be integer 0..3")
        if type(cache_only) is not bool or type(reuse_raw) is not bool or not isinstance(namespace, str) or not namespace:
            raise ValueError("invalid cache_only/namespace")
        if capture_id is not None and (type(capture_id) is not int or capture_id <= 0 or not cache_only):
            raise ValueError("capture_id requires cache_only and a positive integer")
        key = hashlib.sha256(json.dumps([source, url, namespace], separators=(",", ":")).encode()).hexdigest()
        at = None
        if offline is not None:
            if cache_only:
                raise ValueError("offline import cannot be combined with cache_only")
            if not isinstance(offline, dict) or not isinstance(offline.get("body"), bytes):
                raise ValueError("offline body must be bytes")
            at = datetime.fromisoformat(offline["observed_at"].replace("Z", "+00:00"))
            if at.tzinfo is None or at.timestamp() > time.time():
                raise ValueError("offline observation must be timezone-aware and not future")
        # SQLite owns short transactions; cached readers must not wait for HTTP.
        with closing(sqlite3.connect(self.path)) as con:
            con.row_factory = sqlite3.Row
            cached = self._cached(con, key, parser, max_age=max_age, cache_only=cache_only, reuse_raw=reuse_raw, offline=offline, capture_id=capture_id, at=at)
            if cached is not None:
                return cached
        # Recheck under the fetch mutex: simultaneous misses still download once.
        with self.lock, closing(sqlite3.connect(self.path)) as con:
            con.row_factory = sqlite3.Row
            cached = self._cached(con, key, parser, max_age=max_age, cache_only=cache_only, reuse_raw=reuse_raw, offline=offline, capture_id=capture_id, at=at)
            if cached is not None:
                return cached
            attempts = 0
            if offline is None:
                for attempt in range(retries + 1):
                    previous = con.execute("SELECT last_attempt,interval_sec FROM rate WHERE source=?", (source,)).fetchone()
                    interval = max(min_interval, previous["interval_sec"] if previous else 0)
                    if previous:
                        time.sleep(max(0, previous["last_attempt"] + interval - time.time()))
                    # Commit before the request: crashes/failures still consume spacing.
                    with con:
                        con.execute("INSERT INTO rate VALUES(?,?,?) ON CONFLICT(source) DO UPDATE SET last_attempt=excluded.last_attempt, interval_sec=excluded.interval_sec", (source, time.time(), interval))
                    attempts += 1
                    try:
                        response = fetch_issue_page(url, timeout=timeout, retries=0,
                            headers=headers_factory() if headers_factory else None, opener=opener)
                        break
                    except FetchError as error:
                        if attempt == retries or (error.status is not None and error.status not in {408, 429, 500, 502, 503, 504}):
                            error.network_attempts = attempts
                            raise
                body, observed_at, content_type = response.body, response.observed_at, response.content_type
            else:
                body, observed_at, content_type = offline["body"], at.astimezone(timezone.utc).isoformat(), offline.get("content_type")
            digest = hashlib.sha256(body).hexdigest()
            # Raw publication precedes parsing. Parser failure is evidence, not an empty success.
            with con:
                cursor = con.execute("INSERT INTO captures(request_key,source,url,observed_at,body,sha256,content_type) VALUES(?,?,?,?,?,?,?)", (key, source, url, observed_at, body, digest, content_type))
            row = con.execute("SELECT * FROM captures WHERE capture_id=?", (cursor.lastrowid,)).fetchone()
            return self._parse(con, row, parser, False, attempts)

    def _cached(self, con, key, parser, *, max_age, cache_only, reuse_raw, offline, capture_id, at):
        """Read/revalidate committed immutable bytes without a network mutex.

        Return None only when fetching/importing is necessary. Missing pinned
        captures, raw corruption and invalid chronology fail closed.
        """
        if offline is not None:
            row = con.execute("SELECT * FROM captures WHERE request_key=? AND sha256=? AND observed_at=? ORDER BY capture_id DESC LIMIT 1",
                (key, hashlib.sha256(offline["body"]).hexdigest(), at.astimezone(timezone.utc).isoformat())).fetchone()
        elif capture_id is None:
            row = con.execute("SELECT * FROM captures WHERE request_key=? ORDER BY julianday(observed_at) DESC, capture_id DESC LIMIT 1", (key,)).fetchone()
        else:
            row = con.execute("SELECT * FROM captures WHERE request_key=? AND capture_id=?", (key, capture_id)).fetchone()
        if row is not None:
            observed = datetime.fromisoformat(row["observed_at"])
            age = time.time() - observed.timestamp()
            if age < 0:
                raise CaptureIntegrityError("cached observation is in the future")
            if reuse_raw or cache_only or offline is not None or age < max_age:
                return self._parse(con, row, parser, True, 0)

