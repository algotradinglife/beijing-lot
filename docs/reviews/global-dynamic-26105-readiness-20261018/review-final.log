                w.writerow(dict(fixture_id=f'26105:{i}',source='titan',provider_id='00'+native,
                    kind=kind,url=f'https://zq.titan007.com/analysis/{native}cn.htm' if kind=='analysis' else f'https://1x2d.titan007.com/{native}.js'))
